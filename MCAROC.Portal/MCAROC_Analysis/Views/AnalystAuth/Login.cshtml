@{
    ViewData["Title"] = "Analyst sign-in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MCA ROC Analysis</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <section class="card shadow-sm" style="width: 22rem;" aria-labelledby="sign-in-heading">
            <div class="card-body p-4">
                <h1 id="sign-in-heading" class="h5 mb-1">Analyst sign-in</h1>
                <p class="text-muted small mb-3">Use your assigned analyst account.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form method="post" action="/analyst/login">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div class="mb-2">
                        <label class="form-label small" for="username">Username</label>
                        <input id="username" type="text" name="username" class="form-control" autocomplete="username" required autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small" for="password">Password</label>
                        <input id="password" type="password" name="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>
            </div>
        </section>
    </main>
</body>
</html>
