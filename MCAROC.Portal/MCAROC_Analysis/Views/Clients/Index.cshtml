@model IReadOnlyList<MCAROC_Analysis.Data.Entities.Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="pi-page-head">
    <div>
        <div class="pi-kicker">Internal</div>
        <h1>Clients</h1>
        <p>The clients requests are made for. Litigation is delivered as a separate report, not inside the dossier.</p>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="pi-panel" style="padding:0;">
    <table class="table mb-0">
        <thead>
        <tr>
            <th>Client</th>
            <th>Code</th>

        </tr>
        </thead>
        <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td>@client.ClientName</td>
                <td>@client.ClientCode</td>

            </tr>
        }
        </tbody>
    </table>
</div>
