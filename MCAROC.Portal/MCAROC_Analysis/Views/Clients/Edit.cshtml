@model ClientEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.ClientName}";
}

<div class="pi-page-head">
    <div>
        <div class="pi-kicker">Internal</div>
        <h1>@Model.ClientName</h1>
        <p>Dossier PDF settings for this client. The on-screen company page is never affected by this setting.</p>
    </div>
</div>

<div class="pi-panel" style="padding:24px;">
    <form asp-action="Edit" asp-route-id="@Model.ClientId" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="ClientId" type="hidden" />
        <input asp-for="ClientName" type="hidden" />
        <input asp-for="ClientCode" type="hidden" />

        <div class="mb-3 form-check">
            <input asp-for="IncludeLitigationInDossier" class="form-check-input" />
            <label asp-for="IncludeLitigationInDossier" class="form-check-label"></label>
            <div class="form-text">
                Turn this off when the client already receives litigation as a separate standalone report.
                When off, the dossier PDF omits the Litigation annexure, its Contents entry, every
                litigation-sourced finding and flag, and the AI executive summary (which can't be safely
                filtered for litigation mentions on its own). The portal's on-screen company page always
                shows full litigation data regardless of this setting.
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" type="submit">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
