@using MCAROC_Analysis.Controllers
@model QuestionRepositoryPage
@{
    ViewData["Title"] = "Question repository";
    string Tab(string key) => Model.Sort == key ? "active" : "";
}

<div class="container py-3" id="question-repository-page" style="max-width:1100px;">
    <h1 class="h4">Question repository</h1>
    <p class="text-muted">What clients ask in the chat, across all companies, grouped by meaning. Company and people names, identifiers, case numbers and amounts are replaced by placeholders before a question is kept, so no client's question appears as they wrote it. A group is named by its most typical question. Questions asked by many clients and usually answered with evidence are also offered as chat suggestions.</p>

    <div class="d-flex flex-wrap gap-3 align-items-baseline mb-3">
        <div><span class="fs-5 fw-bold">@Model.Totals.Questions.ToString("N0")</span> <span class="text-muted">questions</span></div>
        <div><span class="fs-5 fw-bold">@Model.Totals.Groups.ToString("N0")</span> <span class="text-muted">groups</span></div>
        <ul class="nav nav-pills ms-auto small">
            <li class="nav-item"><a class="nav-link @Tab("clients")" href="/Questions">Most clients</a></li>
            <li class="nav-item"><a class="nav-link @Tab("gaps")" href="/Questions?sort=gaps">Least evidence</a></li>
            <li class="nav-item"><a class="nav-link @Tab("recent")" href="/Questions?sort=recent">Most recent</a></li>
        </ul>
    </div>

    @if (Model.Groups.Count == 0)
    {
        <div class="alert alert-secondary">No questions yet. Answered chat questions are added every half hour.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <table class="table mb-0 align-middle">
                <thead class="table-light">
                    <tr><th>Question</th><th class="text-end">Asked</th><th class="text-end">Clients</th><th class="text-end">With evidence</th><th class="text-end">From document index</th><th>Last asked</th></tr>
                </thead>
                <tbody>
                @foreach (var g in Model.Groups)
                {
                    <tr data-group="@g.GroupId">
                        <td>
                            <div>@g.Question</div>
                            @foreach (var e in g.Examples)
                            {
                                <div class="small text-muted">· @e</div>
                            }
                        </td>
                        <td class="text-end">@g.Asked.ToString("N0")</td>
                        <td class="text-end">@g.Clients.ToString("N0")</td>
                        <td class="text-end @(g.EvidenceShare < 0.5 ? "text-danger" : "")">@g.EvidenceShare.ToString("P0")</td>
                        <td class="text-end">@g.FromIndex.ToString("N0")</td>
                        <td class="small" title="First asked @Ist.Format(g.FirstAskedUtc)">@Ist.Format(g.LastAskedUtc)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
