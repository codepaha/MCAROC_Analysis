@model MCAROC_Analysis.Models.AssignmentAutoExclusionsViewModel
@{
    ViewData["Title"] = "Excluded Automatically";
}

<div class="pi-page-head d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="pi-kicker text-muted small fw-semibold text-uppercase">Pre-Login Report System</div>
        <h1 class="h3 fw-bold mb-1">Excluded Automatically</h1>
        <p class="text-muted mb-0">Cases automatically excluded from credit reports under Apply mode. Review automatic exclusions and undo any misattributions.</p>
    </div>
</div>

<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link fw-semibold" asp-controller="Assignments" asp-action="Index">
            <i class="bi bi-folder2-open me-1"></i> All Assignments
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-semibold" asp-controller="Assignments" asp-action="Suggestions">
            <i class="bi bi-question-circle me-1"></i> Suggested Exclusions
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link active fw-semibold" asp-controller="Assignments" asp-action="AutoExclusions">
            <i class="bi bi-magic me-1"></i> Excluded Automatically (@Model.Items.Count)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-semibold" asp-controller="Assignments" asp-action="TrustReport">
            <i class="bi bi-shield-check me-1"></i> Attribution Trust Report
        </a>
    </li>
</ul>

@if (TempData["SuccessMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i> @err
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="AutoExclusions" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="number" name="jobId" value="@(Model.SelectedJobId > 0 ? Model.SelectedJobId : null)" class="form-control" placeholder="Filter by Job ID..." />
            </div>
            <div class="col-md-3">
                <select name="targetKind" class="form-select">
                    <option value="">All Targets (Borrower & Directors)</option>
                    <option value="Borrower" selected="@(Model.SelectedTargetKind == MCAROC_Analysis.Data.Entities.PreLoginTargetKind.Borrower)">Borrower Company / LLP</option>
                    <option value="Director" selected="@(Model.SelectedTargetKind == MCAROC_Analysis.Data.Entities.PreLoginTargetKind.Director)">Director / Partner</option>
                </select>
            </div>
            <div class="col-md-4">
                <select name="reasonKind" class="form-select">
                    <option value="">All Exclusion Reasons</option>
                    @foreach (var r in Model.AvailableReasons)
                    {
                        <option value="@r" selected="@(string.Equals(Model.SelectedReasonKind, r, StringComparison.OrdinalIgnoreCase))">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="AutoExclusions" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 14%;">Assignment & CIN</th>
                        <th style="width: 14%;">Case Reference</th>
                        <th style="width: 16%;">Target Evaluated</th>
                        <th style="width: 16%;">Matched Party</th>
                        <th style="width: 26%;">Exclusion Reason & Rule</th>
                        <th style="width: 14%; text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                No automatically excluded cases found matching the filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">
                                        <a asp-action="ViewAssignment" asp-route-batch="@item.BatchId" asp-route-id="@item.JobId" class="text-decoration-none text-dark">
                                            @item.BorrowerName
                                        </a>
                                    </div>
                                    <div class="small font-monospace text-muted">@item.Cin</div>
                                    <div class="small text-muted">Job #@item.JobId</div>
                                </td>
                                <td>
                                    <span class="badge bg-dark font-monospace mb-1">@item.CaseRowId</span>
                                    @if (!string.IsNullOrWhiteSpace(item.CaseNo))
                                    {
                                        <div class="small text-dark text-truncate" style="max-width: 160px;" title="@item.CaseNo">@item.CaseNo</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Court))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 160px;" title="@item.Court">@item.Court</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 180px;" title="@item.TargetName">@item.TargetName</div>
                                    <span class="badge @(item.TargetKind == MCAROC_Analysis.Data.Entities.PreLoginTargetKind.Borrower ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-info-subtle text-info-emphasis border border-info-subtle")">
                                        @item.TargetKind
                                    </span>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-danger text-truncate" style="max-width: 180px;" title="@(item.Party ?? "Unknown party")">
                                        @(item.Party ?? "-")
                                    </div>
                                    <div class="small text-muted">Rule: <span class="font-monospace">@item.Rule</span></div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@item.ExclusionReason</div>
                                    <div class="small text-muted">@item.Reason</div>
                                    <div class="small text-muted mt-1">Auto-applied @Ist.Format(item.ExcludedUtc, "dd MMM yyyy, HH:mm")</div>
                                </td>
                                <td style="text-align: right;">
                                    <form method="post" asp-action="UndoExclusion" asp-route-scopeCaseId="@item.ScopeCaseId" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning text-dark fw-semibold" title="Undo automatic exclusion and include this case back into the report">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Undo
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

