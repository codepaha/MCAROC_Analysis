@model MCAROC_Analysis.Models.AssignmentListingViewModel
@{
    ViewData["Title"] = "Borrower Assignments";
}

<div class="pi-page-head d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="pi-kicker text-muted small fw-semibold text-uppercase">Pre-Login Report System</div>
        <h1 class="h3 fw-bold mb-1">Borrower Assignments</h1>
        <p class="text-muted mb-0">Browse and manage pre-login assignments, track automated litigation searches, and review case portfolios.</p>
    </div>
    <div>
        <a asp-controller="PreLoginReports" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> New Assignment
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@Model.SearchText" class="form-control border-start-0" placeholder="Search by Borrower Name, CIN, or LLPIN..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Queued" selected="@(Model.SelectedStatus == "Queued")">Queued</option>
                    <option value="Fetching" selected="@(Model.SelectedStatus == "Fetching")">Fetching MCA</option>
                    <option value="AwaitingLitigation" selected="@(Model.SelectedStatus == "AwaitingLitigation")">Awaiting Litigation</option>
                    <option value="AwaitingReview" selected="@(Model.SelectedStatus == "AwaitingReview")">Awaiting Review</option>
                    <option value="Generating" selected="@(Model.SelectedStatus == "Generating")">Generating Report</option>
                    <option value="Completed" selected="@(Model.SelectedStatus == "Completed")">Completed</option>
                    <option value="Failed" selected="@(Model.SelectedStatus == "Failed")">Failed</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%;">Reference / CIN</th>
                        <th style="width: 25%;">Borrower Name & Type</th>
                        <th style="width: 18%;">SBI Request Branch</th>
                        <th style="width: 16%;">Status</th>
                        <th style="width: 14%;">Litigation Records</th>
                        <th style="width: 12%; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                                No assignments found matching the criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace fw-bold text-dark">@item.Identifier</span>
                                    <div class="small text-muted">@Ist.Format(item.CreatedUtc, "dd MMM yyyy, HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.BorrowerName</div>
                                    <span class="badge bg-light text-dark border">@item.EntityType</span>
                                </td>
                                <td>
                                    <div>@(item.BranchName != "-" ? item.BranchName : "SBI Branch")</div>
                                    <small class="text-muted">Code: @item.BranchCode</small>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Completed":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                            break;
                                        case "AwaitingLitigation":
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle"><i class="bi bi-hourglass-split me-1"></i>Polling Litigation (@item.ProgressPercent%)</span>
                                            break;
                                        case "AwaitingReview":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-exclamation-triangle me-1"></i>Action Required</span>
                                            break;
                                        case "Fetching":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-arrow-repeat me-1"></i>Fetching MCA</span>
                                            break;
                                        case "Failed":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i>Failed</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.NoLitigationFound)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-shield-check me-1"></i>No litigation found</span>
                                    }
                                    else if (item.TotalCases > 0)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-journal-text me-1"></i>@item.TotalCases Cases</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Pending Search</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="ViewAssignment" asp-route-batch="@item.BatchId" asp-route-id="@item.PreLoginReportJobId" class="btn btn-outline-primary" title="Open Workspace">
                                            <i class="bi bi-eye me-1"></i> View
                                        </a>
                                        @if (item.Status == "Completed" && item.ReportStoragePath != null)
                                        {
                                            <a asp-action="Download" asp-route-batch="@item.BatchId" asp-route-id="@item.PreLoginReportJobId" class="btn btn-outline-success" title="Download Report">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

