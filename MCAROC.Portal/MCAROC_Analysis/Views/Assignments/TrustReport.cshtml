@model MCAROC_Analysis.Models.AssignmentTrustReportViewModel
@{
    ViewData["Title"] = "Attribution Trust Report";
    var report = Model.Report;
}

<div class="pi-page-head d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="pi-kicker text-muted small fw-semibold text-uppercase">Pre-Login Report System</div>
        <h1 class="h3 fw-bold mb-1">Attribution Trust Report</h1>
        <p class="text-muted mb-0">Audited precision and efficacy metrics for pre-login automated litigation exclusions across Suggest and Apply modes.</p>
    </div>
</div>

<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link fw-semibold" asp-controller="Assignments" asp-action="Index">
            <i class="bi bi-folder2-open me-1"></i> All Assignments
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-semibold" asp-controller="Assignments" asp-action="Suggestions">
            <i class="bi bi-question-circle me-1"></i> Suggested Exclusions
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-semibold" asp-controller="Assignments" asp-action="AutoExclusions">
            <i class="bi bi-magic me-1"></i> Excluded Automatically
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link active fw-semibold" asp-controller="Assignments" asp-action="TrustReport">
            <i class="bi bi-shield-check me-1"></i> Attribution Trust Report
        </a>
    </li>
</ul>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="TrustReport" class="row g-2 align-items-center">
            <div class="col-md-3">
                <input type="number" name="jobId" value="@(Model.SelectedJobId > 0 ? Model.SelectedJobId : null)" class="form-control" placeholder="Filter by Job ID..." />
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text small bg-transparent">From</span>
                    <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text small bg-transparent">To</span>
                    <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="TrustReport" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small">Overall Precision</div>
            <div class="h3 fw-bold @(!report.OverallPrecision.HasValue ? "text-muted" : report.OverallPrecision.Value >= 0.95 ? "text-success" : report.OverallPrecision.Value >= 0.85 ? "text-primary" : "text-warning") mb-0">
                @(report.OverallPrecision.HasValue ? $"{(report.OverallPrecision.Value * 100):F1}%" : "—")
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small">Suggested</div>
            <div class="h3 fw-bold text-dark mb-0">@report.TotalSuggested</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small">Accepted</div>
            <div class="h3 fw-bold text-success mb-0">@report.TotalAccepted</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small">Rejected</div>
            <div class="h3 fw-bold text-secondary mb-0">@report.TotalRejected</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small">Auto-Applied</div>
            <div class="h3 fw-bold text-info mb-0">@report.TotalAutoApplied</div>
            @if (report.TotalUndone > 0)
            {
                <div class="small text-danger">(@report.TotalUndone undone)</div>
            }
        </div>
    </div>
    <div class="col-md-2">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small">Analyst Misses</div>
            <div class="h3 fw-bold text-danger mb-0">@report.TotalMisses</div>
        </div>
    </div>
</div>

<!-- Breakdown by Reason Kind -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-tag me-2 text-primary"></i>Attribution Precision by Reason Kind
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 25%;">Reason / Rule Kind</th>
                        <th style="width: 12%; text-align: right;">Suggested</th>
                        <th style="width: 12%; text-align: right;">Accepted</th>
                        <th style="width: 12%; text-align: right;">Rejected</th>
                        <th style="width: 13%; text-align: right;">Auto-Applied (Undone)</th>
                        <th style="width: 12%; text-align: right;">Analyst Misses</th>
                        <th style="width: 14%; text-align: right;">Precision</th>
                    </tr>
                </thead>
                <tbody>
                    @if (report.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No attribution decisions recorded for this period.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in report.Rows)
                        {
                            <tr>
                                <td class="font-monospace fw-semibold text-dark">@row.ReasonKind</td>
                                <td style="text-align: right;">@row.Suggested</td>
                                <td style="text-align: right;" class="text-success fw-semibold">@row.Accepted</td>
                                <td style="text-align: right;" class="text-secondary">@row.Rejected</td>
                                <td style="text-align: right;">
                                    @row.AutoApplied
                                    @if (row.Undone > 0)
                                    {
                                        <span class="text-danger small">(-@row.Undone)</span>
                                    }
                                </td>
                                <td style="text-align: right;" class="text-danger">@row.AnalystMiss</td>
                                <td style="text-align: right;">
                                    @if (row.Precision.HasValue)
                                    {
                                        <span class="badge @(row.Precision.Value >= 0.95 ? "bg-success" : row.Precision.Value >= 0.85 ? "bg-primary" : "bg-warning text-dark") fs-6 font-monospace">
                                            @((row.Precision.Value * 100).ToString("F1"))%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border fs-6 font-monospace">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Breakdown by Target Type -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="card-title mb-0 fw-bold text-dark">
            <i class="bi bi-people me-2 text-primary"></i>Attribution Precision by Target Kind
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 25%;">Target Kind</th>
                        <th style="width: 12%; text-align: right;">Suggested</th>
                        <th style="width: 12%; text-align: right;">Accepted</th>
                        <th style="width: 12%; text-align: right;">Rejected</th>
                        <th style="width: 13%; text-align: right;">Auto-Applied (Undone)</th>
                        <th style="width: 12%; text-align: right;">Analyst Misses</th>
                        <th style="width: 14%; text-align: right;">Precision</th>
                    </tr>
                </thead>
                <tbody>
                    @if (report.TargetRows.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No attribution decisions recorded for this period.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in report.TargetRows)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">
                                    <span class="badge @(row.TargetKind == MCAROC_Analysis.Data.Entities.PreLoginTargetKind.Borrower ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-info-subtle text-info-emphasis border border-info-subtle") fs-6">
                                        @row.TargetKind
                                    </span>
                                </td>
                                <td style="text-align: right;">@row.Suggested</td>
                                <td style="text-align: right;" class="text-success fw-semibold">@row.Accepted</td>
                                <td style="text-align: right;" class="text-secondary">@row.Rejected</td>
                                <td style="text-align: right;">
                                    @row.AutoApplied
                                    @if (row.Undone > 0)
                                    {
                                        <span class="text-danger small">(-@row.Undone)</span>
                                    }
                                </td>
                                <td style="text-align: right;" class="text-danger">@row.AnalystMiss</td>
                                <td style="text-align: right;">
                                    @if (row.Precision.HasValue)
                                    {
                                        <span class="badge @(row.Precision.Value >= 0.95 ? "bg-success" : row.Precision.Value >= 0.85 ? "bg-primary" : "bg-warning text-dark") fs-6 font-monospace">
                                            @((row.Precision.Value * 100).ToString("F1"))%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border fs-6 font-monospace">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

