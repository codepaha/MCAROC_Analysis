@model MCAROC_Analysis.Models.AssignmentDetailViewModel
@{
    ViewData["Title"] = $"{Model.BorrowerName} - Assignment Workspace";
}

<div class="container-fluid px-0">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top Workspace Header -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary">Pre-Login Assignment</span>
                        <span class="badge bg-light text-dark border">Version: v@Model.DataVersion</span>
                        <span class="text-muted small">ID: @Model.PreLoginReportJobId</span>
                    </div>
                    <h2 class="h4 fw-bold mb-1 text-dark">@Model.BorrowerName</h2>
                    <div class="text-muted small font-monospace">CIN / Identifier: @Model.Cin &bull; Entity: @Model.EntityType</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Listing
                    </a>
                    @if (Model.Status == "Completed" && Model.ReportStoragePath != null)
                    {
                        <a asp-action="Download" asp-route-batch="@Model.BatchId" asp-route-id="@Model.PreLoginReportJobId" class="btn btn-success">
                            <i class="bi bi-file-earmark-word me-1"></i> Download Report (.docx)
                        </a>
                    }
                </div>
            </div>

            <!-- Progress tracker -->
            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                    <span>Status: <strong>@Model.Status</strong> @(Model.BorrowerTarget?.StatusMessage != null ? $"— {Model.BorrowerTarget.StatusMessage}" : "")</span>
                    <span>@Model.ProgressPercent%</span>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar progress-bar-striped @(Model.Status == "Completed" ? "bg-success" : Model.Status == "Failed" ? "bg-danger" : "bg-primary")"
                         role="progressbar" style="width: @(Model.ProgressPercent)%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4" id="assignmentTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2 fw-semibold" id="tab-annexure-btn" data-bs-toggle="pill" data-bs-target="#tab-annexure" type="button" role="tab">
                <i class="bi bi-file-text me-1"></i> Tab 1: Annexure & Borrower Details
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 fw-semibold position-relative" id="tab-cases-btn" data-bs-toggle="pill" data-bs-target="#tab-cases" type="button" role="tab">
                <i class="bi bi-journals me-1"></i> Tab 2: Legal Cases & Litigation Lake
                <span class="badge bg-secondary ms-2">@Model.TotalCases</span>
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="assignmentTabContent">
        <!-- TAB 1: Annexure & Borrower Details -->
        <div class="tab-pane fade show active" id="tab-annexure" role="tabpanel">
            <div class="row g-4">
                <!-- Left: Branch & Corporate Profile -->
                <div class="col-lg-7">
                    <!-- Branch Details -->
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-bank me-2 text-primary"></i>Requesting SBI Branch Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="text-muted small">Branch Name</label>
                                    <div class="fw-semibold">@(Model.Assignment?.RequestingBranchDetails?.BranchName ?? "SBI Commercial Branch")</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small">Branch Code</label>
                                    <div class="fw-semibold">@(Model.Assignment?.RequestingBranchDetails?.BranchCode ?? "-")</div>
                                </div>
                                <div class="col-12">
                                    <label class="text-muted small">Branch Address</label>
                                    <div class="fw-semibold">@(Model.Assignment?.RequestingBranchDetails?.Address ?? "-")</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small">Contact Officer</label>
                                    <div class="fw-semibold">@(Model.Assignment?.RequestingBranchDetails?.ContactPerson?.Name ?? "-")</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small">Contact Number / Email</label>
                                    <div class="fw-semibold">@(Model.Assignment?.RequestingBranchDetails?.ContactPerson?.PhoneMobile ?? Model.Assignment?.RequestingBranchDetails?.ContactPerson?.Email ?? "-")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Corporate Profile -->
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-building me-2 text-primary"></i>Corporate Profile & Registration</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="text-muted small">Registered Entity Name</label>
                                    <div class="fw-semibold">@Model.BorrowerName</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small">Entity Classification</label>
                                    <div class="fw-semibold">@Model.EntityType</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small">CIN / LLPIN</label>
                                    <div class="fw-semibold font-monospace">@Model.Cin</div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="text-muted small">PAN Number</label>
                                    <div class="fw-semibold font-monospace">@(Model.Assignment?.CompanyDetails?.Pan ?? "-")</div>
                                </div>
                                <div class="col-12">
                                    <label class="text-muted small">Registered Office Address</label>
                                    <div class="fw-semibold">@(Model.Assignment?.CompanyDetails?.RegisteredOfficeAddress ?? Model.StoredData?.Company?.Address ?? "-")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Directors & Partners Inventory -->
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-people me-2 text-primary"></i>Directors & Signatories</h5>
                            <span class="badge bg-light text-dark border">Manual Search Opt-In Only</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>DIN / PAN</th>
                                            <th>Designation</th>
                                            <th style="text-align: right;">Litigation Search</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Assignment?.CompanyDetails?.DirectorsOrPartners is { Count: > 0 } directors)
                                        {
                                            @for (int i = 0; i < directors.Count; i++)
                                            {
                                                var dir = directors[i];
                                                var dirTarget = Model.DirectorTargets.FirstOrDefault(t => t.TargetIndex == i);
                                                <tr>
                                                    <td class="fw-semibold">@dir.Name</td>
                                                    <td class="font-monospace small">@(dir.Din ?? dir.Pan ?? "-")</td>
                                                    <td>Director / Partner</td>
                                                    <td style="text-align: right;">
                                                        @if (dirTarget is null)
                                                        {
                                                            <form method="post" asp-action="SearchDirector" asp-route-batch="@Model.BatchId" asp-route-id="@Model.PreLoginReportJobId" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="directorName" value="@dir.Name" />
                                                                <input type="hidden" name="dinPan" value="@(dir.Din ?? dir.Pan)" />
                                                                <input type="hidden" name="targetIndex" value="@i" />
                                                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                                                    <i class="bi bi-search me-1"></i> Search
                                                                </button>
                                                            </form>
                                                        }
                                                        else if (dirTarget.Status == "Completed")
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                                <i class="bi bi-check-circle me-1"></i> Completed
                                                            </span>
                                                        }
                                                        else if (dirTarget.Status == "Failed")
                                                        {
                                                            <form method="post" asp-action="SearchDirector" asp-route-batch="@Model.BatchId" asp-route-id="@Model.PreLoginReportJobId" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="directorName" value="@dir.Name" />
                                                                <input type="hidden" name="dinPan" value="@(dir.Din ?? dir.Pan)" />
                                                                <input type="hidden" name="targetIndex" value="@i" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                    <i class="bi bi-arrow-repeat me-1"></i> Retry
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                                <i class="spinner-border spinner-border-sm me-1" style="width:0.75rem;height:0.75rem;"></i> @dirTarget.Status
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">No associated directors discovered on intake.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Litigation Search Progress & Reconciliation Card -->
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="card-title mb-0 fw-bold text-dark"><i class="bi bi-shield-shaded me-2 text-primary"></i>Litigation Search & Worker State</h5>
                        </div>
                        <div class="card-body">
                            @if (Model.BorrowerTarget is { } target)
                            {
                                <div class="mb-3">
                                    <label class="text-muted small">Target Status</label>
                                    <div>
                                        <span class="badge @(target.Status == "Completed" ? "bg-success" : target.Status == "AmbiguousRegistration" ? "bg-warning text-dark" : target.Status == "Failed" ? "bg-danger" : "bg-primary") fs-6">
                                            @target.Status
                                        </span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="text-muted small">Status Message</label>
                                    <div class="fw-semibold text-dark">@(target.StatusMessage ?? "Processing search request...")</div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="text-muted small">Vendor Job ID</label>
                                        <div class="font-monospace">@(target.VendorJobId ?? "(None)")</div>
                                    </div>
                                    <div class="col-6">
                                        <label class="text-muted small">Attempt Version</label>
                                        <div class="fw-bold">v@target.AttemptVersion</div>
                                    </div>
                                    <div class="col-6">
                                        <label class="text-muted small">Attempt Count</label>
                                        <div>@target.AttemptCount</div>
                                    </div>
                                    <div class="col-6">
                                        <label class="text-muted small">Polling Deadline</label>
                                        <div class="small">@(target.PollingDeadlineUtc.HasValue ? Ist.Format(target.PollingDeadlineUtc.Value, "dd MMM HH:mm:ss") : "(Not active)")</div>
                                    </div>
                                </div>

                                <!-- Action Panels for Reconciliation -->
                                @if (target.Status == "AmbiguousRegistration")
                                {
                                    <div class="alert alert-warning border-warning">
                                        <h6 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Ambiguous Registration Detected</h6>
                                        <p class="small mb-3">@(target.FailureReason ?? "Registration intent did not confirm a successful vendor job ID before worker crashed, or keywords could not be corroborated.")</p>
                                        <div class="d-flex flex-column gap-2">
                                            <button type="button" class="btn btn-warning btn-sm fw-bold text-dark" data-bs-toggle="modal" data-bs-target="#provideVendorJobModal">
                                                <i class="bi bi-input-cursor-text me-1"></i> Provide Vendor Job ID
                                            </button>
                                            <button type="button" class="btn btn-outline-dark btn-sm" data-bs-toggle="modal" data-bs-target="#confirmNoSearchModal">
                                                <i class="bi bi-arrow-clockwise me-1"></i> Confirm No Search Exists
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (target.Status == "Failed")
                                {
                                    <div class="alert alert-danger border-danger">
                                        <h6 class="alert-heading fw-bold"><i class="bi bi-x-octagon-fill me-1"></i> Search Polling Failed</h6>
                                        <p class="small mb-3">@(target.FailureReason ?? "Vendor reported an unrecoverable failure or polling deadline expired.")</p>
                                        <div class="d-flex gap-2">
                                            @if (target.VendorJobId != null)
                                            {
                                                <form asp-action="Repoll" asp-route-batch="@Model.BatchId" asp-route-id="@Model.PreLoginReportJobId" method="post" class="flex-grow-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="targetId" value="@target.PreLoginLitigationTargetId" />
                                                    <input type="hidden" name="submittedAttemptVersion" value="@target.AttemptVersion" />
                                                    <button type="submit" class="btn btn-danger btn-sm w-100 fw-bold">
                                                        <i class="bi bi-arrow-repeat me-1"></i> Re-poll (Renew Window)
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Retry" asp-route-batch="@Model.BatchId" asp-route-id="@Model.PreLoginReportJobId" method="post" class="flex-grow-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="targetId" value="@target.PreLoginLitigationTargetId" />
                                                    <input type="hidden" name="submittedAttemptVersion" value="@target.AttemptVersion" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 fw-bold">
                                                        <i class="bi bi-arrow-clockwise me-1"></i> Clean Retry
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (target.Status == "Completed")
                                {
                                    <div class="alert alert-success border-success">
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-check-circle-fill fs-4 me-2 text-success"></i>
                                            <div>
                                                <strong>Search Successfully Synchronized</strong>
                                                <div class="small">@(target.NoLitigationFound == true ? "Confirmed 0 active matters in court databases." : $"{Model.TotalCases} matters retrieved and linked to assignment.")</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted py-3 text-center">No litigation search dispatched for this assignment.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: Legal Cases & Litigation Lake -->
        <div class="tab-pane fade" id="tab-cases" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0">Legal Case Portfolio</h5>
                    <p class="text-muted small mb-0">Review discovered litigation records, verify automated attribution suggestions, and manage report inclusions.</p>
                </div>
                <div>
                    <a asp-action="TrustReport" asp-route-jobId="@Model.PreLoginReportJobId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-shield-check me-1"></i> Assignment Trust Report
                    </a>
                </div>
            </div>

            <!-- KPI Summary Cards -->
            <div class="row g-2 mb-4">
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <div class="text-muted small">Total Cases</div>
                        <div class="h3 fw-bold text-dark mb-0">@Model.TotalCases</div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <div class="text-muted small">High Court</div>
                        <div class="h3 fw-bold text-primary mb-0">@Model.HighCourtCases</div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <div class="text-muted small">District Court</div>
                        <div class="h3 fw-bold text-info mb-0">@Model.DistrictCases</div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <div class="text-muted small">DRT & Tribunals</div>
                        <div class="h3 fw-bold text-secondary mb-0">@Model.TribunalCases</div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <div class="text-muted small">Included</div>
                        <div class="h3 fw-bold text-success mb-0" id="kpiIncluded">@Model.IncludedCases</div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100">
                        <div class="text-muted small">Excluded</div>
                        <div class="h3 fw-bold text-muted mb-0" id="kpiExcluded">@Model.ExcludedCases</div>
                    </div>
                </div>
                <div class="col">
                    <div class="card border-0 shadow-sm text-center p-3 h-100 @(Model.SuggestedExclusionsCount > 0 ? "border-warning border-2 bg-warning-subtle" : "")">
                        <div class="text-muted small">Suggested Excl.</div>
                        <div class="h3 fw-bold @(Model.SuggestedExclusionsCount > 0 ? "text-warning-emphasis" : "text-muted") mb-0">
                            @Model.SuggestedExclusionsCount
                        </div>
                    </div>
                </div>
            </div>

            <!-- Multi-faceted Filter Bar -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="caseSearchInput" class="form-control border-start-0" placeholder="Search Case ID, CNR, Court, Parties..." oninput="filterCases()" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <select id="caseCategoryFilter" class="form-select" onchange="filterCases()">
                                <option value="all">All Forums</option>
                                <option value="high">High Court</option>
                                <option value="district">District Court</option>
                                <option value="drt">DRT / DRAT</option>
                                <option value="nclt">NCLT / NCLAT</option>
                                <option value="consumer">Consumer Forum</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select id="caseDirectionFilter" class="form-select" onchange="filterCases()">
                                <option value="all">All Directions</option>
                                <option value="against">Against Borrower</option>
                                <option value="by">By Borrower</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select id="caseStatusFilter" class="form-select" onchange="filterCases()">
                                <option value="all">All Judicial Status</option>
                                <option value="pending">Pending Only</option>
                                <option value="disposed">Concluded / Disposed</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select id="caseInclusionFilter" class="form-select" onchange="filterCases()">
                                <option value="all">All Inclusions</option>
                                <option value="included">Included in Report</option>
                                <option value="excluded">Excluded Only</option>
                                <option value="suggested">Suggested Exclusion</option>
                                <option value="auto-excluded">Excluded Automatically</option>
                                <option value="unconfirmed">Could not confirm (Review)</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Selection Controls Bar -->
            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllVisible(true)">Select Visible</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllMatchingFilter()">Select All Matching Filter</button>
                    <button type="button" class="btn btn-sm btn-link text-muted" onclick="deselectAll()">Deselect All</button>
                </div>
                <div class="text-muted small" id="matchingCasesCount">Showing @Model.Cases.Count cases</div>
            </div>

            <!-- Case Lake Table -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="casesTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;"><input type="checkbox" id="masterCheckbox" onchange="toggleMasterCheckbox(this)" /></th>
                                    <th style="width: 14%;">Case No & CNR</th>
                                    <th style="width: 18%;">Court & Forum</th>
                                    <th style="width: 8%;">Direction</th>
                                    <th style="width: 25%;">Parties (Petitioner vs Respondent)</th>
                                    <th style="width: 12%;">Stage / Status</th>
                                    <th style="width: 11%;">Report Status</th>
                                    <th style="width: 8%; text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Cases.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                            No litigation records discovered for this borrower.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var c in Model.Cases)
                                    {
                                        var isConcluded = MCAROC_Analysis.Models.LitigationCaseStatusClassifier.IsConcluded(c.Status, c.CaseStage);
                                        Model.CaseAttributions.TryGetValue(c.CaseRowId, out var attr);
                                        var isSuggested = attr?.IsSuggestedExclusion == true;
                                        var isAutoExcluded = attr?.IsAutoExcluded == true;
                                        var isUnconfirmed = attr?.IsUnconfirmed == true;
                                        <tr data-case-row-id="@c.CaseRowId"
                                            data-cnr="@c.CnrNumber"
                                            data-court="@c.Court"
                                            data-category="@c.Category"
                                            data-direction="@c.CaseDetails"
                                            data-status="@c.Status"
                                            data-stage="@c.CaseStage"
                                            data-is-concluded="@isConcluded.ToString().ToLowerInvariant()"
                                            data-excluded="@c.IsExcludedFromReport.ToString().ToLowerInvariant()"
                                            data-is-suggested="@isSuggested.ToString().ToLowerInvariant()"
                                            data-is-auto-excluded="@isAutoExcluded.ToString().ToLowerInvariant()"
                                            data-is-unconfirmed="@isUnconfirmed.ToString().ToLowerInvariant()"
                                            data-exclusion-reason="@(c.ExclusionReason ?? "")"
                                            data-analyst-note="@(c.AnalystNote ?? "")"
                                            data-parties="@c.CaseDetails">
                                            <td>
                                                <input type="checkbox" class="case-select-checkbox" value="@c.CaseRowId" onchange="onCaseCheckboxChanged()" />
                                            </td>
                                            <td>
                                                <span class="badge bg-dark font-monospace mb-1">@c.CaseRowId</span>
                                                <div class="font-monospace small fw-semibold text-primary text-truncate" style="max-width: 160px;" title="@c.CnrNumber">@(c.CnrNumber != "-" ? c.CnrNumber : "(No CNR)")</div>
                                                <div class="small text-muted text-truncate" style="max-width: 160px;" title="@c.CaseNo">@c.CaseNo (@c.CaseYear)</div>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark text-truncate" style="max-width: 200px;" title="@c.Court">@c.Court</div>
                                                <div class="small text-muted">Category: @c.Category</div>
                                            </td>
                                            <td>
                                                @if (c.CaseDetails.Contains("against", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Against</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">By</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="small text-dark text-truncate" style="max-width: 280px;" title="@c.CaseDetails">@c.CaseDetails</div>
                                                <div class="small text-muted font-monospace">Act: @(c.Act != "-" ? c.Act : "N/A")</div>
                                                @if (attr?.TargetName != null)
                                                {
                                                    <div class="small text-muted mt-1">
                                                        <span class="badge bg-light text-dark border">Target: @attr.TargetName (@attr.TargetKind)</span>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (isConcluded)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary" title="Judicial disposition concluded">
                                                        <i class="bi bi-lock-fill me-1"></i>@(c.Status != "-" ? c.Status : c.CaseStage)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                        @(c.Status != "-" ? c.Status : c.CaseStage)
                                                    </span>
                                                }
                                                <div class="small text-muted mt-1">Stage: @c.CaseStage</div>
                                            </td>
                                            <td>
                                                @if (c.IsExcludedFromReport)
                                                {
                                                    if (isAutoExcluded)
                                                    {
                                                        <span class="badge bg-warning text-dark"><i class="bi bi-magic me-1"></i>Excluded automatically</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary text-white"><i class="bi bi-eye-slash me-1"></i>Excluded</span>
                                                    }
                                                    <div class="small text-muted text-truncate" style="max-width: 130px;" title="@c.ExclusionReason">@c.ExclusionReason</div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle me-1"></i>Included</span>
                                                    @if (isSuggested)
                                                    {
                                                        <div class="mt-1">
                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning" title="@attr?.Reason">
                                                                <i class="bi bi-exclamation-triangle me-1"></i>Suggested exclusion
                                                            </span>
                                                            @if (!string.IsNullOrWhiteSpace(attr?.Party))
                                                            {
                                                                <div class="small text-danger text-truncate" style="max-width: 140px;" title="@attr.Party">Party: @attr.Party</div>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(attr?.Reason))
                                                            {
                                                                <div class="small text-muted text-truncate" style="max-width: 140px;" title="@attr.Reason">@attr.Reason</div>
                                                            }
                                                        </div>
                                                    }
                                                    else if (isUnconfirmed)
                                                    {
                                                        <div class="mt-1">
                                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary" title="@attr?.Reason">
                                                                <i class="bi bi-question-diamond me-1"></i>Could not confirm (Review)
                                                            </span>
                                                            @if (!string.IsNullOrWhiteSpace(attr?.Reason))
                                                            {
                                                                <div class="small text-muted text-truncate" style="max-width: 140px;" title="@attr.Reason">@attr.Reason</div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td style="text-align: right;">
                                                <div class="d-inline-flex flex-column gap-1 align-items-end">
                                                    @if (isSuggested && attr != null)
                                                    {
                                                        <div class="d-inline-flex gap-1 mb-1">
                                                            <form method="post" asp-action="AcceptSuggestion" asp-route-scopeCaseId="@attr.ScopeCaseId" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                                <button type="submit" class="btn btn-xs btn-outline-danger py-0 px-1" title="Accept exclusion suggestion">
                                                                    <i class="bi bi-check-lg"></i> Accept
                                                                </button>
                                                            </form>
                                                            <form method="post" asp-action="RejectSuggestion" asp-route-scopeCaseId="@attr.ScopeCaseId" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                                <button type="submit" class="btn btn-xs btn-outline-secondary py-0 px-1" title="Reject exclusion suggestion">
                                                                    <i class="bi bi-x-lg"></i> Reject
                                                                </button>
                                                            </form>
                                                        </div>
                                                    }
                                                    else if (isAutoExcluded && attr != null)
                                                    {
                                                        <form method="post" asp-action="UndoExclusion" asp-route-scopeCaseId="@attr.ScopeCaseId" class="d-inline mb-1">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                            <button type="submit" class="btn btn-xs btn-outline-warning text-dark py-0 px-1 fw-semibold" title="Undo automatic exclusion">
                                                                <i class="bi bi-arrow-counterclockwise"></i> Undo
                                                            </button>
                                                        </form>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openSingleEditModal('@c.CaseRowId')">
                                                        <i class="bi bi-pencil-square"></i> Edit
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

