@section Scripts {
<script>
    let currentBatchId = '@Model.BatchId';
    let currentJobId = @Model.PreLoginReportJobId;
    let submittedDataVersion = @Model.DataVersion;
    let selectedCaseIds = new Set();
    let isSelectAllMatchingFilterActive = false;

    function filterCases() {
        const searchText = document.getElementById('caseSearchInput').value.toLowerCase().trim();
        const category = document.getElementById('caseCategoryFilter').value;
        const direction = document.getElementById('caseDirectionFilter').value;
        const status = document.getElementById('caseStatusFilter').value;
        const inclusion = document.getElementById('caseInclusionFilter').value;

        const rows = document.querySelectorAll('#casesTable tbody tr[data-case-row-id]');
        let visibleCount = 0;

        rows.forEach(row => {
            const rowText = (row.getAttribute('data-case-row-id') + ' ' +
                             row.getAttribute('data-cnr') + ' ' +
                             row.getAttribute('data-court') + ' ' +
                             row.getAttribute('data-parties')).toLowerCase();
            const rowCategory = row.getAttribute('data-category').toLowerCase();
            const rowDirection = row.getAttribute('data-direction').toLowerCase();
            const rowIsConcluded = row.getAttribute('data-is-concluded') === 'true';
            const rowIsExcluded = row.getAttribute('data-excluded') === 'true';
            const rowIsSuggested = row.getAttribute('data-is-suggested') === 'true';
            const rowIsAutoExcluded = row.getAttribute('data-is-auto-excluded') === 'true';
            const rowIsUnconfirmed = row.getAttribute('data-is-unconfirmed') === 'true';

            let matchesSearch = !searchText || rowText.includes(searchText);
            let matchesCategory = category === 'all' || rowCategory.includes(category);
            let matchesDirection = direction === 'all' || rowDirection.includes(direction);
            let matchesStatus = status === 'all' || (status === 'disposed' ? rowIsConcluded : !rowIsConcluded);
            let matchesInclusion = inclusion === 'all' ||
                                   (inclusion === 'included' && !rowIsExcluded) ||
                                   (inclusion === 'excluded' && rowIsExcluded) ||
                                   (inclusion === 'suggested' && rowIsSuggested) ||
                                   (inclusion === 'auto-excluded' && rowIsAutoExcluded) ||
                                   (inclusion === 'unconfirmed' && rowIsUnconfirmed);

            if (matchesSearch && matchesCategory && matchesDirection && matchesStatus && matchesInclusion) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('matchingCasesCount').innerText = `Showing ${visibleCount} cases`;
        onCaseCheckboxChanged();
    }

    function toggleMasterCheckbox(master) {
        selectAllVisible(master.checked);
    }

    function selectAllVisible(select) {
        isSelectAllMatchingFilterActive = false;
        const rows = document.querySelectorAll('#casesTable tbody tr[data-case-row-id]');
        rows.forEach(row => {
            if (row.style.display !== 'none') {
                const cb = row.querySelector('.case-select-checkbox');
                if (cb) {
                    cb.checked = select;
                    if (select) selectedCaseIds.add(cb.value);
                    else selectedCaseIds.delete(cb.value);
                }
            }
        });
        updateBatchToolbar();
    }

    function selectAllMatchingFilter() {
        selectAllVisible(true);
        isSelectAllMatchingFilterActive = true;
        updateBatchToolbar();
    }

    function deselectAll() {
        selectedCaseIds.clear();
        isSelectAllMatchingFilterActive = false;
        const checkboxes = document.querySelectorAll('.case-select-checkbox');
        checkboxes.forEach(cb => cb.checked = false);
        const master = document.getElementById('masterCheckbox');
        if (master) master.checked = false;
        updateBatchToolbar();
    }

    function onCaseCheckboxChanged() {
        selectedCaseIds.clear();
        isSelectAllMatchingFilterActive = false;
        const checkboxes = document.querySelectorAll('.case-select-checkbox:checked');
        checkboxes.forEach(cb => selectedCaseIds.add(cb.value));
        updateBatchToolbar();
    }

    function updateBatchToolbar() {
        const toolbar = document.getElementById('batchActionToolbar');
        const countSpan = document.getElementById('selectedCasesCount');
        const count = selectedCaseIds.size;
        countSpan.innerText = isSelectAllMatchingFilterActive ? `${count} (All matching filter)` : count;

        if (count > 0) {
            toolbar.classList.remove('d-none');
            toolbar.classList.add('d-flex');
        } else {
            toolbar.classList.remove('d-flex');
            toolbar.classList.add('d-none');
        }
    }

    function openSingleEditModal(caseRowId) {
        const row = document.querySelector(`tr[data-case-row-id="${caseRowId}"]`);
        if (!row) return;

        document.getElementById('modalCaseRowId').innerText = caseRowId;
        document.getElementById('modalCnr').innerText = row.getAttribute('data-cnr');
        document.getElementById('modalCourt').innerText = row.getAttribute('data-court');
        document.getElementById('modalParties').innerText = row.getAttribute('data-parties');

        const isConcluded = row.getAttribute('data-is-concluded') === 'true';
        const isExcluded = row.getAttribute('data-excluded') === 'true';
        const currentStatus = row.getAttribute('data-status');
        const currentStage = row.getAttribute('data-stage');
        const exclusionReason = row.getAttribute('data-exclusion-reason');
        const analystNote = row.getAttribute('data-analyst-note');

        const statusSelect = document.getElementById('modalStatusSelect');
        const stageInput = document.getElementById('modalStageInput');
        const concludedBanner = document.getElementById('concludedWarningBanner');

        if (isConcluded) {
            statusSelect.disabled = true;
            stageInput.disabled = true;
            concludedBanner.classList.remove('d-none');
        } else {
            statusSelect.disabled = false;
            stageInput.disabled = false;
            concludedBanner.classList.add('d-none');
        }

        statusSelect.value = currentStatus;
        stageInput.value = currentStage;
        document.getElementById('modalInclusionSwitch').checked = !isExcluded;
        document.getElementById('modalExclusionReasonSelect').value = exclusionReason || "Claim Value Below Materiality Threshold (< ₹5 Lakhs)";
        document.getElementById('modalAnalystNote').value = analystNote || "";

        onModalInclusionChanged();
        new bootstrap.Modal(document.getElementById('singleCaseEditModal')).show();
    }

    function onModalInclusionChanged() {
        const isIncluded = document.getElementById('modalInclusionSwitch').checked;
        const exclusionGroup = document.getElementById('exclusionFieldsGroup');
        if (isIncluded) {
            exclusionGroup.style.display = 'none';
        } else {
            exclusionGroup.style.display = 'block';
        }
    }

    async function saveSingleCaseEdit() {
        const caseRowId = document.getElementById('modalCaseRowId').innerText;
        const isIncluded = document.getElementById('modalInclusionSwitch').checked;
        const payload = {
            caseRowId: caseRowId,
            status: document.getElementById('modalStatusSelect').disabled ? null : document.getElementById('modalStatusSelect').value,
            caseStage: document.getElementById('modalStageInput').disabled ? null : document.getElementById('modalStageInput').value,
            isExcludedFromReport: !isIncluded,
            exclusionReason: !isIncluded ? document.getElementById('modalExclusionReasonSelect').value : null,
            analystNote: document.getElementById('modalAnalystNote').value,
            submittedDataVersion: submittedDataVersion
        };

        try {
            const resp = await fetch(`/assignments/single-case-edit/${currentBatchId}/${currentJobId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!resp.ok) {
                const err = await resp.json();
                alert(`Error: ${err.error || 'Update failed'}`);
                return;
            }

            location.reload();
        } catch (e) {
            alert(`Network error: ${e.message}`);
        }
    }

    function openBatchExcludeModal() {
        document.getElementById('bulkExcludeCount').innerText = selectedCaseIds.size;
        new bootstrap.Modal(document.getElementById('bulkExcludeModal')).show();
    }

    function openBatchStatusModal() {
        new bootstrap.Modal(document.getElementById('bulkStatusModal')).show();
    }

    async function executeBatchExclude() {
        const payload = {
            caseRowIds: Array.from(selectedCaseIds),
            selectAllMatchingFilter: isSelectAllMatchingFilterActive,
            filter: {
                category: document.getElementById('caseCategoryFilter').value,
                direction: document.getElementById('caseDirectionFilter').value,
                statusBucket: document.getElementById('caseStatusFilter').value,
                searchText: document.getElementById('caseSearchInput').value
            },
            operation: "Exclude",
            exclusionReason: document.getElementById('bulkExclusionReason').value,
            analystNote: document.getElementById('bulkAnalystNote').value,
            submittedDataVersion: submittedDataVersion
        };

        await sendBatchUpdate(payload);
    }

    async function executeBatchInclude() {
        if (!confirm(`Restore report inclusion for ${selectedCaseIds.size} selected cases?`)) return;

        const payload = {
            caseRowIds: Array.from(selectedCaseIds),
            selectAllMatchingFilter: isSelectAllMatchingFilterActive,
            filter: {
                category: document.getElementById('caseCategoryFilter').value,
                direction: document.getElementById('caseDirectionFilter').value,
                statusBucket: document.getElementById('caseStatusFilter').value,
                searchText: document.getElementById('caseSearchInput').value
            },
            operation: "Include",
            submittedDataVersion: submittedDataVersion
        };

        await sendBatchUpdate(payload);
    }

    async function executeBatchUpdateStatus() {
        const payload = {
            caseRowIds: Array.from(selectedCaseIds),
            selectAllMatchingFilter: isSelectAllMatchingFilterActive,
            filter: {
                category: document.getElementById('caseCategoryFilter').value,
                direction: document.getElementById('caseDirectionFilter').value,
                statusBucket: document.getElementById('caseStatusFilter').value,
                searchText: document.getElementById('caseSearchInput').value
            },
            operation: "UpdateStatus",
            newStatus: document.getElementById('bulkNewStatus').value,
            submittedDataVersion: submittedDataVersion
        };

        await sendBatchUpdate(payload);
    }

    async function sendBatchUpdate(payload) {
        try {
            const resp = await fetch(`/assignments/batch-update-cases/${currentBatchId}/${currentJobId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!resp.ok) {
                const err = await resp.json();
                alert(`Error: ${err.error || 'Batch update failed'}`);
                return;
            }

            const res = await resp.json();
            alert(res.message);
            location.reload();
        } catch (e) {
            alert(`Network error: ${e.message}`);
        }
    }
</script>
}

