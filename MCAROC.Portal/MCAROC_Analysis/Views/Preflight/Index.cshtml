@using MCAROC_Analysis.Services.Preflight
@model PreflightReport
@{
    ViewData["Title"] = "Pre-flight check";
    string Badge(PreflightOutcome o) => o switch
    {
        PreflightOutcome.Pass => "text-bg-success",
        PreflightOutcome.Warn => "text-bg-warning",
        _ => "text-bg-danger"
    };
    string Label(PreflightOutcome o) => o switch
    {
        PreflightOutcome.Pass => "Pass",
        PreflightOutcome.Warn => "Warning",
        _ => "Fail"
    };
    var asText = $"Pre-flight {Ist.Format(Model.CheckedUtc)}: {Label(Model.Overall)}\n"
        + string.Join("\n", Model.Checks.Select(c => $"- {c.Name}: {Label(c.Outcome)}. {c.Detail}"));
}

<div class="container py-3" id="preflight-page" style="max-width:1100px;">
    <h1 class="h4">Pre-flight check</h1>
    <p class="text-muted">Run this before an end-to-end test round. Every check is free and read-only: nothing spends a credit, starts a probe, registers a litigation search or calls an AI model. If the reference tool session has expired, it signs in once.</p>

    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <span class="badge fs-6 @Badge(Model.Overall)" id="preflight-overall">@Label(Model.Overall)</span>
        <span class="text-muted small">Checked @Ist.Format(Model.CheckedUtc)</span>
        <a class="btn btn-sm btn-outline-primary ms-auto" href="/Preflight">Run again</a>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="preflight-copy">Copy as text</button>
    </div>

    <div class="card shadow-sm">
        <table class="table mb-0 align-middle">
            <thead class="table-light">
                <tr><th>Check</th><th>Result</th><th>Detail</th><th class="text-end">Time</th></tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Checks)
            {
                <tr data-check="@c.Key">
                    <td class="fw-semibold">@c.Name</td>
                    <td><span class="badge @Badge(c.Outcome)">@Label(c.Outcome)</span></td>
                    <td>
                        <div>@c.Detail</div>
                        @if (c.Fix is not null)
                        {
                            <div class="small text-muted">@c.Fix</div>
                        }
                    </td>
                    <td class="text-end small text-muted">@((c.ElapsedMs / 1000.0).ToString("0.0")) s</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <textarea id="preflight-text" class="d-none" readonly>@asText</textarea>
</div>

@section Scripts {
    <script>
        document.getElementById('preflight-copy').addEventListener('click', function () {
            var text = document.getElementById('preflight-text').value;
            navigator.clipboard.writeText(text).then(function () {
                var b = document.getElementById('preflight-copy');
                b.textContent = 'Copied';
                setTimeout(function () { b.textContent = 'Copy as text'; }, 1500);
            });
        });
    </script>
}
