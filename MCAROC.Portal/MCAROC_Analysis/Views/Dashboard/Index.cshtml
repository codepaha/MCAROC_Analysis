@model DashboardViewModel
@using MCAROC_Analysis.Models.Viz
@using MCAROC_Analysis.Services.Dashboard
@{
    ViewData["Title"] = "Dashboard";
    string PriorityPill(ReviewPriority p) => p switch
    {
        ReviewPriority.High => "pi-status-failed",
        ReviewPriority.Medium => "pi-status-processing",
        _ => "pi-status-completed"
    };

    // #120 (C9): the 3 Chart.js canvases' data, mapped into the shared SVG chart contract. A null
    // series *is* the "no data" guard — replacing the old Razor Count/All(==0) checks plus, for
    // priority/findings, the old JS's own separate zero-filtered-to-nothing checks.
    var trendSeries = Model.RequestTrend.All(t => t.Created == 0)
        ? null
        : DashboardChartMapping.ToChartSeries(Model.RequestTrend, Model.TrendGranularity);
    var prioritySeries = DashboardChartMapping.ToPriorityDistributionSeries(Model.PriorityDistribution);
    var findingsSeries = DashboardChartMapping.ToFindingsBySectionSeries(Model.FindingsBySection);
}

<div class="pi-page-head">
    <div>
        <div class="pi-kicker">Operations &amp; Risk Intelligence</div>
        <h1>Dashboard</h1>
        <p>Showing @Model.Window.From.ToString("d MMM yyyy") &ndash; @Model.Window.To.ToString("d MMM yyyy"). Every figure links through to the matching requests.</p>
    </div>
</div>

<div class="pi-panel mb-4" style="padding:18px 20px;">
    <form method="get" asp-action="Index" class="mca-filter-form">
        <div>
            <label class="form-label">Date From</label>
            <input type="date" name="DateFrom" value="@Model.Filters.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div>
            <label class="form-label">Date To</label>
            <input type="date" name="DateTo" value="@Model.Filters.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div>
            <label class="form-label">Client</label>
            <select name="ClientId" class="form-select">
                <option value="">All Clients</option>
                @foreach (var c in Model.Clients)
                {
                    <option value="@c.ClientId" selected="@(Model.Filters.ClientId == c.ClientId)">@c.ClientName@(c.IsActive ? "" : " (inactive)")</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Analysis Status</label>
            <select name="Status" class="form-select">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<RequestStatus>())
                {
                    <option value="@s" selected="@(Model.Filters.Status == s)">@s</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Review Priority</label>
            <select name="Priority" class="form-select">
                <option value="">All</option>
                @foreach (var p in Enum.GetValues<ReviewPriority>())
                {
                    <option value="@p" selected="@(Model.Filters.Priority == p)">@p</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Entity Type</label>
            <select name="EntityType" class="form-select">
                <option value="">All</option>
                @foreach (var e in Enum.GetValues<EntityType>())
                {
                    <option value="@e" selected="@(Model.Filters.EntityType == e)">@e</option>
                }
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Apply</button>
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Clear</a>
        </div>
    </form>
</div>

<div class="pi-metric-grid">
    <div class="pi-metric">
        <span>Total Requests</span>
        <strong><a asp-controller="Requests" asp-action="Index" asp-all-route-data="@(Model.Filters.ToRouteValues())">@Model.TotalRequests</a></strong>
        @if (Model.TotalRequestsTrendPercent is { } trend)
        {
            <small class="@(trend >= 0 ? "text-success" : "text-danger")">@(trend >= 0 ? "▲" : "▼") @Math.Abs(trend)% vs prior period</small>
        }
    </div>
    <div class="pi-metric">
        <span>Processing</span>
        <strong><a asp-controller="Requests" asp-action="Index" asp-all-route-data="@(Model.Filters.ToRouteValues())">@Model.ProcessingCount</a></strong>
        <small>
            @foreach (var stage in RequestRiskDefinitions.ProcessingStatuses)
            {
                if (Model.ProcessingByRequestStatus.TryGetValue(stage, out var count) && count > 0) { <text>@stage: @count &nbsp;</text> }
            }
            @foreach (var stage in RequestRiskDefinitions.FilingBatchActiveStatuses)
            {
                if (Model.ProcessingByFilingBatchStatus.TryGetValue(stage, out var count) && count > 0) { <text>MCA Docs (@stage): @count &nbsp;</text> }
            }
        </small>
    </div>
    <div class="pi-metric">
        <span>Analysis Completed</span>
        <strong><a asp-controller="Requests" asp-action="Index" asp-all-route-data="@(Model.Filters.ToRouteValues(new() { ["Status"] = "AnalysisCompleted" }))">@Model.AnalysisCompletedCount</a></strong>
        <small>@Model.AnalysisCompletionRatePercent.ToString("0.#")% completion rate</small>
    </div>
    <div class="pi-metric">
        <span>Attention Required</span>
        <strong><a asp-controller="Requests" asp-action="Index" asp-all-route-data="@(Model.Filters.ToRouteValues(new() { ["AttentionRequired"] = "true" }))">@Model.AttentionRequiredCount</a></strong>
        <small>manual review or processing errors</small>
    </div>
</div>

<div class="pi-metric-grid">
    <div class="pi-metric">
        <span>High Priority Requests</span>
        <strong><a asp-controller="Requests" asp-action="Index" asp-all-route-data="@(Model.Filters.ToRouteValues(new() { ["Priority"] = "High" }))">@Model.HighPriorityRequestCount</a></strong>
    </div>
    <div class="pi-metric">
        <span>Critical Findings</span>
        <strong>@Model.CriticalFindingsCount</strong>
        <small>@Model.CriticalFindingsCompanyCount compan@(Model.CriticalFindingsCompanyCount == 1 ? "y" : "ies") affected</small>
    </div>
    <div class="pi-metric">
        <span>Review Findings</span>
        <strong>@Model.ReviewFindingsCount</strong>
        <small>@Model.ReviewFindingsCompanyCount compan@(Model.ReviewFindingsCompanyCount == 1 ? "y" : "ies") affected</small>
    </div>
    <div class="pi-metric">
        <span>Positive / Stable</span>
        <strong>@Model.PositiveFindingsCount</strong>
    </div>
</div>

<p class="text-muted mb-4"><em>Cards can overlap — a request can be analysis-complete while document processing or manual review is still outstanding.</em></p>

<div class="row g-3 mb-4">
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">Requests Created</div>
            <div class="card-body">
                @if (trendSeries is null) { <p class="text-muted mb-0">No data for the selected filters.</p> }
                else { @await Html.PartialAsync("_Sparkline", trendSeries, new ViewDataDictionary(ViewData) { ["Width"] = 640d, ["Height"] = 140d, ["ExtraClass"] = "mca-sparkline--wide" }) }
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Review Priority Distribution</div>
            <div class="card-body">
                @if (prioritySeries is null) { <p class="text-muted mb-0">No data for the selected filters.</p> }
                else { @await Html.PartialAsync("_HorizontalBars", prioritySeries) }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header">Findings by Risk Category</div>
            <div class="card-body">
                @if (findingsSeries is null) { <p class="text-muted mb-0">No data for the selected filters.</p> }
                else { @await Html.PartialAsync("_StackedBars", findingsSeries) }
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Top Risk Indicators</div>
            <div class="card-body p-0">
                @if (Model.TopRiskIndicators.Count == 0) { <p class="text-muted m-3 mb-0">No data for the selected filters.</p> }
                else
                {
                    <table class="pi-results-table">
                        <thead><tr><th>Finding</th><th class="text-end">Companies</th><th class="text-end">Findings</th></tr></thead>
                        <tbody>
                        @foreach (var indicator in Model.TopRiskIndicators)
                        {
                            <tr>
                                <td><a asp-controller="Requests" asp-action="Index" asp-all-route-data="@(Model.Filters.ToRouteValues(new() { ["Code"] = indicator.Code }))">@indicator.Title</a></td>
                                <td class="text-end">@indicator.CompaniesAffected</td>
                                <td class="text-end">@indicator.FindingCount</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Priority Requests</div>
    <div class="card-body p-0">
        @if (Model.PriorityRequests.Count == 0) { <p class="text-muted m-3 mb-0">No data for the selected filters.</p> }
        else
        {
            <table class="pi-results-table">
                <thead>
                    <tr><th>Company</th><th>Client</th><th>Review Priority</th><th>Attention</th><th>Key Finding</th><th>Status</th><th>Updated</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var row in Model.PriorityRequests)
                {
                    <tr>
                        <td>@row.Request.CompanyName</td>
                        <td>@row.Request.Client?.ClientName</td>
                        <td>
                            @if (row.Priority is { } p) { <span class="pi-status-pill @PriorityPill(p)">@p</span> }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>
                            @foreach (var reason in row.AttentionReasons) { <span class="pi-status-pill pi-status-processing me-1">@reason</span> }
                        </td>
                        <td>@row.KeyFindingTitle</td>
                        <td>@row.Request.RequestStatus</td>
                        <td>@(row.Request.UpdatedDate?.ToString("d MMM yyyy") ?? row.Request.CreatedDate.ToString("d MMM yyyy"))</td>
                        <td><a asp-controller="Requests" asp-action="Details" asp-route-id="@row.Request.RequestId" class="btn btn-sm btn-outline-primary">View</a></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

