@model RegistryAggregateData
@using MCAROC_Analysis.Models.Registry

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header fw-bold">Company Class</div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        @foreach (var c in Model.CompanyClasses)
                        {
                            <tr>
                                <td>@c.Label</td>
                                <td class="text-end fw-semibold">@c.Count.ToString("N0")</td>
                                <td class="text-end text-muted small">@c.Percent.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header fw-bold">Listing Status</div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        @foreach (var l in Model.ListingStatusSplit)
                        {
                            <tr>
                                <td>@l.Label</td>
                                <td class="text-end fw-semibold">@l.Count.ToString("N0")</td>
                                <td class="text-end text-muted small">@l.Percent.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header fw-bold">Authorized Capital Tiers</div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        @foreach (var cap in Model.CapitalDistribution)
                        {
                            <tr>
                                <td>@cap.Range</td>
                                <td class="text-end fw-semibold">@cap.Count.ToString("N0")</td>
                                <td class="text-end text-muted small">@cap.Percent.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

