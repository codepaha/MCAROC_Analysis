@model RegistryAggregateData
@using MCAROC_Analysis.Models.Registry

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold">Top 10 States &bull; Companies</div>
            <div class="card-body">
                @if (Model.TopStatesChart != null)
                {
                    @await Html.PartialAsync("~/Views/Registry/_RegistryHorizontalBars.cshtml", Model.TopStatesChart)
                }
                else
                {
                    <p class="text-muted mb-0 small">No state data available.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold">Top 10 Industries &bull; Companies</div>
            <div class="card-body">
                @if (Model.TopIndustriesChart != null)
                {
                    @await Html.PartialAsync("~/Views/Registry/_RegistryHorizontalBars.cshtml", Model.TopIndustriesChart)
                }
                else
                {
                    <p class="text-muted mb-0 small">No industry data available.</p>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.CompanyRegistrationYearSeries != null)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-bold">Annual Incorporations (2000 &ndash; Present)</div>
                <div class="text-muted small">Based on official RegistrationDate. Reflects entity entry dates, not status transitions or historical strike-off timing.</div>
            </div>
        </div>
        <div class="card-body">
            @await Html.PartialAsync("_Sparkline", Model.CompanyRegistrationYearSeries, new ViewDataDictionary(ViewData) { ["Width"] = 720d, ["Height"] = 120d, ["ExtraClass"] = "mca-sparkline--wide" })
        </div>
    </div>
}

@await Html.PartialAsync("~/Views/Registry/_CompanyDistributions.cshtml", Model)
