@model (RegistryStatusMetrics Metrics, string Title, string Description)
@using MCAROC_Analysis.Models.Registry

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <div class="fw-bold">@Model.Title</div>
            <div class="text-muted small">@Model.Description</div>
        </div>
        <span class="badge bg-secondary">Total: @Model.Metrics.Total.ToString("N0")</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3 col-sm-6">
                <div class="p-3 border rounded text-center">
                    <div class="text-success fw-bold h4 mb-0">@Model.Metrics.Active.ToString("N0")</div>
                    <div class="small text-muted">Active</div>
                    <div class="small fw-semibold text-success">@Model.Metrics.ActivePercent.ToString("F1")%</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 border rounded text-center">
                    <div class="text-warning fw-bold h4 mb-0">@Model.Metrics.StrikeOff.ToString("N0")</div>
                    <div class="small text-muted">Strike Off / Closed</div>
                    <div class="small fw-semibold text-warning">@Model.Metrics.StrikeOffPercent.ToString("F1")%</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 border rounded text-center">
                    @if (Model.Metrics.HasObservedCirp || Model.Metrics.HasObservedLiquidation)
                    {
                        <div class="text-danger fw-bold h4 mb-0">@((Model.Metrics.UnderCirp + Model.Metrics.UnderLiquidation).ToString("N0"))</div>
                        <div class="small text-muted">Distressed (CIRP/Liq)</div>
                        <div class="small fw-semibold text-danger">@((Model.Metrics.CirpPercent + Model.Metrics.LiquidationPercent).ToString("F1"))%</div>
                    }
                    else
                    {
                        <div class="text-muted fw-bold h4 mb-0">&mdash;</div>
                        <div class="small text-muted">Distressed (CIRP/Liq)</div>
                        <div class="small text-muted">Unavailable</div>
                    }
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 border rounded text-center">
                    <div class="text-secondary fw-bold h4 mb-0">@Model.Metrics.OtherUnclassified.ToString("N0")</div>
                    <div class="small text-muted">Other / Unclassified</div>
                    <div class="small fw-semibold text-secondary">@Model.Metrics.OtherPercent.ToString("F1")%</div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <div class="progress" style="height: 12px;" role="progressbar" aria-label="Status Distribution">
                <div class="progress-bar bg-success" style="width: @Model.Metrics.ActivePercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%" title="Active: @Model.Metrics.Active.ToString("N0")"></div>
                <div class="progress-bar bg-warning" style="width: @Model.Metrics.StrikeOffPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%" title="Strike Off: @Model.Metrics.StrikeOff.ToString("N0")"></div>
                @if (Model.Metrics.HasObservedCirp || Model.Metrics.HasObservedLiquidation)
                {
                    <div class="progress-bar bg-danger" style="width: @((Model.Metrics.CirpPercent + Model.Metrics.LiquidationPercent).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%" title="Distressed: @((Model.Metrics.UnderCirp + Model.Metrics.UnderLiquidation).ToString("N0"))"></div>
                }
                <div class="progress-bar bg-secondary" style="width: @Model.Metrics.OtherPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%" title="Other: @Model.Metrics.OtherUnclassified.ToString("N0")"></div>
            </div>
            <div class="d-flex justify-content-between text-muted small mt-1">
                <span><span class="badge bg-success">&nbsp;</span> Active (@Model.Metrics.ActivePercent.ToString("F1")%)</span>
                <span><span class="badge bg-warning">&nbsp;</span> Strike Off (@Model.Metrics.StrikeOffPercent.ToString("F1")%)</span>
                @if (Model.Metrics.HasObservedCirp || Model.Metrics.HasObservedLiquidation)
                {
                    <span><span class="badge bg-danger">&nbsp;</span> CIRP/Liq (@((Model.Metrics.CirpPercent + Model.Metrics.LiquidationPercent).ToString("F1"))%)</span>
                }
                <span><span class="badge bg-secondary">&nbsp;</span> Other (@Model.Metrics.OtherPercent.ToString("F1")%)</span>
            </div>
        </div>
    </div>
</div>

