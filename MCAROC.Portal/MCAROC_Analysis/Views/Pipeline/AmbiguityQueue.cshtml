@model MCAROC_Analysis.Models.AmbiguityQueueViewModel
@{
    ViewData["Title"] = "Identity Ambiguity Queue";
    string ReasonClass(string code) => code switch
    {
        "RESOLVED_AUTO_SELECTED" or "RESOLVED_HUMAN_SELECTED" or "RESOLVED_USER_PROVIDED_CIN" => "text-bg-success",
        "IDENTITY_NEEDS_CONFIRMATION" => "text-bg-warning",
        "IDENTITY_AMBIGUOUS" => "text-bg-danger",
        "IDENTITY_NOT_FOUND" => "text-bg-secondary",
        "IDENTITY_FALSE_ACCEPT" => "text-bg-danger",
        "DUPLICATE_REQUEST" => "text-bg-warning",
        _ => "text-bg-danger"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <div class="pi-kicker">Pipeline Coordinator</div>
        <h1 class="h4 mb-0">Identity Ambiguity Queue</h1>
        <div class="text-muted">
            Requests whose company identity could not be automatically determined or requires human confirmation.
            Review ranked candidates and click <strong>Select this CIN</strong> to unblock the pipeline.
        </div>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Pipeline</a>
    </div>
</div>

@if (TempData["PipelineOk"] is string okMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@okMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["PipelineError"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="alert alert-light border p-4 text-center">
        <i class="bi bi-check2-circle text-success fs-1 d-block mb-2"></i>
        <h5 class="fw-semibold">No ambiguous identities pending review</h5>
        <p class="text-muted mb-0">All requests in the pipeline have either been identified or do not require attention at this time.</p>
    </div>
    return;
}

<div class="d-flex flex-column gap-4">
    @foreach (var item in Model.Items)
    {
        <div class="card shadow-sm border" id="req-@item.RequestId">
            <div class="card-header bg-light py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Requests" asp-action="Details" asp-route-id="@item.RequestId" class="fw-bold fs-6">
                        @item.RequestNumber
                    </a>
                    @if (!string.IsNullOrEmpty(item.ClientName))
                    {
                        <span class="badge text-bg-light border text-muted">@item.ClientName</span>
                    }
                    <span class="badge @ReasonClass(item.ReasonCode)">@item.ReasonCode</span>
                </div>
                <div class="small text-muted">
                    Updated @Ist.Format(item.UpdatedUtc, "d MMM HH:mm")
                </div>
            </div>

            <div class="card-body p-3">
                <div class="row mb-3">
                    <div class="col-md-7">
                        <div class="small text-muted">Input Target Name</div>
                        <div class="fw-semibold fs-5 text-dark">@(string.IsNullOrWhiteSpace(item.InputName) ? "(None provided)" : item.InputName)</div>
                        @if (!string.IsNullOrWhiteSpace(item.CurrentCin))
                        {
                            <div class="small text-muted mt-1">
                                Current Request Identifier: <span class="font-monospace fw-semibold">@item.CurrentCin</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(item.ReasonDetail))
                        {
                            <div class="small text-danger mt-1">
                                <i class="bi bi-info-circle me-1"></i>@item.ReasonDetail
                            </div>
                        }
                    </div>
                    <div class="col-md-5">
                        <div class="small text-muted">Supplied Hints</div>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @if (!string.IsNullOrEmpty(item.Hints.State))
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">State: @item.Hints.State</span>
                            }
                            @if (!string.IsNullOrEmpty(item.Hints.District))
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">District: @item.Hints.District</span>
                            }
                            @if (!string.IsNullOrEmpty(item.Hints.PinCode))
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">PIN: @item.Hints.PinCode</span>
                            }
                            @if (item.Hints.IncorporationYear.HasValue)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">Year: @item.Hints.IncorporationYear</span>
                            }
                            @if (item.Hints.EntityType.HasValue)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">Type: @item.Hints.EntityType</span>
                            }
                            @if (string.IsNullOrEmpty(item.Hints.State) && string.IsNullOrEmpty(item.Hints.District) && string.IsNullOrEmpty(item.Hints.PinCode) && !item.Hints.IncorporationYear.HasValue)
                            {
                                <span class="small text-muted fst-italic">No hints supplied</span>
                            }
                        </div>
                    </div>
                </div>

                <h6 class="fw-semibold mb-2" style="font-size:14px;">
                    Ranked Candidates (@item.Candidates.Count)
                </h6>

                @if (item.Candidates.Count == 0)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>No candidates retrieved from master data. You may specify the CIN or LLPIN manually below.
                    </div>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-hover align-middle mb-0" style="font-size:13px;">
                            <thead class="table-light">
                                <tr>
                                    <th>CIN / LLPIN</th>
                                    <th>Master Company Name</th>
                                    <th>Status</th>
                                    <th>State &amp; District</th>
                                    <th>Inc Date</th>
                                    <th>Match Score</th>
                                    <th>Reasons</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in item.Candidates)
                                {
                                    <tr class="@(c.IsRecommended ? "table-primary-subtle" : "")">
                                        <td class="font-monospace fw-semibold">
                                            @c.Identifier
                                            @if (c.ToolOnly)
                                            {
                                                <span class="badge text-bg-warning ms-1" title="Candidate was retrieved from the live reference tool, not local master">Tool Only</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@c.Name</div>
                                            @if (c.IsRecommended)
                                            {
                                                <span class="badge text-bg-primary">Recommended</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(string.Equals(c.Status, "Active", StringComparison.OrdinalIgnoreCase) ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border")">
                                                @(c.Status ?? "Unknown")
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(c.District) || !string.IsNullOrEmpty(c.State))
                                            {
                                                <span>@c.District@(string.IsNullOrEmpty(c.District) || string.IsNullOrEmpty(c.State) ? "" : ", ")@c.State</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @(c.RegistrationDate?.ToString("yyyy-MM-dd") ?? "—")
                                        </td>
                                        <td>
                                            <span class="badge @(c.MatchPercent >= 90 ? "text-bg-success" : (c.MatchPercent >= 70 ? "text-bg-primary" : "text-bg-warning"))">
                                                @c.MatchPercent%
                                            </span>
                                        </td>
                                        <td>
                                            <div class="small text-muted">
                                                @string.Join(" · ", c.Reasons)
                                            </div>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <form method="post" asp-action="SelectCin" class="d-inline">
                                                <input type="hidden" name="requestId" value="@item.RequestId" />
                                                <input type="hidden" name="identifier" value="@c.Identifier" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="btn btn-sm @(c.IsRecommended ? "btn-primary" : "btn-outline-primary")">
                                                    <i class="bi bi-check2 me-1"></i>Select this CIN
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="border-top pt-2 mt-2">
                    <form method="post" asp-action="SelectCin" class="row g-2 align-items-center">
                        <input type="hidden" name="requestId" value="@item.RequestId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <div class="col-auto">
                            <label class="col-form-label col-form-label-sm text-muted">Or enter identifier manually:</label>
                        </div>
                        <div class="col-auto">
                            <input type="text" name="identifier" class="form-control form-control-sm font-monospace" placeholder="CIN or LLPIN" style="width:16rem" required />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-check-circle me-1"></i>Select this CIN
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
