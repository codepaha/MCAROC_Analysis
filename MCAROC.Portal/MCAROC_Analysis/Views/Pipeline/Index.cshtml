@model MCAROC_Analysis.Models.PipelineBoardViewModel
@using MCAROC_Analysis.Data.Entities
@{
    ViewData["Title"] = "Pipeline";
    string StateClass(string state) => state switch
    {
        "Succeeded" => "text-bg-success",
        "SucceededWithWarnings" => "text-bg-warning",
        "Running" => "text-bg-primary",
        "RetryScheduled" => "text-bg-info",
        "NeedsAttention" => "text-bg-danger",
        "Cancelled" => "text-bg-dark",
        "Skipped" => "bg-body-secondary text-body-secondary border",
        _ => "bg-body-tertiary text-body-secondary border"
    };
    string OutcomeClass(PipelineOutcome o) => o switch
    {
        PipelineOutcome.Complete => "text-bg-success",
        PipelineOutcome.CompleteWithWarnings => "text-bg-warning",
        PipelineOutcome.CoreReady => "text-bg-info",
        PipelineOutcome.NeedsAttention => "text-bg-danger",
        PipelineOutcome.Cancelled => "text-bg-dark",
        _ => "text-bg-primary"
    };

    string FormatAge(DateTime createdUtc)
    {
        var span = DateTime.UtcNow - createdUtc;
        if (span.TotalDays >= 2) return $"{(int)span.TotalDays}d ago";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m ago";
        if (span.TotalMinutes >= 1) return $"{(int)span.TotalMinutes}m ago";
        return "just now";
    }

    string StageDeepLink(long requestId, string? stage) => stage switch
    {
        "Resolve" => $"/Pipeline/AmbiguityQueue?requestId={requestId}",
        "Unlock" => $"/Requests/{requestId}#tab-autofetch",
        "Fetch" => $"/Requests/{requestId}#tab-autofetch",
        "Litigation" => $"/Requests/{requestId}#tab-litigation",
        "LitigationAnalysis" => $"/Requests/{requestId}#tab-litigation",
        "Ingest" => $"/Requests/{requestId}#tab-sources",
        "Dossier" => $"/Requests/{requestId}#tab-dossier",
        _ => $"/Requests/{requestId}"
    };

    bool IsCoreStage(string stage) =>
        stage is "Resolve" or "Unlock" or "Refresh" or "Fetch" or "Ingest" or "Analysis" or "CalcAssurance" or "Dossier";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 mb-0">Pipeline</h1>
        <div class="text-muted">
            Every request's stages, end to end.
            @if (Model.Mode == "Enforce")
            {
                <text>The coordinator acts on its own where it is allowed to (litigation search); open a request to see each step it took.</text>
            }
            else
            {
                <text>The coordinator observes and records; it doesn't act.</text>
            }
        </div>
    </div>
</div>

@if (TempData["PipelineOk"] is string okMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@okMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["PipelineError"] is string errMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@errMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.CoordinatorEnabled)
{
    <div class="alert alert-secondary">
        The coordinator is switched off (<code>Pipeline:Enabled</code> is false), so no new runs are being recorded.
        Anything below is from when it was last on.
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(Model.Outcome is null ? "btn-dark" : "btn-outline-secondary")" href="/Pipeline">All</a>
    @foreach (var o in Enum.GetValues<PipelineOutcome>())
    {
        var n = Model.Counts.GetValueOrDefault(o);
        <a class="btn btn-sm @(Model.Outcome == o ? "btn-dark" : "btn-outline-secondary")" href="/Pipeline?outcome=@o">@o <span class="badge text-bg-light ms-1">@n</span></a>
    }
    <div class="vr mx-1"></div>
    <a class="btn btn-sm btn-outline-danger" asp-action="AmbiguityQueue">
        <i class="bi bi-question-diamond me-1"></i>Ambiguity Queue
        @if (Model.AmbiguityCount > 0)
        {
            <span class="badge text-bg-danger ms-1">@Model.AmbiguityCount</span>
        }
    </a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    @if (Model.Outcome is { } selected)
    {
        <input type="hidden" name="outcome" value="@selected" />
    }
    <div class="col-auto">
        <label class="form-label small text-muted mb-1" for="stuckMinutes">No stage change for (minutes)</label>
        <input class="form-control form-control-sm" type="number" min="1" id="stuckMinutes" name="stuckMinutes" value="@Model.StuckMinutes" style="width:9rem" />
    </div>
    <div class="col-auto">
        <label class="form-label small text-muted mb-1" for="reasonCode">Reason code</label>
        <input class="form-control form-control-sm" id="reasonCode" name="reasonCode" value="@Model.ReasonCode" placeholder="e.g. FETCH_FAILED" style="width:14rem" />
    </div>
    <div class="col-auto">
        <button class="btn btn-sm btn-primary" type="submit">Filter</button>
        <a class="btn btn-sm btn-link" href="/Pipeline">Clear</a>
    </div>
</form>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-light border">No pipeline runs match.</div>
    return;
}

<div class="pi-panel p-0">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Request</th>
                    <th>Outcome</th>
                    <th>Stages</th>
                    <th class="text-nowrap">Last change</th>
                    <th class="text-end" style="min-width:7rem">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    var attention = r.Stages.Where(s => s.State == "NeedsAttention").ToList();
                    <tr>
                        <td style="min-width:14rem">
                            <a asp-controller="Requests" asp-action="Details" asp-route-id="@r.RequestId" class="fw-semibold">@r.RequestNumber</a>
                            <div class="small text-muted">@r.CompanyName &middot; @r.Trigger</div>
                            @if (!string.IsNullOrWhiteSpace(r.ClientName))
                            {
                                <div class="small text-secondary"><i class="bi bi-building me-1"></i>@r.ClientName</div>
                            }
                        </td>
                        <td>
                            <span class="badge @OutcomeClass(r.Outcome)">@r.Outcome</span>
                            <div class="small text-muted" title="Created @Ist.Format(r.CreatedUtc)">Age: @FormatAge(r.CreatedUtc)</div>
                            @if (r.CoreReadyUtc is { } ready)
                            {
                                <div class="small text-muted">dossier ready @Ist.Format(ready, "d MMM HH:mm")</div>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var s in r.Stages)
                                {
                                    <span class="badge @StateClass(s.State)" title="@s.State@(s.ReasonCode is null ? "" : " · " + s.ReasonCode)@(s.ReasonDetail is null ? "" : " — " + s.ReasonDetail)">@s.Stage</span>
                                }
                            </div>
                            @foreach (var a in attention)
                            {
                                <div class="card bg-danger-subtle border-danger-subtle p-2 mt-2">
                                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                        <div>
                                            <span class="badge bg-danger">@a.Stage</span>
                                            <span class="fw-semibold text-danger ms-1">@a.ReasonCode</span>
                                            @if (!string.IsNullOrWhiteSpace(a.ReasonDetail))
                                            {
                                                <div class="small text-danger-emphasis mt-1">@a.ReasonDetail</div>
                                            }
                                        </div>
                                        <div class="d-flex gap-1 text-nowrap mt-1 mt-sm-0">
                                            @if (a.Stage == "Resolve")
                                            {
                                                <a asp-action="AmbiguityQueue" asp-route-requestId="@r.RequestId" class="btn btn-xs btn-outline-danger py-0 px-2" style="font-size:12px;">
                                                    <i class="bi bi-question-diamond me-1"></i>Resolve
                                                </a>
                                            }
                                            <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2" style="font-size:12px;"
                                                    data-bs-toggle="modal" data-bs-target="#retryStageModal"
                                                    data-run-id="@r.PipelineRunId" data-stage="@a.Stage" data-request-id="@r.RequestId">
                                                <i class="bi bi-arrow-repeat me-1"></i>Retry
                                            </button>
                                            @if (!IsCoreStage(a.Stage))
                                            {
                                                <button type="button" class="btn btn-xs btn-outline-warning py-0 px-2 text-dark" style="font-size:12px;"
                                                        data-bs-toggle="modal" data-bs-target="#skipStageModal"
                                                        data-run-id="@r.PipelineRunId" data-stage="@a.Stage" data-request-id="@r.RequestId">
                                                    <i class="bi bi-skip-forward me-1"></i>Skip
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 disabled opacity-50" style="font-size:12px;"
                                                        title="Core stages cannot be skipped" disabled>
                                                    <i class="bi bi-slash-circle me-1"></i>Skip
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </td>
                        <td class="small text-nowrap">@Ist.Format(r.LastChangeUtc, "d MMM HH:mm")</td>
                        <td class="text-end text-nowrap">
                            <a href="@StageDeepLink(r.RequestId, attention.FirstOrDefault()?.Stage)" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:12px;" title="Open stage resolution flow">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Open
                            </a>
                            @if (r.Outcome != PipelineOutcome.Cancelled && r.Outcome != PipelineOutcome.Complete)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size:12px;"
                                        data-bs-toggle="modal" data-bs-target="#cancelPipelineModal"
                                        data-run-id="@r.PipelineRunId" data-request-id="@r.RequestId" data-request-number="@r.RequestNumber"
                                        title="Cancel pipeline run">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Retry Stage Modal -->
<div class="modal fade" id="retryStageModal" tabindex="-1" aria-labelledby="retryStageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="retryStageForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" value="" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title h6" id="retryStageModalLabel">
                        <i class="bi bi-arrow-repeat text-primary me-1"></i>Retry Stage: <span data-modal-stage class="fw-bold"></span> (<span data-modal-run-id class="text-muted"></span>)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Re-executes this stage, resets failure state, and triggers pipeline reconciliation.</p>
                    <div class="mb-3">
                        <label for="retryReasonInput" class="form-label small fw-semibold">Reason for retry <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm" id="retryReasonInput" name="reason" rows="3" required placeholder="Describe why this stage is being retried..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Retry Stage</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Skip Stage Modal -->
<div class="modal fade" id="skipStageModal" tabindex="-1" aria-labelledby="skipStageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="skipStageForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" value="" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title h6" id="skipStageModalLabel">
                        <i class="bi bi-skip-forward text-warning me-1"></i>Skip Stage: <span data-modal-stage class="fw-bold"></span> (<span data-modal-run-id class="text-muted"></span>)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning py-2 px-3 small mb-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Skipping this enrichment stage will mark it as <code>Skipped (Warning)</code> with code <code>MANUAL_SKIP</code> and unblock downstream completion. Core stages cannot be skipped.
                    </div>
                    <div class="mb-3">
                        <label for="skipReasonInput" class="form-label small fw-semibold">Reason for skip <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm" id="skipReasonInput" name="reason" rows="3" required placeholder="Describe why this enrichment stage can be safely skipped..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-warning">Skip Stage</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Cancel Pipeline Modal -->
<div class="modal fade" id="cancelPipelineModal" tabindex="-1" aria-labelledby="cancelPipelineModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="cancelPipelineForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" value="" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title h6" id="cancelPipelineModalLabel">
                        <i class="bi bi-x-circle text-danger me-1"></i>Cancel Pipeline: <span data-modal-request class="fw-bold"></span> (<span data-modal-run-id class="text-muted"></span>)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger py-2 px-3 small mb-3">
                        <i class="bi bi-exclamation-octagon me-1"></i>
                        Cancelling this pipeline run will mark the request and run outcome as <code>Cancelled</code> and terminate all active stages. This action is irreversible.
                    </div>
                    <div class="mb-3">
                        <label for="cancelReasonInput" class="form-label small fw-semibold">Reason for cancellation <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm" id="cancelReasonInput" name="reason" rows="3" required placeholder="Describe why this pipeline run is being cancelled..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-sm btn-danger">Cancel Pipeline</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var retryModal = document.getElementById('retryStageModal');
        if (retryModal) {
            retryModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var runId = button.getAttribute('data-run-id');
                var stage = button.getAttribute('data-stage');
                var requestId = button.getAttribute('data-request-id');
                var form = document.getElementById('retryStageForm');
                form.action = '/Pipeline/Runs/' + runId + '/Stages/' + stage + '/Retry';
                retryModal.querySelectorAll('[data-modal-stage]').forEach(function (el) { el.textContent = stage; });
                retryModal.querySelectorAll('[data-modal-run-id]').forEach(function (el) { el.textContent = 'Run #' + runId; });
                form.querySelector('input[name="requestId"]').value = requestId;
                var reason = form.querySelector('textarea[name="reason"]');
                if (reason) reason.value = '';
            });
        }

        var skipModal = document.getElementById('skipStageModal');
        if (skipModal) {
            skipModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var runId = button.getAttribute('data-run-id');
                var stage = button.getAttribute('data-stage');
                var requestId = button.getAttribute('data-request-id');
                var form = document.getElementById('skipStageForm');
                form.action = '/Pipeline/Runs/' + runId + '/Stages/' + stage + '/Skip';
                skipModal.querySelectorAll('[data-modal-stage]').forEach(function (el) { el.textContent = stage; });
                skipModal.querySelectorAll('[data-modal-run-id]').forEach(function (el) { el.textContent = 'Run #' + runId; });
                form.querySelector('input[name="requestId"]').value = requestId;
                var reason = form.querySelector('textarea[name="reason"]');
                if (reason) reason.value = '';
            });
        }

        var cancelModal = document.getElementById('cancelPipelineModal');
        if (cancelModal) {
            cancelModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var runId = button.getAttribute('data-run-id');
                var reqNum = button.getAttribute('data-request-number');
                var requestId = button.getAttribute('data-request-id');
                var form = document.getElementById('cancelPipelineForm');
                form.action = '/Pipeline/Runs/' + runId + '/Cancel';
                cancelModal.querySelectorAll('[data-modal-request]').forEach(function (el) { el.textContent = reqNum; });
                cancelModal.querySelectorAll('[data-modal-run-id]').forEach(function (el) { el.textContent = 'Run #' + runId; });
                form.querySelector('input[name="requestId"]').value = requestId;
                var reason = form.querySelector('textarea[name="reason"]');
                if (reason) reason.value = '';
            });
        }
    });
</script>
}
