@model AutoFetchRequestViewModel
@{
    ViewData["Title"] = "New Auto-fetch Search";
}

<div class="pi-page-head">
    <div>
        <div class="pi-kicker">New Request</div>
        <h1>New Auto-fetch Search</h1>
        <p>Enter a CIN or LLPIN and the portal fetches the MCA / ROC report, the detailed charge report and every filing PDF from the reference tool, then runs extraction, analysis and document indexing automatically. Prefer to upload the files yourself? Use <a asp-controller="Requests" asp-action="New">New Search</a>.</p>
    </div>
</div>

@if (!Model.IsConfigured)
{
    <div class="alert alert-warning">
        <strong>Auto-fetch is not configured on this server.</strong>
        Set <code>ReferenceTool:BaseUrl</code> and <code>ReferenceTool:SessionCookie</code> (user-secrets locally, environment variables elsewhere — see README, “Configuring secrets”). Until then, use <a asp-controller="Requests" asp-action="New">New Search</a> to upload the files manually.
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.ExistingRequestId is long existingRequestId)
{
    <div class="alert alert-info">
        <strong>This company is already available for the selected client.</strong>
        Request <a asp-controller="Requests" asp-action="Details" asp-route-id="@existingRequestId">@Model.ExistingRequestNumber</a>
        is currently @Model.ExistingRequestStatus. Open it to review progress, results, or retry a failed fetch.
    </div>
}

<div class="pi-panel" style="padding:24px;max-width:760px;">
    <form asp-controller="AutoFetch" asp-action="New" method="post" autocomplete="off">
        <div class="mb-3">
            <label asp-for="ClientId" class="form-label"></label>
            <select asp-for="ClientId" class="form-select" asp-items="@(new SelectList(Model.Clients, nameof(Client.ClientId), nameof(Client.ClientName)))">
                <option value="">Select Client</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Entity Type</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="EntityType" value="Company" id="entityCompany" />
                <label class="form-check-label" for="entityCompany">Company</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="EntityType" value="LLP" id="entityLlp" />
                <label class="form-check-label" for="entityLlp">LLP</label>
            </div>
        </div>

        <input type="hidden" asp-for="SelectedIdentifier" id="afSelectedIdentifier" />

        <div class="mb-3 position-relative">
            <label asp-for="CompanyName" class="form-label">Company / LLP Name</label>
            <input asp-for="CompanyName" class="form-control" id="afName" placeholder="Type company name to search" data-search-url="/Requests/AutoFetch/search" />
            <div class="form-text">Type a name or CIN — ranked suggestions appear below with match score, location, and status.</div>
            <ul class="list-group position-absolute w-100 shadow-sm" id="afHints" hidden style="z-index:20;max-height:360px;overflow:auto;"></ul>
        </div>

        <div class="mb-3 position-relative">
            <label asp-for="Cin" class="form-label">CIN / LLPIN (Optional if Company Name is provided)</label>
            <input asp-for="Cin" class="form-control" id="afCin" placeholder="e.g. U24246DL2003PTC118255 or AAA-1234" data-search-url="/Requests/AutoFetch/search" />
            <div class="form-text">Optional if name is given above. If you know the exact CIN or LLPIN, provide it here.</div>
        </div>

        <details class="mb-3 border rounded p-3 bg-light">
            <summary class="fw-semibold text-primary" style="cursor:pointer">
                <i class="bi bi-sliders me-1"></i> Disambiguation Hints (Optional)
            </summary>
            <div class="row g-2 mt-2">
                <div class="col-md-6">
                    <label asp-for="State" class="form-label small"></label>
                    <input asp-for="State" class="form-control form-control-sm" id="afHintState" placeholder="e.g. Maharashtra" />
                </div>
                <div class="col-md-6">
                    <label asp-for="District" class="form-label small"></label>
                    <input asp-for="District" class="form-control form-control-sm" id="afHintDistrict" placeholder="e.g. Mumbai" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PinCode" class="form-label small"></label>
                    <input asp-for="PinCode" class="form-control form-control-sm" id="afHintPin" placeholder="e.g. 400001" />
                </div>
                <div class="col-md-6">
                    <label asp-for="IncorporationYear" class="form-label small"></label>
                    <input asp-for="IncorporationYear" class="form-control form-control-sm" id="afHintYear" type="number" min="1800" max="2100" placeholder="e.g. 2005" />
                </div>
            </div>
            <div class="form-text mt-1">If the company name is common, these hints help identify the exact entity.</div>
        </details>

        <div class="mb-3">
            <label asp-for="Pan" class="form-label"></label>
            <input asp-for="Pan" class="form-control" id="afPan" placeholder="AABCV6369H" />
            <div class="form-text">Optional. If given, it is checked against the extracted workbook.</div>
        </div>

        <hr />
        <h3 style="font-size:15px;font-weight:600;margin-bottom:14px;">Filing documents</h3>

        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" asp-for="IncludeFilings" id="afIncludeFilings" />
            <label class="form-check-label" asp-for="IncludeFilings"></label>
            <div class="form-text">Every filing PDF in the tool's four document sections (financial, charge, incorporation, scanned) is downloaded one file at a time, packaged and pushed through OCR, extraction and “Ask Documents” indexing. Large companies have thousands of PDFs — this runs in the background and the request page shows progress.</div>
        </div>

        <div class="mb-3" style="max-width:280px;">
            <label asp-for="MaxDocumentsPerSection" class="form-label"></label>
            <input asp-for="MaxDocumentsPerSection" class="form-control" type="number" min="0" placeholder="All" />
            <div class="form-text">Blank or 0 = all. Documents are taken newest first.</div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary" @(Model.IsConfigured ? "" : "disabled")><i class="bi bi-cloud-download me-1"></i>Fetch &amp; Analyse</button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var cin = document.getElementById('afCin');
            var name = document.getElementById('afName');
            var selectedId = document.getElementById('afSelectedIdentifier');
            var hints = document.getElementById('afHints');
            var hintState = document.getElementById('afHintState');
            var hintDistrict = document.getElementById('afHintDistrict');
            var hintPin = document.getElementById('afHintPin');
            var hintYear = document.getElementById('afHintYear');
            var url = name.dataset.searchUrl || cin.dataset.searchUrl;
            var timer = null, lastQuery = '';

            function hide() { hints.hidden = true; hints.innerHTML = ''; }

            function render(items) {
                hints.innerHTML = '';
                if (!items || items.length === 0) { hide(); return; }
                items.forEach(function (h) {
                    var li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action py-2';
                    li.style.cursor = 'pointer';

                    var topRow = document.createElement('div');
                    topRow.className = 'd-flex justify-content-between align-items-center gap-2';

                    var strong = document.createElement('strong');
                    strong.className = 'text-truncate';
                    strong.textContent = h.name || h.legalName || h.Name || h.LegalName || '';
                    topRow.appendChild(strong);

                    var badgeGroup = document.createElement('div');
                    badgeGroup.className = 'd-flex gap-1 align-items-center flex-shrink-0';

                    var score = h.matchPercent ?? (h.MatchPercent || (h.score ? Math.round(h.score * 100) : null));
                    if (score !== null && score !== undefined) {
                        var scoreBadge = document.createElement('span');
                        var bgClass = score >= 90 ? 'text-bg-success' : (score >= 70 ? 'text-bg-primary' : 'text-bg-warning');
                        scoreBadge.className = 'badge ' + bgClass;
                        scoreBadge.textContent = score + '% match';
                        badgeGroup.appendChild(scoreBadge);
                    }

                    var status = h.status || h.Status;
                    if (status) {
                        var statusBadge = document.createElement('span');
                        statusBadge.className = 'badge ' + (status.toLowerCase() === 'active' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border');
                        statusBadge.textContent = status;
                        badgeGroup.appendChild(statusBadge);
                    }

                    topRow.appendChild(badgeGroup);
                    li.appendChild(topRow);

                    var detailsRow = document.createElement('div');
                    detailsRow.className = 'small text-muted d-flex flex-wrap gap-2 mt-1';

                    var identifier = h.identifier || h.cin || h.Identifier || h.Cin || '';
                    var idSpan = document.createElement('span');
                    idSpan.className = 'font-monospace fw-semibold';
                    idSpan.textContent = identifier;
                    detailsRow.appendChild(idSpan);

                    var loc = [];
                    if (h.district || h.District) loc.push(h.district || h.District);
                    if (h.state || h.State) loc.push(h.state || h.State);
                    if (loc.length > 0) {
                        var locSpan = document.createElement('span');
                        locSpan.textContent = '· ' + loc.join(', ');
                        detailsRow.appendChild(locSpan);
                    }

                    var regDate = h.registrationDate || h.RegistrationDate;
                    if (regDate) {
                        var regSpan = document.createElement('span');
                        regSpan.textContent = '· Inc: ' + regDate;
                        detailsRow.appendChild(regSpan);
                    }

                    li.appendChild(detailsRow);

                    var reasons = h.reasons || h.Reasons;
                    if (reasons && reasons.length > 0) {
                        var reasonsRow = document.createElement('div');
                        reasonsRow.className = 'small text-secondary mt-1';
                        reasonsRow.textContent = reasons.join(' · ');
                        li.appendChild(reasonsRow);
                    }

                    li.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        var id = identifier.toUpperCase();
                        cin.value = id;
                        name.value = h.name || h.legalName || h.Name || h.LegalName || '';
                        selectedId.value = id;

                        var isLlp = id.indexOf('-') >= 0;
                        document.getElementById(isLlp ? 'entityLlp' : 'entityCompany').checked = true;

                        if (h.state || h.State) hintState.value = h.state || h.State;
                        if (h.district || h.District) hintDistrict.value = h.district || h.District;

                        hide();
                    });
                    hints.appendChild(li);
                });
                hints.hidden = false;
            }

            function triggerSearch(q) {
                if (timer) clearTimeout(timer);
                if (q.length < 3) { hide(); return; }
                timer = setTimeout(function () {
                    lastQuery = q;
                    var reqUrl = url + '?q=' + encodeURIComponent(q);
                    if (hintState.value.trim()) reqUrl += '&state=' + encodeURIComponent(hintState.value.trim());
                    if (hintDistrict.value.trim()) reqUrl += '&district=' + encodeURIComponent(hintDistrict.value.trim());
                    if (hintPin.value.trim()) reqUrl += '&pin=' + encodeURIComponent(hintPin.value.trim());
                    if (hintYear.value.trim()) reqUrl += '&year=' + encodeURIComponent(hintYear.value.trim());

                    var isLlp = document.getElementById('entityLlp').checked;
                    reqUrl += '&entityType=' + (isLlp ? 'LLP' : 'Company');

                    fetch(reqUrl, { headers: { 'Accept': 'application/json' } })
                        .then(function (r) { return r.ok ? r.json() : []; })
                        .then(function (items) {
                            if (q === lastQuery) render(items);
                        })
                        .catch(hide);
                }, 300);
            }

            name.addEventListener('input', function () {
                selectedId.value = '';
                triggerSearch(name.value.trim());
            });

            cin.addEventListener('input', function () {
                selectedId.value = '';
                triggerSearch(cin.value.trim());
            });

            [hintState, hintDistrict, hintPin, hintYear].forEach(function (el) {
                el.addEventListener('input', function () {
                    var q = (name.value || cin.value || '').trim();
                    if (q.length >= 3) triggerSearch(q);
                });
            });

            name.addEventListener('blur', function () { setTimeout(hide, 200); });
            cin.addEventListener('blur', function () { setTimeout(hide, 200); });
            name.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
            cin.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
        })();
    </script>
}
