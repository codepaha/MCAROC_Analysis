@model RequestDetailsViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
@{
    ViewData["Title"] = Model.Request.RequestNumber;
    ViewData["CompactRequestWorkspace"] = true;
    var r = Model.Request;
    var run = Model.LatestAnalysisRun;
    var coverage = Model.SheetCoverage;

    // The lender-oriented business domains + the cross-domain Timeline synthesis view. AI Analysis is first and default.
    var tabs = new (string Label, string Id, string? Badge)[]
    {
        ("Assessment",        "ai",         null),
        ("Corporate",          "corporate",  null),
        ("Financials",         "financials", Model.FinancialYears.Count > 0 ? Model.FinancialYears.Count.ToString() : null),
        ("Charges & Security", "charges",    Model.OpenChargeCount > 0 ? Model.OpenChargeCount.ToString() : null),
        ("Compliance",         "compliance", null),
        ("Litigation",         "litigation", Model.LitigationCount > 0 ? Model.LitigationCount.ToString() : null),
        ("Timeline",           "timeline",   Model.Timeline.Count > 0 ? Model.Timeline.Count.ToString() : null),
        ("Documents",          "documents",  null),
    };
}

@* ─────────────────────────  Fixed company header + domain tabs  ───────────────────────── *@
<div class="mca-detail-head" id="mcaDetailHead"
     data-compact-workspace="true"
     data-request-id="@r.RequestId"
     data-focus-charge="@(Model.FocusChargeId?.ToString() ?? "")"
     data-focus-case="@(Model.FocusCaseId?.ToString() ?? "")">
    <div class="mca-company-head">
        <div class="mca-company-id">
            <h1>@r.CompanyName</h1>
            <div class="mca-ids">
                <span><b>@(r.EntityType == EntityType.LLP ? "LLPIN:" : "CIN:")</b> @(Model.CompanyProfile?.Cin ?? r.Cin ?? r.Llpin ?? "—")</span>
                @if (!string.IsNullOrEmpty(Model.CompanyProfile?.CompanyStatus))
                { <span>@Model.CompanyProfile.CompanyStatus</span> }
                <details class="workspace-menu company-details">
                    <summary>Company details</summary>
                    <div class="workspace-menu-panel mca-company-detail-fields">
                <span><b>PAN:</b> @(Model.CompanyProfile?.Pan ?? r.Pan ?? "—")</span>
                @if (!string.IsNullOrEmpty(Model.CompanyProfile?.CompanyStatus))
                {
                    <span><b>Status:</b> @Model.CompanyProfile.CompanyStatus</span>
                }
                @if (!string.IsNullOrEmpty(Model.CompanyProfile?.ComplianceStatus))
                {
                    <span><b>Compliance:</b> @Model.CompanyProfile.ComplianceStatus</span>
                }
                @if (!string.IsNullOrEmpty(Model.CompanyProfile?.Lei))
                {
                    <span><b>LEI:</b> @Model.CompanyProfile.Lei</span>
                }
                    </div>
                </details>
            </div>
        </div>
        <div class="mca-company-meta">
            <div class="mca-meta-controls">
                <div class="mca-pills">
                    <span class="pi-status-pill @StatusPill(r.RequestStatus)">@RequestStatusLabel(r.RequestStatus)</span>
                    @if (run?.OverallReviewPriority is { } hdrPr)
                    {
                        <span class="pi-status-pill @PriorityPill(hdrPr)">@hdrPr Priority</span>
                    }
                    @if (r.IsManualReviewRequired)
                    {
                        <span class="pi-status-pill pi-status-processing">Manual Review Required</span>
                    }
                </div>
                @if (r.RequestStatus == RequestStatus.AnalysisCompleted)
                { <a href="/Requests/@r.RequestId/dossier" class="btn btn-sm btn-primary">Download dossier</a> }
                <details class="workspace-menu">
                    <summary class="btn btn-sm btn-outline-secondary">Actions</summary>
                    <div class="workspace-menu-panel">
                <div class="mca-head-actions">
                    @if (r.RequestStatus == RequestStatus.AnalysisCompleted)
                    {

                        @* #164 internal calculation-assurance review panel — never part of the customer deliverable
                           above. Plain link, not a tab: it lives on its own page at /internal/calc-audit so this
                           page's own tab markup never has to branch on whether audit data is present. *@
                        <a href="/internal/calc-audit/@r.RequestId" class="btn btn-sm btn-outline-dark" title="Internal calculation-assurance review — ledger, deterministic checks, discrepancy workflow">
                            <i class="bi bi-shield-check"></i><span>Calculation audit</span>
                        </a>
                    }
                    @if (Model.HasFullAccess)
                    {
                        @if (r.LatestCompletedIngestionRunId is not null &&
                             !string.IsNullOrWhiteSpace(r.Cin ?? r.Llpin) &&
                             (Model.AutoFetchJob is null || Model.AutoFetchJob.IsTerminal) &&
                             r.RequestStatus is RequestStatus.AnalysisCompleted or RequestStatus.AiAnalysisFailed)
                        {
                            <form method="post" action="/Requests/@r.RequestId/recheck">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Re-check this company</button>
                            </form>
                        }
                        <a href="/internal/audit-logs/@r.RequestId" class="btn btn-sm btn-outline-secondary" title="Internal audit logs — lifecycle events, diagnostics, and mutations">
                            <i class="bi bi-journal-text"></i><span>Audit logs</span>
                        </a>
                    }
                </div>                    </div>
                </details>

            @* Crore/Lakh/₹ amount unit toggle (#123) — only this page renders any amount, so the
               control lives here, not in _Layout.cshtml. The dossier PDF above always shows Crore
               regardless of this toggle: it's a fixed generated document, not the live page. *@
            <div class="mca-unit-toggle" role="radiogroup" aria-label="Amount unit">
                <label><input type="radio" name="mca-amount-unit" value="crore" checked><span>Cr</span></label>
                <label><input type="radio" name="mca-amount-unit" value="lakh"><span>Lakh</span></label>
                <label><input type="radio" name="mca-amount-unit" value="rupee"><span>₹</span></label>
            </div>
            </div>
            <div class="mca-meta-detail">
                @if (!string.IsNullOrWhiteSpace(r.Client?.ClientName))
                {
                    <span>@r.Client.ClientName</span>
                }
                @if (Model.LatestRun?.SourceSnapshotDate is { } sourceSnapshot)
                {
                    var ageDays = Math.Max(0, (Ist.Now().Date - sourceSnapshot.Date).Days);
                    <span>Workbook source as of @sourceSnapshot.ToString("d MMM yyyy") (@ageDays day@(ageDays == 1 ? "" : "s") old)</span>
                }
                else if (Model.LatestRun is not null)
                {
                    <span>Workbook source date unknown</span>
                }
                <span>Updated @Ist.Format(r.UpdatedDate ?? r.CreatedDate)</span>
            </div>
        </div>
    </div>

    @if (Model.LatestRun is not null)
    {
        <div class="mca-coverage-strip">
            <span class="mca-coverage-item">
                <i class="bi bi-collection"></i>
                Coverage: <b>@coverage.PresentOptionalSheets / @coverage.TotalOptionalSheets</b> sheets
            </span>
            @if (coverage.AnySheetAbsent)
            {
                <details class="mca-coverage-details">
                    <summary>@coverage.AbsentSheets.Count sheets not in this upload</summary>
                    <p>@string.Join(", ", coverage.AbsentSheets)</p>
                </details>
            }
            @if (coverage.ChargeReportMissing)
            {
                <span class="mca-coverage-item mca-coverage-flag">
                    <i class="bi bi-exclamation-triangle"></i>
                    The ROC report lists charges, but the Detailed Charge Report workbook was not provided — charge detail is limited to the ROC sequence.
                    @if (HostEnv.IsDevelopment())
                    {
                        <a href="/Requests/@r.RequestId/reingest">Add the charge report</a>
                    }
                </span>
            }
        </div>
    }

</div>

    <ul class="nav mca-tabs" id="mcaTabs" role="tablist" aria-label="Assessment sections">
        @for (var i = 0; i < tabs.Length; i++)
        {
            var t = tabs[i];
            <li class="nav-item" role="presentation">
                <button class="nav-link @(i == 0 ? "active" : "")" data-bs-toggle="tab"
                        id="tab-button-@t.Id" data-bs-target="#tab-@t.Id" type="button" role="tab"
                        aria-controls="tab-@t.Id" aria-selected="@(i == 0 ? "true" : "false")" tabindex="@(i == 0 ? "0" : "-1")">
                    @t.Label
                    @if (t.Badge is { } b) { <span class="badge">@b</span> }
                </button>
            </li>
        }
    </ul>

@if (TempData["AutoFetchOk"] is string autoFetchOk)
{
    <div class="alert alert-success">@autoFetchOk</div>
}
@if (TempData["AutoFetchError"] is string autoFetchError)
{
    <div class="alert alert-danger">@autoFetchError</div>
}
@if (Model.AutoFetchJob is not null)
{
    @await Html.PartialAsync("Details/_AutoFetchPanel", Model)
}
@await Html.PartialAsync("Details/_PipelineStrip", Model)
@if (r.IsManualReviewRequired && !string.IsNullOrEmpty(r.ManualReviewReason))
{
    <div class="alert alert-danger">@r.ManualReviewReason</div>
}
@if (r.RequestStatus == RequestStatus.ExtractionFailed && !string.IsNullOrEmpty(r.FailureReason)
     && (Model.AutoFetchJob is null || Model.AutoFetchJob.Status != AutoFetchJobStatus.Failed))
{
    <div class="alert alert-danger">Extraction failed: @r.FailureReason</div>
}

<div class="tab-content" id="mcaMainTabContent">
    <div class="tab-pane fade show active" id="tab-ai" role="tabpanel" aria-labelledby="tab-button-ai" tabindex="0">@await Html.PartialAsync("Details/_AiAnalysisTab", Model)</div>
    <div class="tab-pane fade" id="tab-corporate" role="tabpanel" aria-labelledby="tab-button-corporate" tabindex="0">@await Html.PartialAsync("Details/_CorporateTab", Model)</div>
    <div class="tab-pane fade" id="tab-financials" role="tabpanel" aria-labelledby="tab-button-financials" tabindex="0">@await Html.PartialAsync("Details/_FinancialsTab", Model)</div>
    <div class="tab-pane fade" id="tab-charges" role="tabpanel" aria-labelledby="tab-button-charges" tabindex="0">@await Html.PartialAsync("Details/_ChargesTab", Model)</div>
    <div class="tab-pane fade" id="tab-compliance" role="tabpanel" aria-labelledby="tab-button-compliance" tabindex="0">@await Html.PartialAsync("Details/_ComplianceTab", Model)</div>
    <div class="tab-pane fade" id="tab-litigation" role="tabpanel" aria-labelledby="tab-button-litigation" tabindex="0">@await Html.PartialAsync("Details/_LitigationTab", Model)</div>
    <div class="tab-pane fade" id="tab-timeline" role="tabpanel" aria-labelledby="tab-button-timeline" tabindex="0">@await Html.PartialAsync("Details/_TimelineTab", Model)</div>
    <div class="tab-pane fade" id="tab-documents" role="tabpanel" aria-labelledby="tab-button-documents" tabindex="0">@await Html.PartialAsync("Details/_DocumentsTab", Model)</div>
</div>

@await Html.PartialAsync("Details/_ChatPanel", Model)

@section Styles {
    <link rel="stylesheet" href="~/css/request-workspace.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/amount-unit.js"></script>
    <script src="~/js/contents-nav.js" asp-append-version="true"></script>
    <script src="~/js/chat-panel.js" asp-append-version="true"></script>
    <script src="~/js/litigation-workspace.js" asp-append-version="true"></script>
}
