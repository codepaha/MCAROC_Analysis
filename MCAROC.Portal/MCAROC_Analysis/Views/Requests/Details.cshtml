@model RequestDetailsViewModel
@{
    ViewData["Title"] = Model.Request.RequestNumber;
    var r = Model.Request;
    var run = Model.LatestAnalysisRun;

    // The 7 lender-oriented business domains. AI Analysis is first and default.
    var tabs = new (string Label, string Id, string? Badge)[]
    {
        ("AI Analysis",        "ai",         null),
        ("Corporate",          "corporate",  null),
        ("Financials",         "financials", Model.FinancialYears.Count > 0 ? Model.FinancialYears.Count.ToString() : null),
        ("Charges & Security", "charges",    Model.OpenChargeCount > 0 ? Model.OpenChargeCount.ToString() : null),
        ("Compliance",         "compliance", null),
        ("Litigation",         "litigation", Model.LitigationCount > 0 ? Model.LitigationCount.ToString() : null),
        ("Documents",          "documents",  null),
    };
}

@* ─────────────────────────  Fixed company header + domain tabs  ───────────────────────── *@
<div class="mca-detail-head">
    <div class="mca-company-head">
        <div class="mca-company-id">
            <h1>@r.CompanyName</h1>
            <div class="mca-ids">
                <span><b>CIN:</b> @(r.Cin ?? r.Llpin ?? "—")</span>
                <span><b>PAN:</b> @(r.Pan ?? "—")</span>
            </div>
        </div>
        <div class="mca-company-meta">
            <div class="mca-pills">
                <span class="pi-status-pill @StatusPill(r.RequestStatus)">@r.RequestStatus</span>
                @if (run?.OverallReviewPriority is { } hdrPr)
                {
                    <span class="pi-status-pill @PriorityPill(hdrPr)">@hdrPr Priority</span>
                }
                @if (r.IsManualReviewRequired)
                {
                    <span class="pi-status-pill pi-status-processing">Manual Review Required</span>
                }
            </div>
            <small><b>@r.RequestNumber</b> &middot; @(r.Client?.ClientName)</small>
            <small>Updated @((r.UpdatedDate ?? r.CreatedDate).ToString("d MMM yyyy HH:mm"))</small>
            @if (r.RequestStatus == RequestStatus.AnalysisCompleted)
            {
                <div class="mt-1">
                    <a href="/Requests/@r.RequestId/dossier?variant=executive" class="btn btn-sm btn-outline-primary">Download dossier — Executive</a>
                    <a href="/Requests/@r.RequestId/dossier?variant=full" class="btn btn-sm btn-outline-secondary ms-1">Full source</a>
                </div>
            }
        </div>
    </div>

    <ul class="nav mca-tabs" id="mcaTabs" role="tablist">
        @for (var i = 0; i < tabs.Length; i++)
        {
            var t = tabs[i];
            <li class="nav-item" role="presentation">
                <button class="nav-link @(i == 0 ? "active" : "")" data-bs-toggle="tab"
                        data-bs-target="#tab-@t.Id" type="button" role="tab">
                    @t.Label
                    @if (t.Badge is { } b) { <span class="badge">@b</span> }
                </button>
            </li>
        }
    </ul>
</div>

@if (r.IsManualReviewRequired && !string.IsNullOrEmpty(r.ManualReviewReason))
{
    <div class="alert alert-danger">@r.ManualReviewReason</div>
}
@if (r.RequestStatus == RequestStatus.ExtractionFailed && !string.IsNullOrEmpty(r.FailureReason))
{
    <div class="alert alert-danger">Extraction failed: @r.FailureReason</div>
}

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-ai" role="tabpanel">@await Html.PartialAsync("Details/_AiAnalysisTab", Model)</div>
    <div class="tab-pane fade" id="tab-corporate" role="tabpanel">@await Html.PartialAsync("Details/_CorporateTab", Model)</div>
    <div class="tab-pane fade" id="tab-financials" role="tabpanel">@await Html.PartialAsync("Details/_FinancialsTab", Model)</div>
    <div class="tab-pane fade" id="tab-charges" role="tabpanel">@await Html.PartialAsync("Details/_ChargesTab", Model)</div>
    <div class="tab-pane fade" id="tab-compliance" role="tabpanel">@await Html.PartialAsync("Details/_ComplianceTab", Model)</div>
    <div class="tab-pane fade" id="tab-litigation" role="tabpanel">@await Html.PartialAsync("Details/_LitigationTab", Model)</div>
    <div class="tab-pane fade" id="tab-documents" role="tabpanel">@await Html.PartialAsync("Details/_DocumentsTab", Model)</div>
</div>

@section Scripts {
    <script>
        (function () {
            var reqId = '@r.RequestId';
            var tabKey = 'mca-v2-' + reqId + '-tab';
            var secKey = function (domain) { return 'mca-v2-' + reqId + '-sec-' + domain; };
            var focusCharge = '@(Model.FocusChargeId?.ToString() ?? "")';

            function activate(btn) { if (btn) { try { new bootstrap.Tab(btn).show(); } catch (e) {} } }
            function byTarget(scope, target) { return scope.querySelector('[data-bs-toggle="tab"][data-bs-target="' + target + '"]'); }

            // ── deep-link hash: #tab-<domain> or #tab-<domain>/<section> ──
            var hashDomain = null, hashSection = null;
            if (location.hash && location.hash.indexOf('#tab-') === 0) {
                var parts = location.hash.substring(5).split('/');
                hashDomain = 'tab-' + parts[0];
                if (parts[1]) hashSection = 'sec-' + parts[0] + '-' + parts[1];
                try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {}
            }

            // ── main tab ──
            var mainTabs = document.querySelectorAll('#mcaTabs button[data-bs-toggle="tab"]');
            var target = hashDomain ? ('#' + hashDomain) : null;
            if (!target && focusCharge) target = '#tab-charges';
            try { if (!target) target = sessionStorage.getItem(tabKey); } catch (e) {}
            if (target) activate(document.querySelector('#mcaTabs button[data-bs-target="' + target + '"]'));
            mainTabs.forEach(function (b) {
                b.addEventListener('shown.bs.tab', function (e) {
                    try { sessionStorage.setItem(tabKey, e.target.getAttribute('data-bs-target')); } catch (err) {}
                });
            });

            // ── per-domain section sub-tabs ──
            document.querySelectorAll('[data-mca-sections]').forEach(function (nav) {
                var domain = nav.getAttribute('data-mca-sections');
                var wanted = null;
                if (hashSection && byTarget(nav, '#' + hashSection)) wanted = '#' + hashSection;
                if (!wanted) { try { wanted = sessionStorage.getItem(secKey(domain)); } catch (e) {} }
                if (wanted && byTarget(nav, wanted)) activate(byTarget(nav, wanted));
                nav.querySelectorAll('button[data-bs-toggle="tab"]').forEach(function (b) {
                    b.addEventListener('shown.bs.tab', function (e) {
                        try { sessionStorage.setItem(secKey(domain), e.target.getAttribute('data-bs-target')); } catch (err) {}
                    });
                });
            });

            // ── Standalone / Consolidated (and similar) segmented toggles ──
            document.querySelectorAll('[data-basis-group]').forEach(function (grp) {
                var id = grp.getAttribute('data-basis-group');
                grp.querySelectorAll('button[data-basis]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var basis = btn.getAttribute('data-basis');
                        grp.querySelectorAll('button[data-basis]').forEach(function (b) { b.classList.toggle('active', b === btn); });
                        document.querySelectorAll('[data-basis-panel="' + id + '"]').forEach(function (p) {
                            p.hidden = p.getAttribute('data-basis') !== basis;
                        });
                    });
                });
            });

            // ── ?charge=<id>: open the Charges tab, right section, expand + scroll ──
            if (focusCharge) {
                var row = document.getElementById('charge-' + focusCharge);
                if (row) {
                    var inSatisfied = row.closest('#sec-charges-satisfied') !== null;
                    var secBtn = document.querySelector('[data-mca-sections="charges"] button[data-bs-target="#sec-charges-' + (inSatisfied ? 'satisfied' : 'open') + '"]');
                    activate(secBtn);
                    try { new bootstrap.Collapse(row, { show: true }); } catch (e) { row.classList.add('show'); }
                    setTimeout(function () { row.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 250);
                }
            }

            // ── Documents tab: fetch-swap the paged filing list (progressive enhancement) ──
            var panel = document.getElementById('mca-docs-panel');
            if (panel) {
                panel.addEventListener('click', function (e) {
                    var a = e.target.closest('a');
                    if (!a || !a.getAttribute('href')) return;
                    var href = a.getAttribute('href');
                    if (href.indexOf('/Requests/') === -1 || href.indexOf('/Documents') === -1) return;
                    e.preventDefault();
                    panel.classList.add('mca-loading');
                    fetch(href, { headers: { 'X-Requested-With': 'fetch' } })
                        .then(function (res) { return res.text(); })
                        .then(function (html) { panel.innerHTML = html; panel.classList.remove('mca-loading'); })
                        .catch(function () { panel.classList.remove('mca-loading'); window.location = href; });
                });
            }
        })();
    </script>
}
