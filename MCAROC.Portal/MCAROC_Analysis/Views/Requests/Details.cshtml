@model RequestDetailsViewModel
@{
    ViewData["Title"] = Model.Request.RequestNumber;
    var r = Model.Request;
}

<h1>@r.CompanyName</h1>
<p class="text-muted">
    Request: <strong>@r.RequestNumber</strong> &middot;
    Client: @(r.Client?.ClientName) &middot;
    CIN/PAN: @(r.Cin ?? r.Llpin) / @r.Pan &middot;
    Status: <span class="badge bg-secondary">@r.RequestStatus</span>
    @if (r.IsManualReviewRequired)
    {
        <span class="badge bg-warning text-dark">Manual Review Required</span>
    }
</p>

@if (r.IsManualReviewRequired && !string.IsNullOrEmpty(r.ManualReviewReason))
{
    <div class="alert alert-warning">@r.ManualReviewReason</div>
}

@if (r.RequestStatus == RequestStatus.ExtractionFailed)
{
    <div class="alert alert-danger">Extraction failed: @r.FailureReason</div>
}

<h5>Uploaded Documents</h5>
<table class="table table-sm">
    <thead><tr><th>File</th><th>Type</th><th>Status</th><th>Uploaded</th></tr></thead>
    <tbody>
    @foreach (var doc in Model.Documents)
    {
        <tr>
            <td>@doc.OriginalFileName</td>
            <td>@doc.DocumentType</td>
            <td>
                @doc.UploadStatus
                @if (doc.UploadStatus == DocumentUploadStatus.Quarantined)
                {
                    <span class="text-danger">&mdash; @doc.QuarantineReason</span>
                }
            </td>
            <td>@doc.UploadedDate.ToString("dd MMM yyyy HH:mm")</td>
        </tr>
    }
    </tbody>
</table>

@if (Model.LatestRun is { } run)
{
    <h5>Extraction Summary <small class="text-muted">(run #@run.RunNumber, @run.Status)</small></h5>
    <table class="table table-sm w-auto">
        <tbody>
            <tr><td>Company Profile</td><td>@(Model.CompanyProfile is not null ? "✓ 1" : "Not available")</td></tr>
            <tr><td>Directors</td><td>✓ @Model.Directors.Count</td></tr>
            <tr><td>Director Associations</td><td>✓ @Model.DirectorAssociations.Count</td></tr>
            <tr><td>Shareholders</td><td>✓ @Model.Shareholdings.Count</td></tr>
            <tr><td>Financial Years</td><td>✓ @Model.FinancialYears.Count</td></tr>
            <tr><td>Charges</td><td>✓ @Model.Charges.Count (@Model.Charges.Sum(c => c.Events.Count) events)</td></tr>
            <tr><td>MSME</td><td>✓ @Model.MsmePayments.Count</td></tr>
            <tr><td>GST Registrations</td><td>✓ @Model.GstRegistrations.Count (@Model.GstRegistrations.Sum(g => g.Filings.Count) filings)</td></tr>
            <tr><td>EPFO Contributions</td><td>✓ @Model.EpfoContributions.Count</td></tr>
            <tr><td>Auditor Observations</td><td>✓ @Model.AuditorObservations.Count</td></tr>
            <tr><td>Litigation</td><td>✓ @Model.Litigations.Count</td></tr>
            <tr><td><strong>Warnings</strong></td><td><strong>@Model.Issues.Count(i => i.Severity == IssueSeverity.Warning)</strong></td></tr>
        </tbody>
    </table>

    if (Model.CompanyProfile is { } cp)
    {
        <h5>Company Profile</h5>
        <table class="table table-sm w-auto">
            <tr><td>Name</td><td>@cp.CompanyName</td></tr>
            <tr><td>CIN</td><td>@cp.Cin</td></tr>
            <tr><td>PAN</td><td>@cp.Pan</td></tr>
            <tr><td>Status</td><td>@cp.CompanyStatus / @cp.ComplianceStatus</td></tr>
            <tr><td>Incorporated</td><td>@cp.IncorporationDate</td></tr>
            <tr><td>Capital (Authorised / Paid Up, Cr)</td><td>@cp.AuthorisedCapital / @cp.PaidUpCapital</td></tr>
            <tr><td>Industry</td><td>@cp.Industry</td></tr>
            <tr><td>Registered Address</td><td>@cp.RegisteredAddress</td></tr>
        </table>
    }

    <h5>Directors</h5>
    <table class="table table-sm">
        <thead><tr><th>Name</th><th>DIN</th><th>Designation</th><th>Appointed</th><th>Ceased</th></tr></thead>
        <tbody>
        @foreach (var d in Model.Directors)
        {
            <tr><td>@d.NameRaw</td><td>@d.Din</td><td>@d.Designation</td><td>@d.OriginalAppointmentDate</td><td>@d.CessationDate</td></tr>
        }
        </tbody>
    </table>

    <h5>Shareholding</h5>
    <table class="table table-sm">
        <thead><tr><th>Year</th><th>Shareholder</th><th>Type</th><th>% Held</th><th>Shares</th><th>Source</th></tr></thead>
        <tbody>
        @foreach (var s in Model.Shareholdings)
        {
            <tr><td>@s.FinancialYear</td><td>@s.ShareholderNameRaw</td><td>@s.ShareholderType</td><td>@s.HoldingPercentage%</td><td>@s.SharesHeld</td><td>@s.SourceType</td></tr>
        }
        </tbody>
    </table>

    <h5>Financial Years (Rs. Crore)</h5>
    <div class="table-responsive">
    <table class="table table-sm">
        <thead><tr><th>Year</th><th>Revenue</th><th>EBITDA</th><th>PBT</th><th>PAT</th><th>Net Worth</th><th>Total Debt</th><th>CFO</th></tr></thead>
        <tbody>
        @foreach (var f in Model.FinancialYears)
        {
            <tr><td>FY@(f.FinancialYear)</td><td>@f.Revenue</td><td>@f.Ebitda</td><td>@f.Pbt</td><td>@f.Pat</td><td>@f.NetWorth</td><td>@f.TotalDebt</td><td>@f.Cfo</td></tr>
        }
        </tbody>
    </table>
    </div>

    <h5>Charges</h5>
    @foreach (var c in Model.Charges)
    {
        <div class="card mb-2">
            <div class="card-header">
                Charge @c.RocChargeNumber &mdash; @c.ChargeStatus &mdash; @c.LatestChargeHolderRaw &mdash; Rs. @c.CurrentAmount Cr
            </div>
            <table class="table table-sm mb-0">
                <thead><tr><th>Event</th><th>Date</th><th>Amount (Cr)</th><th>Holder</th><th>Match</th></tr></thead>
                <tbody>
                @foreach (var ev in c.Events.OrderBy(e => e.EventDate))
                {
                    <tr><td>@ev.EventType</td><td>@ev.EventDate</td><td>@ev.ChargeAmount</td><td>@ev.HolderNameRaw</td><td>@ev.MatchConfidence</td></tr>
                }
                </tbody>
            </table>
        </div>
    }

    <h5>MSME</h5>
    <table class="table table-sm">
        <thead><tr><th>Supplier</th><th>PAN</th><th>Amount Due (Cr)</th><th>Period</th></tr></thead>
        <tbody>
        @foreach (var m in Model.MsmePayments)
        {
            <tr><td>@m.SupplierNameRaw</td><td>@m.SupplierPan</td><td>@m.AmountDueCrore</td><td>@m.ReportingPeriod</td></tr>
        }
        </tbody>
    </table>

    <h5>GST</h5>
    @foreach (var g in Model.GstRegistrations)
    {
        <p class="mb-1"><strong>@g.Gstin</strong> (@g.State) &mdash; @g.Status &mdash; @g.Filings.Count filing(s)</p>
    }

    <h5>EPFO</h5>
    <table class="table table-sm">
        <thead><tr><th>Establishment</th><th>Wage Month</th><th>Employees</th><th>Amount (Cr)</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var e in Model.EpfoContributions)
        {
            <tr><td>@e.EstablishmentName</td><td>@e.WageMonth</td><td>@e.EmployeeCount</td><td>@e.ContributionAmountCrore</td><td>@e.PaymentStatus</td></tr>
        }
        </tbody>
    </table>

    <h5>Auditor Observations</h5>
    <table class="table table-sm">
        <thead><tr><th>Year</th><th>Qualified/Adverse?</th><th>Comments</th></tr></thead>
        <tbody>
        @foreach (var a in Model.AuditorObservations)
        {
            <tr><td>@a.FinancialYear</td><td>@(a.HasQualificationOrAdverseRemark ? "Yes" : "No")</td><td>@a.ObservationText</td></tr>
        }
        </tbody>
    </table>

    <h5>Litigation</h5>
    <table class="table table-sm">
        <thead><tr><th>Type</th><th>Status</th><th>Court</th><th>Litigants</th><th>Case No.</th><th>Match</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Litigations)
        {
            <tr><td>@l.CaseType</td><td>@l.CaseStatus</td><td>@l.Court</td><td>@l.Litigants</td><td>@l.CaseNumber</td><td>@l.MatchStatus</td></tr>
        }
        </tbody>
    </table>

    @if (Model.Issues.Count > 0)
    {
        <h5>Extraction Warnings</h5>
        <table class="table table-sm">
            <thead><tr><th>Parser</th><th>Field</th><th>Row</th><th>Message</th></tr></thead>
            <tbody>
            @foreach (var i in Model.Issues)
            {
                <tr><td>@i.ParserName</td><td>@i.FieldName</td><td>@i.RowNumber</td><td>@i.Message</td></tr>
            }
            </tbody>
        </table>
    }
}
else
{
    <p class="text-muted">No completed extraction yet.</p>
}

<hr />
<h3>AI Analysis</h3>

@if (Model.LatestAnalysisRun is null)
{
    <p class="text-muted">
        @(r.RequestStatus == RequestStatus.AiAnalysisInProgress ? "Analysis in progress…" : "Analysis has not started for this request yet.")
    </p>
}
else
{
    var analysisRun = Model.LatestAnalysisRun;
    if (analysisRun.Status == AnalysisRunStatus.Running)
    {
        <p class="text-muted">Analysis in progress… (run #@analysisRun.RunNumber)</p>
    }
    else if (analysisRun.Status == AnalysisRunStatus.Failed)
    {
        <div class="alert alert-danger">Analysis failed: @analysisRun.FailureReason</div>
    }
    else
    {
        var priorityBadgeClass = analysisRun.OverallReviewPriority switch
        {
            ReviewPriority.High => "bg-danger",
            ReviewPriority.Medium => "bg-warning text-dark",
            _ => "bg-success"
        };
        <p>
            Review Priority: <span class="badge @priorityBadgeClass">@analysisRun.OverallReviewPriority</span>
            <span class="badge bg-danger">Critical @analysisRun.CriticalFindingsCount</span>
            <span class="badge bg-warning text-dark">Review @analysisRun.ReviewFindingsCount</span>
            <span class="badge bg-secondary">Watch @analysisRun.WatchFindingsCount</span>
            <span class="badge bg-success">Positive @analysisRun.PositiveFindingsCount</span>
            @if (analysisRun.Status == AnalysisRunStatus.CompletedWithErrors)
            {
                <span class="badge bg-info text-dark" title="@analysisRun.FailureReason">AI narrative unavailable</span>
            }
        </p>

        @if (Model.ExecutiveSummary is { } es)
        {
            <div class="card mb-3">
                <div class="card-header">Executive Summary</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(es.BusinessPerformance)) { <p><strong>Business Performance:</strong> @es.BusinessPerformance</p> }
                    @if (!string.IsNullOrEmpty(es.FinancialPosition)) { <p><strong>Financial Position:</strong> @es.FinancialPosition</p> }
                    @if (!string.IsNullOrEmpty(es.BorrowingSecurity)) { <p><strong>Borrowing &amp; Security:</strong> @es.BorrowingSecurity</p> }
                    @if (!string.IsNullOrEmpty(es.GovernanceCompliance)) { <p><strong>Governance &amp; Compliance:</strong> @es.GovernanceCompliance</p> }
                    @if (es.KeyReviewItems.Count > 0)
                    {
                        <strong>Key Review Items</strong>
                        <ul class="mb-0">
                            @foreach (var item in es.KeyReviewItems)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }

        var tabs = new (string Label, FindingSection[] Sections)[]
        {
            ("Corporate", [FindingSection.CompanyProfile, FindingSection.Directors, FindingSection.DirectorNetwork, FindingSection.Ownership]),
            ("Financial", [FindingSection.Financial]),
            ("Charges & Security", [FindingSection.Charges]),
            ("Compliance", [FindingSection.Msme, FindingSection.Gst, FindingSection.Epfo, FindingSection.Auditor]),
            ("Litigation", [FindingSection.Litigation]),
            ("AI Findings", [FindingSection.CrossSection])
        };

        <ul class="nav nav-tabs" role="tablist">
            @for (var i = 0; i < tabs.Length; i++)
            {
                var tab = tabs[i];
                var count = Model.AnalysisFindings.Count(f => tab.Sections.Contains(f.Section));
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(i == 0 ? "active" : "")" data-bs-toggle="tab" data-bs-target="#analysis-tab-@i" type="button" role="tab">
                        @tab.Label <span class="badge bg-light text-dark">@count</span>
                    </button>
                </li>
            }
        </ul>
        <div class="tab-content border border-top-0 p-3 mb-3">
            @for (var i = 0; i < tabs.Length; i++)
            {
                var tab = tabs[i];
                var sectionFindings = Model.AnalysisFindings.Where(f => tab.Sections.Contains(f.Section)).ToList();
                // Critical/Review always show in full; Watch/Positive are capped to keep Financial (the
                // largest domain) from dominating the page — the full rule-hit set is still persisted,
                // just not all rendered. AnalysisFindings is already sorted by Severity/DisplayPriority/
                // ObservationDate in the controller, so Take(5) here respects that ordering.
                var displayFindings = sectionFindings.Where(f => f.Severity is FindingSeverity.Critical or FindingSeverity.Review)
                    .Concat(sectionFindings.Where(f => f.Severity == FindingSeverity.Watch).Take(5))
                    .Concat(sectionFindings.Where(f => f.Severity == FindingSeverity.Positive).Take(5))
                    .ToList();

                <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="analysis-tab-@i" role="tabpanel">
                    @if (displayFindings.Count == 0)
                    {
                        <p class="text-muted mb-0">No findings in this section.</p>
                    }
                    else
                    {
                        @foreach (var f in displayFindings)
                        {
                            var (icon, cardClass) = f.Severity switch
                            {
                                FindingSeverity.Critical => ("🔴", "border-danger"),
                                FindingSeverity.Review => ("🟠", "border-warning"),
                                FindingSeverity.Watch => ("🟡", "border-secondary"),
                                _ => ("🟢", "border-success")
                            };
                            var relatedCodes = string.IsNullOrEmpty(f.SupportingSignalsJson)
                                ? new List<string>()
                                : (System.Text.Json.JsonSerializer.Deserialize<List<string>>(f.SupportingSignalsJson) ?? new List<string>());
                            <div class="card mb-2 @cardClass" id="finding-@f.Code">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        @icon @f.Title
                                        <small class="text-muted">(@f.TemporalStatus@(f.PeriodLabel is not null ? $" · {f.PeriodLabel}" : ""))</small>
                                    </h6>
                                    <p class="card-text">@f.SummaryText</p>
                                    @if (!string.IsNullOrEmpty(f.WhyThisMatters))
                                    {
                                        <p class="mb-1"><strong>Why this matters:</strong> @f.WhyThisMatters</p>
                                    }
                                    @if (!string.IsNullOrEmpty(f.RecommendedReview))
                                    {
                                        <p class="mb-1"><strong>Recommended Review:</strong> @f.RecommendedReview</p>
                                    }
                                    @if (relatedCodes.Count > 0)
                                    {
                                        <p class="mb-0"><small class="text-muted">Related: @string.Join(", ", relatedCodes)</small></p>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
}

@if (Model.FilingBatch is { } fb)
{
    <hr />
    <h4>MCA Filings</h4>
    <p class="text-muted">
        Batch status: <span class="badge bg-secondary">@fb.Status</span>
        @if (fb.FailureReason is not null)
        {
            <span class="text-danger">&mdash; @fb.FailureReason</span>
        }
    </p>

    <h5>Extraction Summary</h5>
    <table class="table table-sm w-auto">
        <tbody>
            @foreach (var kv in Model.FilingCategoryCounts)
            {
                <tr><td>@kv.Key</td><td>@kv.Value document(s)</td></tr>
            }
            <tr><td colspan="2"><hr class="my-1" /></td></tr>
            @foreach (var kv in Model.TextExtractionMethodCounts)
            {
                <tr><td>Text extraction: @kv.Key</td><td>@kv.Value document(s)</td></tr>
            }
            <tr><td colspan="2"><hr class="my-1" /></td></tr>
            <tr><td>AI extraction succeeded</td><td>@Model.AiSuccessCount filing(s)</td></tr>
            <tr><td>AI extraction failed</td><td>@Model.AiFailedCount filing(s)</td></tr>
            <tr><td><strong>Manual review required</strong></td><td><strong>@Model.ManualReviewFilingCount document(s)</strong></td></tr>
        </tbody>
    </table>

    @foreach (var categoryGroup in Model.FilingSummaries.GroupBy(f => f.DominantCategory))
    {
        <h5>@categoryGroup.Key</h5>
        @foreach (var fs in categoryGroup)
        {
            var f = fs.Filing;
            <div class="card mb-2">
                <div class="card-header">
                    SRN @f.Srn
                    @if (!string.IsNullOrEmpty(f.ParsedCompanyName))
                    {
                        <span>&mdash; @f.ParsedCompanyName</span>
                    }
                    @if (f.ManualReviewRequired)
                    {
                        <span class="badge bg-warning text-dark">Manual Review: @f.ManualReviewReason</span>
                    }
                </div>
                <div class="card-body">
                    <table class="table table-sm mb-2">
                        <thead><tr><th>File</th><th>Form Type</th><th>Confidence</th><th>Status</th><th>Pages (native/OCR)</th></tr></thead>
                        <tbody>
                        @foreach (var d in f.Documents.Where(d => d.DuplicateOfDocumentId == null))
                        {
                            <tr>
                                <td>@d.OriginalFileName</td>
                                <td>@d.FormType</td>
                                <td>@d.ClassificationConfidence (@d.ClassificationMethod)</td>
                                <td>@d.ProcessingStatus</td>
                                <td>@d.NativePageCount / @d.OcrPageCount</td>
                            </tr>
                        }
                        </tbody>
                    </table>

                    @if (fs.Extraction is { } ex)
                    {
                        @if (ex.Status == ExtractionStatus.Success && !string.IsNullOrEmpty(ex.ExtractedJson))
                        {
                            <strong>Extracted:</strong>
                            <ul>
                                @foreach (var prop in System.Text.Json.JsonDocument.Parse(ex.ExtractedJson).RootElement.EnumerateObject())
                                {
                                    // JsonElement.TryGetProperty throws (rather than returning false) when
                                    // called on an element that isn't a JSON object at all — guard on
                                    // ValueKind first, since a field can legitimately come back as a bare
                                    // null/string/number instead of the usual {"value":...,"pages":...} shape.
                                    var isObject = prop.Value.ValueKind == System.Text.Json.JsonValueKind.Object;
                                    var valueEl = isObject && prop.Value.TryGetProperty("value", out var v) ? v : default;
                                    if (valueEl.ValueKind is System.Text.Json.JsonValueKind.Null or System.Text.Json.JsonValueKind.Undefined) { continue; }
                                    var pagesEl = isObject && prop.Value.TryGetProperty("pages", out var p) ? p.ToString() : "";
                                    <li><strong>@prop.Name:</strong> @valueEl.ToString() <span class="text-muted">(pages: @pagesEl)</span></li>
                                }
                            </ul>
                            <details>
                                <summary class="text-muted" style="cursor:pointer;">View Raw JSON</summary>
                                <pre class="small">@ex.ExtractedJson</pre>
                            </details>
                        }
                        else
                        {
                            <span class="text-danger">AI extraction failed: @ex.FailureReason</span>
                            @if (!string.IsNullOrEmpty(ex.RawModelResponse))
                            {
                                <details><summary class="text-muted" style="cursor:pointer;">Raw model response</summary><pre class="small">@ex.RawModelResponse</pre></details>
                            }
                        }
                    }
                    else if (categoryGroup.Key is FilingCategory.Financial or FilingCategory.Unclassified)
                    {
                        <span class="text-muted">Stored, not yet analysed.</span>
                    }
                    else
                    {
                        <span class="text-muted">AI extraction pending.</span>
                    }
                </div>
            </div>
        }
    }
}
