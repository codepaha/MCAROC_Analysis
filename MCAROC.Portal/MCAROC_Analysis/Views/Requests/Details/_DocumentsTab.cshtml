@model RequestDetailsViewModel
@{
    var r = Model.Request;
    var hasBatch = Model.FilingBatch is not null;
    var chatSuggestions = new[]
    {
        "Who are the current directors?",
        "Which directors have resigned?",
        "List all open charges.",
        "Are there any delayed EPFO payments?",
        "What is the company's main object per the MoA?"
    };
}

<ul class="nav mca-subtabs" data-mca-sections="documents" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#sec-documents-filed" type="button" role="tab">
            Filed Documents <span class="badge">@Model.FilingCategoryCounts.Values.Sum()</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sec-documents-ask" type="button" role="tab">Ask Documents</button>
    </li>
</ul>

<div class="tab-content">

    @* ── Filed Documents ── *@
    <div class="tab-pane fade show active mca-subtab-panel" id="sec-documents-filed" role="tabpanel">
        <div class="mca-section">
            <h3>Uploaded Reference Files <span class="mca-count">@Model.Documents.Count</span></h3>
            <div class="pi-table-wrap"><table class="pi-results-table">
                <thead><tr><th>File</th><th>Type</th><th>Status</th><th>Uploaded</th></tr></thead>
                <tbody>
                @foreach (var doc in Model.Documents)
                {
                    <tr>
                        <td>@doc.OriginalFileName</td>
                        <td>@doc.DocumentType</td>
                        <td>
                            @doc.UploadStatus
                            @if (doc.UploadStatus == DocumentUploadStatus.Quarantined) { <span class="text-danger">— @doc.QuarantineReason</span> }
                        </td>
                        <td>@doc.UploadedDate.ToString("d MMM yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table></div>
        </div>

        <div class="mca-section">
            <h3>MCA Filings</h3>
            @if (!hasBatch)
            {
                <div class="mca-empty"><i class="bi bi-folder2-open"></i><p>No MCA filing archive was uploaded for this request.</p></div>
            }
            else
            {
                var fb = Model.FilingBatch!;
                if (fb.FailureReason is not null) { <div class="alert alert-danger">@fb.FailureReason</div> }

                <div class="mca-highlight-grid" style="margin-bottom:16px;">
                    @foreach (var kv in Model.FilingCategoryCounts.OrderBy(k => k.Key))
                    {
                        <div class="pi-metric"><span>@(kv.Key == FilingCategory.Unclassified ? "Other" : kv.Key.ToString())</span><strong>@kv.Value</strong><small>document(s)</small></div>
                    }
                    <div class="pi-metric"><span>AI extraction</span><strong>@Model.AiSuccessCount / @(Model.AiSuccessCount + Model.AiFailedCount)</strong><small>filing(s) succeeded</small></div>
                    @if (Model.ManualReviewFilingCount > 0)
                    {
                        <div class="pi-metric"><span>Manual review</span><strong>@Model.ManualReviewFilingCount</strong><small>document(s) flagged</small></div>
                    }
                </div>

                <div id="mca-docs-panel" data-mca-docs-url="@Url.Action("Documents", "Requests", new { id = r.RequestId })">
                    <a class="mca-chip" data-mca-docs-load href="@Url.Action("Documents", "Requests", new { id = r.RequestId })">
                        <i class="bi bi-list-ul"></i> Browse @Model.FilingCategoryCounts.Values.Sum() filed document(s)
                    </a>
                </div>
            }
        </div>
    </div>

    @* ── Ask Documents ── *@
    <div class="tab-pane fade mca-subtab-panel" id="sec-documents-ask" role="tabpanel">
        <p class="text-muted">Answers are grounded only in the documents and structured data uploaded for <strong>@r.CompanyName</strong>.</p>

        @if (Model.FilingBatch is not null)
        {
            if (Model.ChunkableDocumentCount == 0)
            {
                <div class="alert alert-info">Document indexing has not started yet — questions can still be answered from structured data.</div>
            }
            else if (Model.ChunkedDocumentCount < Model.ChunkableDocumentCount)
            {
                <div class="alert alert-info">
                    Document search is still indexing (@Model.ChunkedDocumentCount / @Model.ChunkableDocumentCount documents) —
                    answers may not yet cover all uploaded filings.
                </div>
            }
        }

        <p class="mb-1"><small class="text-muted">Try asking:</small></p>
        <div class="mb-3 d-flex flex-wrap gap-1">
            @foreach (var suggestion in chatSuggestions)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        onclick="var q=document.getElementById('chat-question');q.value=this.textContent.trim();q.focus();">
                    @suggestion
                </button>
            }
        </div>

        <div class="mb-3">
            @if (Model.ChatMessages.Count == 0)
            {
                <div class="mca-empty"><i class="bi bi-chat-dots"></i><p>No questions yet — ask something about this company's records below.</p></div>
            }
            @foreach (var m in Model.ChatMessages)
            {
                var isUser = m.Role == ChatRole.User;
                <div class="mca-finding @(isUser ? "sev-watch" : "sev-positive")">
                    <h4>
                        <span class="mca-sev-dot"></span>@(isUser ? "You" : "Assistant")
                        @if (m.Status == ChatMessageStatus.Failed) { <span class="pi-status-pill pi-status-failed">Error</span> }
                    </h4>
                    <p>@m.MessageText</p>
                    @if (!isUser && !string.IsNullOrEmpty(m.CitedSourcesJson))
                    {
                        var citations = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(m.CitedSourcesJson);
                        if (citations.ValueKind == System.Text.Json.JsonValueKind.Array && citations.GetArrayLength() > 0)
                        {
                            <div class="mca-related">
                                Sources:
                                @foreach (var cit in citations.EnumerateArray())
                                {
                                    var sourceType = cit.TryGetProperty("SourceType", out var st) ? st.GetString() : null;
                                    var label = cit.TryGetProperty("Label", out var l) ? l.GetString() : null;
                                    string display;
                                    if (sourceType == "DocumentChunk"
                                        && cit.TryGetProperty("DocumentName", out var dn) && dn.ValueKind == System.Text.Json.JsonValueKind.String
                                        && cit.TryGetProperty("PageNumber", out var pn) && pn.ValueKind == System.Text.Json.JsonValueKind.Number)
                                    {
                                        @* Filed-PDF citation — a real page in an uploaded MCA filing, never a workbook row. *@
                                        display = $"Source: {dn.GetString()}, page {pn.GetInt32()}";
                                    }
                                    else if (sourceType == "StructuredFact"
                                        && cit.TryGetProperty("EntityType", out var et) && et.ValueKind == System.Text.Json.JsonValueKind.String)
                                    {
                                        @* Parsed workbook data, not a PDF page — must not claim a page number it doesn't have. *@
                                        display = $"Computed from parsed data ({et.GetString()})";
                                    }
                                    else
                                    {
                                        display = label ?? "Source not recorded";
                                    }
                                    <span class="mca-citation">&nbsp;@display</span>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <form asp-controller="Chat" asp-action="Ask" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" value="@r.RequestId" />
            <input type="text" id="chat-question" name="question" class="form-control" placeholder="Ask a question about this company's records…" required />
            <button type="submit" class="btn btn-primary">Ask</button>
        </form>
    </div>

</div>
