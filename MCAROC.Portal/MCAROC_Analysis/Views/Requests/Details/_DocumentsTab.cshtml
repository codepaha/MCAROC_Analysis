@model RequestDetailsViewModel
@using Microsoft.AspNetCore.Authentication
@{
    var r = Model.Request;
    var hasBatch = Model.FilingBatch is not null;
    var isReviewer = (await Context.AuthenticateAsync("InternalReviewer")).Succeeded;
    var chatSuggestions = new[]
    {
        "Who are the current directors?",
        "Which directors have resigned?",
        "List all open charges.",
        "Are there any delayed EPFO payments?",
        "What is the company's main object per the MoA?"
    };
}

<ul class="nav mca-subtabs" data-mca-sections="documents" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#sec-documents-filed" type="button" role="tab">
            Filed Documents <span class="badge">@Model.FilingCategoryCounts.Values.Sum()</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sec-documents-ask" type="button" role="tab">Ask Documents</button>
    </li>
</ul>

<div class="tab-content">

    @* ── Filed Documents ── *@
    <div class="tab-pane fade show active mca-subtab-panel" id="sec-documents-filed" role="tabpanel">
        <div class="mca-section">
            <h3>Uploaded Reference Files <span class="mca-count">@Model.Documents.Count</span></h3>
            <div class="pi-table-wrap"><table class="pi-results-table">
                <thead><tr><th>File</th><th>Type</th><th>Status</th><th>Source Role</th><th>Uploaded</th><th>Action</th></tr></thead>
                <tbody>
                @foreach (var doc in Model.Documents.OrderByDescending(d => d.UploadedDate))
                {
                    <tr>
                        <td>
                            @if (doc.UploadStatus == DocumentUploadStatus.Quarantined && !isReviewer)
                            {
                                <span><i class="bi bi-file-earmark me-1 text-muted"></i>@doc.OriginalFileName</span>
                            }
                            else
                            {
                                <a href="/Requests/@r.RequestId/uploaded-documents/@doc.DocumentId/download" class="text-decoration-none fw-semibold" title="Download @doc.OriginalFileName">
                                    <i class="bi bi-file-earmark me-1"></i>@doc.OriginalFileName
                                </a>
                            }
                        </td>
                        <td>@doc.DocumentType</td>
                        <td>
                            @doc.UploadStatus
                            @if (doc.UploadStatus == DocumentUploadStatus.Quarantined) { <span class="text-danger">— @doc.QuarantineReason</span> }
                        </td>
                        <td>
                            @if (doc.IsActiveSource)
                            {
                                <span class="badge bg-success">Active Source</span>
                            }
                            else if (doc.SupersededByDocumentId is not null)
                            {
                                <span class="badge bg-secondary">Superseded</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@doc.UploadedDate.ToString("d MMM yyyy HH:mm")</td>
                        <td>
                            @if (doc.UploadStatus != DocumentUploadStatus.Quarantined)
                            {
                                <a href="/Requests/@r.RequestId/uploaded-documents/@doc.DocumentId/download" class="btn btn-sm btn-outline-primary" title="Download @doc.OriginalFileName">
                                    <i class="bi bi-download me-1"></i> Download
                                </a>
                            }
                            else if (isReviewer)
                            {
                                <a href="/Requests/@r.RequestId/uploaded-documents/@doc.DocumentId/download" class="btn btn-sm btn-outline-danger" title="Download quarantined file (Reviewer only)">
                                    <i class="bi bi-shield-exclamation me-1"></i> Download Quarantined
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border" title="Quarantined files cannot be downloaded">
                                    <i class="bi bi-slash-circle me-1"></i> Unavailable
                                </span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>

            <div class="card mt-3">
                <div class="card-header bg-light">
                    <strong>Attach / Supersede Source Workbooks</strong>
                </div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("AddSourceWorkbooks", "Requests", new { id = r.RequestId })" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="rowVersion" value="@(r.RowVersion is not null ? Convert.ToBase64String(r.RowVersion) : "")" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">New MCA / ROC Report (Excel)</label>
                                <input type="file" name="rocFile" class="form-control" accept=".xlsx,.xls" />
                                <small class="text-muted">Upload a new ROC workbook to supersede the current active report.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">New Detailed Charge Report (Excel, Optional)</label>
                                <input type="file" name="chargeFile" class="form-control" accept=".xlsx,.xls" />
                                <small class="text-muted">Upload a new charge workbook or leave blank to retain existing.</small>
                            </div>
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-cloud-arrow-up me-1"></i> Upload & Re-Ingest
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="mca-section">
            <h3>MCA Filings</h3>
            @if (!hasBatch)
            {
                <div class="mca-empty"><i class="bi bi-folder2-open"></i><p>No MCA filing archive was uploaded for this request.</p></div>
            }
            else
            {
                var fb = Model.FilingBatch!;
                var archiveDoc = fb.SourceDocumentId > 0
                    ? Model.Documents.FirstOrDefault(d => d.DocumentId == fb.SourceDocumentId && d.DocumentType == DocumentType.McaFilingsArchive)
                    : null;
                if (fb.FailureReason is not null) { <div class="alert alert-danger">@fb.FailureReason</div> }

                <div class="mca-highlight-grid" style="margin-bottom:16px;">
                    @foreach (var kv in Model.FilingCategoryCounts.OrderBy(k => k.Key))
                    {
                        <div class="pi-metric"><span>@(kv.Key == FilingCategory.Unclassified ? "Other" : kv.Key.ToString())</span><strong>@kv.Value</strong><small>document(s)</small></div>
                    }
                    <div class="pi-metric"><span>AI extraction</span><strong>@Model.AiSuccessCount / @(Model.AiSuccessCount + Model.AiFailedCount)</strong><small>filing(s) succeeded</small></div>
                    <div class="pi-metric">
                        <span>Search Index</span>
                        <strong>@Model.AuthoritativeBatchTotalChunks chunk(s)</strong>
                        <small>across @Model.AuthoritativeBatchChunkedCount / @Model.AuthoritativeBatchChunkableCount doc(s)</small>
                        @if (Model.AuthoritativeBatchChunkingFailedCount > 0)
                        {
                            <div class="mt-1"><span class="badge bg-danger text-white">@Model.AuthoritativeBatchChunkingFailedCount failed</span></div>
                        }
                    </div>
                    @if (Model.ManualReviewFilingCount > 0)
                    {
                        <div class="pi-metric"><span>Manual review</span><strong>@Model.ManualReviewFilingCount</strong><small>document(s) flagged</small></div>
                    }
                </div>

                <div id="mca-docs-panel" data-mca-docs-url="@Url.Action("Documents", "Requests", new { id = r.RequestId })" class="d-flex align-items-center gap-2 flex-wrap">
                    <a class="mca-chip" data-mca-docs-load href="@Url.Action("Documents", "Requests", new { id = r.RequestId })">
                        <i class="bi bi-list-ul"></i> Browse @Model.FilingCategoryCounts.Values.Sum() filed document(s)
                    </a>
                    @if (archiveDoc != null && (archiveDoc.UploadStatus != DocumentUploadStatus.Quarantined || isReviewer))
                    {
                        <a href="/Requests/@r.RequestId/uploaded-documents/@archiveDoc.DocumentId/download" class="btn btn-sm btn-outline-secondary" title="Download Source Filings Archive (@archiveDoc.OriginalFileName)">
                            <i class="bi bi-file-earmark-zip me-1"></i> Download Archive (.zip)
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    @* ── Ask Documents ── *@
    <div class="tab-pane fade mca-subtab-panel" id="sec-documents-ask" role="tabpanel">
        <p class="text-muted">Answers are grounded only in the documents and structured data uploaded for <strong>@r.CompanyName</strong>.</p>
        <div class="mca-empty">
            <i class="bi bi-chat-dots"></i>
            <p>Document assistant is available in the docked panel from any tab.</p>
            <button type="button" class="btn btn-sm btn-primary mt-2" onclick="document.getElementById('mcaChatTrigger')?.click();">
                <i class="bi bi-chat-text me-1"></i>Open Assistant Panel
            </button>
        </div>
    </div>

</div>
