@* Reference partial for the shared chart contract (#116, C6) — one ChartSeries, one inline <svg>
   sparkline, one paired accessible table. All coordinate numbers are formatted with InvariantCulture:
   SVG attribute syntax requires '.' as the decimal separator regardless of the server's ambient
   culture (the same culture pitfall #123/C5b hit with DetailsFormat.Money's un-pinned N2 format). *@
@using System.Globalization
@using MCAROC_Analysis.Models.Dossier
@using MCAROC_Analysis.Models.Viz
@model ChartSeries
@{
    const double width = 280;
    const double height = 56;
    const double padX = 6;
    const double padY = 6;
    var layout = SparklineGeometry.Compute(Model, width, height, padX, padY);

    string N(double n) => n.ToString("0.##", CultureInfo.InvariantCulture);
}
@if (layout is null)
{
    <p class="text-muted mb-0 small">Not enough data.</p>
}
else
{
    <div class="mca-sparkline">
        <svg viewBox="0 0 @N(width) @N(height)" width="100%" height="@N(height)" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            @if (layout.BaselineY is { } baselineY)
            {
                <line x1="@N(padX)" y1="@N(baselineY)" x2="@N(width - padX)" y2="@N(baselineY)" stroke="var(--border-strong)" stroke-width="1" stroke-dasharray="2,2" />
            }
            @foreach (var segment in layout.Segments)
            {
                @if (segment.Points.Count >= 2)
                {
                    <polyline points="@string.Join(" ", segment.Points.Select(p => $"{N(p.X)},{N(p.Y)}"))" fill="none" stroke="var(--brand)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                }
                @foreach (var point in segment.Points)
                {
                    <circle cx="@N(point.X)" cy="@N(point.Y)" r="2.5" fill="var(--brand)"><title>@point.Label: @MetricUnitFormat.Format(point.Value, Model.Unit)</title></circle>
                }
            }
        </svg>
    </div>
    <table class="visually-hidden">
        <caption>@Model.Label</caption>
        <thead><tr><th>Period</th><th>Value</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Points)
        {
            <tr><td>@p.Period.Label</td><td>@Model.FormatPoint(p)</td></tr>
        }
        </tbody>
    </table>
}
