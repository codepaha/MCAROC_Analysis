@model RequestDetailsViewModel
@{
    var extracted = Model.LatestRun is not null;
    var open = Model.OpenChargesOrdered;
    var satisfied = Model.SatisfiedChargesOrdered;

    var sections = new (string Label, string Id, int? Count)[]
    {
        ("Summary", "summary", null),
        ("Open Charges", "open", open.Count),
        ("Satisfied Charges", "satisfied", satisfied.Count),
    };

    void SecurityBadges(RocCharge c)
    {
        foreach (var t in RequestDetailsViewModel.SecurityTypeLabels(c))
        {
            <span class="mca-badge">@System.Text.RegularExpressions.Regex.Replace(t, "(\\B[A-Z])", " $1")</span>
        }
    }

    // Groups by the same normalized key the parser already computes for holder-identity matching
    // (RocCharge.LatestChargeHolderNormalized), so spelling/case variants of one real lender collapse
    // into one group instead of fragmenting it. A blank normalized key (blank raw holder) groups every
    // unknown-holder charge together under its own "Unknown Charge Holder" heading, matching #114's badge.
    List<IGrouping<string, RocCharge>> GroupByHolder(IEnumerable<RocCharge> charges) => charges
        .GroupBy(c => c.LatestChargeHolderNormalized)
        .OrderBy(g => string.IsNullOrWhiteSpace(g.Key) ? 1 : 0) // Unknown-holder group sorts last
        .ThenBy(g => g.Key)
        .ToList();

    string HolderGroupLabel(IGrouping<string, RocCharge> group) =>
        string.IsNullOrWhiteSpace(group.Key) ? "Unknown Charge Holder" : group.First().LatestChargeHolderRaw;
}

<nav class="mca-contents-nav" id="contents-nav-charges" aria-label="Charges contents">
    <span class="mca-contents-label" aria-hidden="true">CONTENTS</span>
    <ul class="nav mca-contents-links">
        @for (var i = 0; i < sections.Length; i++)
        {
            var s = sections[i];
            <li class="nav-item">
                <a class="nav-link @(i == 0 ? "active" : "")" href="#sec-charges-@s.Id">
                    @s.Label @if (s.Count is { } c) { <span class="badge">@c</span> }
                </a>
            </li>
        }
    </ul>
</nav>

@* ── Summary ── *@
<section class="mca-contents-section" id="sec-charges-summary" aria-labelledby="head-charges-summary" tabindex="-1">
    <h3 id="head-charges-summary">Summary</h3>
    @if (!extracted)
    {
        <div class="mca-empty"><i class="bi bi-hourglass"></i><p>No completed extraction yet.</p></div>
    }
    else if (Model.TotalChargeCount == 0)
    {
        <div class="mca-empty"><i class="bi bi-file-earmark-lock"></i><p>No registered charges found.</p></div>
    }
    else
    {
        @if (Model.SheetCoverage.ChargeReportMissing)
        {
            <div class="alert alert-warning py-2 px-3 mb-3 d-flex align-items-center gap-2 small">
                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                <span>
                    <strong>Detailed Charge Report not provided.</strong> Instrument terms, property particulars and
                    per-event history below are limited to what the ROC charge sequence carries.
                </span>
            </div>
        }
        <div class="mca-highlight-grid">
            <div class="pi-metric"><span>Open Charges</span><strong>@Model.OpenChargeCount</strong><small>of @Model.TotalChargeCount registered</small></div>
            <div class="pi-metric"><span>Satisfied Charges</span><strong>@Model.SatisfiedChargeCount</strong><small>historical</small></div>
            <div class="pi-metric">
                <span>Registered Open Amount</span>
                @if (Model.TotalOpenChargeAmount is { } openAmount)
                {
                    <strong><partial name="Details/_Amount" model="new AmountViewModel(openAmount)" /></strong>
                }
                else
                {
                    <strong class="text-muted" style="font-size:0.875rem;">Not reported / reconciliation incomplete</strong>
                }
                @if (Model.CompanyProfile?.McaSumOfChargesCrore is { } mca)
                {
                    if (Model.AnyOpenChargeMissingAmount)
                    {
                        <small><span data-amount-unit-label="long">₹ Crore</span> · MCA stated: <partial name="Details/_Amount" model="new AmountViewModel(mca)" /> <span class="text-warning" title="One or more open charges have unstated amounts; reconciliation incomplete">(recon incomplete)</span></small>
                    }
                    else
                    {
                        <small><span data-amount-unit-label="long">₹ Crore</span> · MCA stated: <partial name="Details/_Amount" model="new AmountViewModel(mca)" /></small>
                    }
                }
                else
                {
                    <small><span data-amount-unit-label="long">₹ Crore</span> · MCA stated: —</small>
                }
            </div>
            <div class="pi-metric"><span>Charge Holders</span><strong>@Model.ChargeHolderCount</strong><small>distinct lenders</small></div>
            <div class="pi-metric"><span>Modified Charges</span><strong>@Model.ModifiedChargeCount</strong><small>more than one lifecycle event</small></div>
            <div class="pi-metric"><span>Material Enhancements</span><strong>@Model.MaterialEnhancementFindingCount</strong><small>Phase 3 findings</small></div>
        </div>
        <p class="text-muted mt-2">"Registered Charge Amount" is the amount on the charge register — not the current loan outstanding.</p>

        @await Html.PartialAsync("Details/_KeyIndicators", Model.KeyMetrics.Where(g => g.Title == "Charge register").ToList())

        <div class="mca-section" style="margin-top:22px;">
            <h4>Lender Concentration <span class="mca-count">open charges</span></h4>
            @if (Model.LenderConcentration.Count > 0)
            {
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Charge Holder</th><th class="text-end">Open Charges</th><th class="text-end">Registered Amount (<span data-amount-unit-label="suffix">Cr</span>)</th><th class="text-end">% of Open Registered</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.LenderConcentration)
                    {
                        <tr>
                            <td>@row.Holder</td>
                            <td class="text-end">@row.OpenCount</td>
                            <td class="text-end"><partial name="Details/_Amount" model="new AmountViewModel(row.RegisteredAmount)" /></td>
                            <td class="text-end">@(row.PctOfOpenAmount is { } p ? $"{p:0.#}%" : "—")</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
            else { <p class="text-muted mb-0">No open charges to analyse.</p> }
        </div>
    }
</section>

@* ── Open Charges ── *@
<section class="mca-contents-section" id="sec-charges-open" aria-labelledby="head-charges-open" tabindex="-1">
    <h3 id="head-charges-open">Open Charges</h3>
    @if (open.Count > 0)
    {
        <div class="pi-table-wrap"><table class="pi-results-table">
            <thead><tr><th>Charge ID</th><th>Holder</th><th>Created</th><th class="text-end">Registered Amount</th><th>Last Event</th><th>Facility</th><th>Security</th><th></th></tr></thead>
            @{ var openGroups = GroupByHolder(open); }
            @for (var gi = 0; gi < openGroups.Count; gi++)
            {
                var group = openGroups[gi];
                var groupId = $"open-holder-{gi}";
                <tbody>
                    <tr class="mca-holder-group-row">
                        <td colspan="8">
                            <a class="mca-holder-group-toggle" data-bs-toggle="collapse" href="#@groupId" role="button" aria-expanded="false" aria-controls="@groupId">
                                <i class="bi bi-chevron-right mca-holder-group-caret"></i>
                                @if (string.IsNullOrWhiteSpace(group.Key))
                                {
                                    <span class="mca-badge sev-watch">Unknown Charge Holder</span>
                                }
                                else
                                {
                                    <strong>@HolderGroupLabel(group)</strong>
                                }
                                <span class="mca-count">@group.Count() charge(s)</span>
                            </a>
                        </td>
                    </tr>
                </tbody>
                <tbody class="collapse" id="@groupId">
                @foreach (var c in group)
                {
                    var facility = c.LatestPrimaryFacilityType?.ToString();
                    var secCount = RequestDetailsViewModel.SecurityTypeLabels(c).Count;
                    <tr>
                        <td class="report-id">@c.RocChargeNumber</td>
                        <td>@(string.IsNullOrWhiteSpace(c.LatestChargeHolderRaw) ? Html.Raw("<span class=\"mca-badge sev-watch\">Unknown Charge Holder</span>") : Html.Raw(System.Net.WebUtility.HtmlEncode(c.LatestChargeHolderRaw)))</td>
                        <td>@D(c.CreationDate)</td>
                        <td class="text-end"><partial name="Details/_Amount" model="new AmountViewModel(c.CurrentAmount)" /></td>
                        <td>@D(c.LatestModificationDate ?? c.CreationDate)</td>
                        <td>@(facility ?? "—")</td>
                        <td>@if (secCount > 0) { SecurityBadges(c); } else { <text>—</text> }</td>
                        <td><a class="mca-chip" data-bs-toggle="collapse" href="#charge-@c.ChargeId" role="button">Details</a></td>
                    </tr>
                    <tr class="collapse" id="charge-@c.ChargeId">
                        <td colspan="8">@await Html.PartialAsync("Details/_ChargeDrawer", ChargeDrawerViewModel.For(c, Model.AnalysisFindings))</td>
                    </tr>
                }
                </tbody>
            }
        </table></div>
    }
    else if (extracted) { <div class="mca-empty"><i class="bi bi-unlock"></i><p>No open (unsatisfied) charges.</p></div> }
    else { <div class="mca-empty"><i class="bi bi-hourglass"></i><p>No completed extraction yet.</p></div> }
</section>

@* ── Satisfied Charges ── *@
<section class="mca-contents-section" id="sec-charges-satisfied" aria-labelledby="head-charges-satisfied" tabindex="-1">
    <h3 id="head-charges-satisfied">Satisfied Charges</h3>
    @if (satisfied.Count > 0)
    {
        <p class="text-muted">Historical / satisfied — satisfaction on the register is not the same as confirmed clean repayment.</p>
        <div class="pi-table-wrap"><table class="pi-results-table">
            <thead><tr><th>Charge ID</th><th>Holder</th><th class="text-end">Registered Amount</th><th>Created</th><th>Satisfied</th><th>Duration</th><th></th></tr></thead>
            @{ var satisfiedGroups = GroupByHolder(satisfied); }
            @for (var gi = 0; gi < satisfiedGroups.Count; gi++)
            {
                var group = satisfiedGroups[gi];
                var groupId = $"satisfied-holder-{gi}";
                <tbody>
                    <tr class="mca-holder-group-row">
                        <td colspan="7">
                            <a class="mca-holder-group-toggle" data-bs-toggle="collapse" href="#@groupId" role="button" aria-expanded="false" aria-controls="@groupId">
                                <i class="bi bi-chevron-right mca-holder-group-caret"></i>
                                @if (string.IsNullOrWhiteSpace(group.Key))
                                {
                                    <span class="mca-badge sev-watch">Unknown Charge Holder</span>
                                }
                                else
                                {
                                    <strong>@HolderGroupLabel(group)</strong>
                                }
                                <span class="mca-count">@group.Count() charge(s)</span>
                            </a>
                        </td>
                    </tr>
                </tbody>
                <tbody class="collapse" id="@groupId">
                @foreach (var c in group)
                {
                    var dur = (c.CreationDate is { } cr && c.SatisfactionDate is { } sat)
                        ? $"{(sat.ToDateTime(TimeOnly.MinValue) - cr.ToDateTime(TimeOnly.MinValue)).Days / 365.0:0.#} yr"
                        : "—";
                    <tr>
                        <td class="report-id">@c.RocChargeNumber</td>
                        <td>@(string.IsNullOrWhiteSpace(c.LatestChargeHolderRaw) ? Html.Raw("<span class=\"mca-badge sev-watch\">Unknown Charge Holder</span>") : Html.Raw(System.Net.WebUtility.HtmlEncode(c.LatestChargeHolderRaw)))</td>
                        <td class="text-end"><partial name="Details/_Amount" model="new AmountViewModel(c.CurrentAmount)" /></td>
                        <td>@D(c.CreationDate)</td>
                        <td>@D(c.SatisfactionDate)</td>
                        <td>@dur</td>
                        <td><a class="mca-chip" data-bs-toggle="collapse" href="#charge-@c.ChargeId" role="button">Details</a></td>
                    </tr>
                    <tr class="collapse" id="charge-@c.ChargeId">
                        <td colspan="7">@await Html.PartialAsync("Details/_ChargeDrawer", ChargeDrawerViewModel.For(c, Model.AnalysisFindings))</td>
                    </tr>
                }
                </tbody>
            }
        </table></div>
    }
    else if (extracted) { <div class="mca-empty"><i class="bi bi-lock"></i><p>No satisfied charges on record.</p></div> }
    else { <div class="mca-empty"><i class="bi bi-hourglass"></i><p>No completed extraction yet.</p></div> }
</section>

