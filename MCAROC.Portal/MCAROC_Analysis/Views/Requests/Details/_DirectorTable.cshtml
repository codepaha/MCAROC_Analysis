@model List<Director>
<div class="pi-table-wrap"><table class="pi-results-table">
    <thead><tr><th>Name</th><th>DIN</th><th>Designation</th><th>Present Role Since</th><th>Appointed</th><th>Ceased</th><th>Flags</th></tr></thead>
    <tbody>
    @foreach (var d in Model.OrderBy(d => d.NameRaw))
    {
        <tr>
            <td>@d.NameRaw</td>
            <td class="report-id">@Or(d.Din)</td>
            <td>@Or(d.Designation)</td>
            <td>@D(d.DesignationAppointmentDate)</td>
            <td>@D(d.OriginalAppointmentDate)</td>
            <td>@D(d.CessationDate)</td>
            <td>@if (!string.IsNullOrWhiteSpace(d.Flags)) { <span class="badge bg-light text-dark">@d.Flags</span> }</td>
        </tr>
    }
    </tbody>
</table></div>
