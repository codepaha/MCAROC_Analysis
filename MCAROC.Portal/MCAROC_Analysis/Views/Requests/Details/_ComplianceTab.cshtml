@model RequestDetailsViewModel
@{
    var std = Model.AuditorObservations.Where(a => a.Basis == FinancialBasis.Standalone).ToList();
    var con = Model.AuditorObservations.Where(a => a.Basis == FinancialBasis.Consolidated).ToList();
    var gstFilings = Model.GstRegistrations.SelectMany(g => g.Filings).ToList();

    var regulatoryRecords = Model.ComplianceRecords
        .Where(c => c.RecordType != ComplianceRecordType.SuitFiled)
        .ToList();

    var suitFiledRecords = Model.ComplianceRecords
        .Where(c => c.RecordType == ComplianceRecordType.SuitFiled)
        .ToList();

    // Bank-level peak summary
    var bankSummaries = suitFiledRecords
        .GroupBy(r => (Bank: string.IsNullOrWhiteSpace(r.Bank) ? "Unknown / Unspecified" : r.Bank.Trim(),
                       DefaulterType: string.IsNullOrWhiteSpace(r.DefaulterType) ? "Suit Filed" : r.DefaulterType.Trim()))
        .Select(g =>
        {
            var amounts = g.Select(x => x.AmountCrore).ToList();
            var hasMissingAmounts = amounts.Any(a => a is null);
            var nonNullAmounts = amounts.Where(a => a.HasValue).Select(a => a!.Value).ToList();
            decimal? peak = nonNullAmounts.Count > 0 ? nonNullAmounts.Max() : null;

            return new
            {
                Bank = g.Key.Bank,
                DefaulterType = g.Key.DefaulterType,
                PeakAmount = peak,
                HasMissingAmounts = hasMissingAmounts,
                LatestDate = g.Max(x => x.RecordDate),
                EarliestDate = g.Min(x => x.RecordDate),
                QuartersCount = g.Count(),
                Source = g.Select(x => x.Source).FirstOrDefault(s => !string.IsNullOrWhiteSpace(s)) ?? "CIBIL"
            };
        })
        .OrderByDescending(x => x.PeakAmount ?? -1m)
        .ThenByDescending(x => x.QuartersCount)
        .ToList();

    var anyFilingMissingAmount = suitFiledRecords.Any(r => r.AmountCrore is null);
    var banksWithKnownAmounts = bankSummaries.Where(b => b.PeakAmount is not null).ToList();

    decimal? totalPeakExposure = banksWithKnownAmounts.Count == 0
        ? null
        : banksWithKnownAmounts.GroupBy(b => b.Bank, StringComparer.OrdinalIgnoreCase).Sum(g => g.Max(x => x.PeakAmount!.Value));

    var uniqueBanksCount = bankSummaries
        .Select(b => b.Bank)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    var latestSuitDate = suitFiledRecords
        .Select(x => x.RecordDate)
        .Where(d => d.HasValue)
        .OrderByDescending(d => d)
        .FirstOrDefault();

    // Per-establishment header metadata (City / Date of Setup / Principal Business Activities /
    // Address / Exemption Status) from the "EPFO Establishments" summary sheet — keyed by id (A5/#36).
    var epfoMetaById = Model.EpfoEstablishments
        .Where(x => !string.IsNullOrWhiteSpace(x.EstablishmentId))
        .GroupBy(x => x.EstablishmentId, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    // EPFO Establishments grouping
    var epfoEstablishments = Model.EpfoContributions
        .GroupBy(e => string.IsNullOrWhiteSpace(e.EstablishmentId) ? (e.EstablishmentName ?? "Unknown") : e.EstablishmentId)
        .Select(g =>
        {
            var contribs = g.Select(x => x.ContributionAmountCrore).ToList();
            var hasMissingContribs = contribs.Any(c => c is null);
            var nonNullContribs = contribs.Where(c => c.HasValue).Select(c => c!.Value).ToList();
            decimal? totalContrib = hasMissingContribs ? null : nonNullContribs.Sum();

            return new
            {
                EstablishmentId = g.Key,
                Name = g.Select(x => x.EstablishmentName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? g.Key,
                WorkingStatus = g.Select(x => x.WorkingStatus).FirstOrDefault(s => !string.IsNullOrWhiteSpace(s)) ?? "Active",
                LatestMonth = g.OrderByDescending(x => x.WageMonth).FirstOrDefault()?.WageMonth,
                LatestEmployees = g.OrderByDescending(x => x.WageMonth).FirstOrDefault()?.EmployeeCount,
                TotalMonths = g.Count(),
                TotalContributions = totalContrib,
                HasMissingContributions = hasMissingContribs,
                Contributions = g.OrderByDescending(x => x.WageMonth).ToList()
            };
        })
        .ToList();

    var sections = new (string Label, string Id, int? Count)[]
    {
        ("MCA / Regulatory", "mca", Model.ComplianceRecords.Count),
        ("GST", "gst", Model.GstRegistrations.Count),
        ("EPFO", "epfo", Model.EpfoContributions.Count),
        ("MSME", "msme", Model.MsmePayments.Count),
        ("Auditor", "auditor", Model.AuditorObservations.Count),
        ("Credit Ratings", "credit-ratings", Model.CreditRatings.Count),
    };

    void AuditorTable(List<AuditorObservation> rows)
    {
        <div class="pi-table-wrap"><table class="pi-results-table">
            <thead><tr><th>Year</th><th>Auditor</th><th>Qualified / Adverse</th><th>Observation</th></tr></thead>
            <tbody>
            @foreach (var a in rows.OrderByDescending(a => a.FinancialYear))
            {
                <tr>
                    <td>FY@(a.FinancialYear)</td>
                    <td>
                        @Or(a.AuditorName)
                        @if (!string.IsNullOrWhiteSpace(a.FirmName))
                        {
                            <br /><small class="text-muted">
                                @a.FirmName
                                @(string.IsNullOrWhiteSpace(a.FirmRegistrationNumber) ? "" : $" (Reg. No. {a.FirmRegistrationNumber})")
                                @(string.IsNullOrWhiteSpace(a.MembershipNumber) ? "" : $" · Membership No. {a.MembershipNumber}")
                            </small>
                        }
                    </td>
                    <td>@(a.HasQualificationOrAdverseRemark ? "Yes" : "No")</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(a.ObservationText) && a.ObservationText.Length > 240)
                        {
                            <details><summary class="mca-json-toggle">@a.ObservationText[..240]…</summary><div>@a.ObservationText</div></details>
                        }
                        else { @Or(a.ObservationText) }
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
    }
}

<nav class="mca-contents-nav" id="contents-nav-compliance" aria-label="Compliance contents">
    <span class="mca-contents-label" aria-hidden="true">CONTENTS</span>
    <ul class="nav mca-contents-links">
        @for (var i = 0; i < sections.Length; i++)
        {
            var s = sections[i];
            <li class="nav-item">
                <a class="nav-link @(i == 0 ? "active" : "")" href="#sec-compliance-@s.Id">
                    @s.Label @if (s.Count is { } c) { <span class="badge">@c</span> }
                </a>
            </li>
        }
    </ul>
</nav>

@* ── MCA / Regulatory & CIBIL Suit-Filed ── *@
<section class="mca-contents-section" id="sec-compliance-mca" aria-labelledby="head-compliance-mca" tabindex="-1">
    <h3 id="head-compliance-mca">MCA / Regulatory</h3>
        @if (Model.CompanyProfile?.ComplianceStatus is { } cs)
        {
            <p class="mb-3"><span class="mca-finding-label">MCA compliance status (source):</span> @cs</p>
        }

        @* Statutory / MCA Events (BIFR / CDR / Name Removal / Restoration) *@
        @if (regulatoryRecords.Count > 0)
        {
            <div class="mca-section mb-4">
                <h3>Statutory & Regulatory Events <span class="mca-count">@regulatoryRecords.Count</span></h3>
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Event Type</th><th>Date</th><th>Description / Case No.</th><th>Status</th><th>Source Line</th></tr></thead>
                    <tbody>
                    @foreach (var c in regulatoryRecords)
                    {
                        <tr>
                            <td><span class="mca-badge">@c.RecordType</span></td>
                            <td>@D(c.RecordDate)</td>
                            <td>@Or(c.Description)</td>
                            <td>@Or(c.Status)</td>
                            <td class="text-muted small">@Or(c.SourceText)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        }

        @* CIBIL Suit-Filed & Wilful Defaulter Summary *@
        @if (suitFiledRecords.Count > 0)
        {
            <div class="mca-section">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h3 class="mb-0">CIBIL Suit-Filed & Wilful Defaulter Register <span class="mca-count">@suitFiledRecords.Count quarterly filings across @uniqueBanksCount institutions</span></h3>
                </div>

                <div class="mca-highlight-grid mb-3">
                    <div class="pi-metric">
                        <span>Total Peak Exposure</span>
                        @if (totalPeakExposure is { } exp && !anyFilingMissingAmount)
                        {
                            <strong><partial name="Details/_Amount" model="new AmountViewModel(exp)" /></strong>
                            <small>sum of peak amounts across @uniqueBanksCount institutions</small>
                        }
                        else if (totalPeakExposure is { } partialExp)
                        {
                            <strong><partial name="Details/_Amount" model="new AmountViewModel(partialExp)" />*</strong>
                            <small class="text-warning">incomplete coverage (*unstated filings)</small>
                        }
                        else
                        {
                            <strong class="text-muted">Not reported</strong>
                            <small class="text-muted">unstated amounts across institutions</small>
                        }
                    </div>
                    <div class="pi-metric">
                        <span>Lending Institutions</span>
                        <strong>@uniqueBanksCount</strong>
                        <small>banks / institutions reporting</small>
                    </div>
                    <div class="pi-metric">
                        <span>Quarterly Filings</span>
                        <strong>@suitFiledRecords.Count</strong>
                        <small>full multi-year historical filings</small>
                    </div>
                    <div class="pi-metric">
                        <span>Latest Reported Quarter</span>
                        <strong>@(latestSuitDate.HasValue ? D(latestSuitDate) : "—")</strong>
                        <small>most recent CIBIL report date</small>
                    </div>
                </div>

                <h4 class="h6 mb-2">Institutional Exposure Summary (Peak per Bank)</h4>
                <div class="pi-table-wrap mb-3"><table class="pi-results-table">
                    <thead>
                        <tr>
                            <th>Bank / Financial Institution</th>
                            <th>Defaulter Classification</th>
                            <th class="text-end">Peak Exposure (<span data-amount-unit-label="suffix-symbol">₹ Cr</span>)</th>
                            <th>Latest Filing</th>
                            <th class="text-end">Quarters on File</th>
                            <th>Reporting Period</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var b in bankSummaries)
                    {
                        <tr>
                            <td><strong>@b.Bank</strong></td>
                            <td><span class="mca-badge">@b.DefaulterType</span></td>
                            <td class="text-end">
                                @if (b.PeakAmount is { } pa)
                                {
                                    <strong><partial name="Details/_Amount" model="new AmountViewModel(pa)" /></strong>
                                    @if (b.HasMissingAmounts)
                                    {
                                        <span class="text-warning small" title="One or more reported quarters have unstated amounts">*</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Not reported</span>
                                }
                            </td>
                            <td>@D(b.LatestDate)</td>
                            <td class="text-end">@b.QuartersCount</td>
                            <td class="text-muted small">@(b.EarliestDate.HasValue ? D(b.EarliestDate) : "—") – @(b.LatestDate.HasValue ? D(b.LatestDate) : "—")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><strong>Total Institutional Peak Exposure</strong></td>
                            <td></td>
                            <td class="text-end">
                                @if (totalPeakExposure is { } tot && !anyFilingMissingAmount)
                                {
                                    <strong><partial name="Details/_Amount" model="new AmountViewModel(tot)" /></strong>
                                }
                                else if (totalPeakExposure is { } pTot)
                                {
                                    <strong><partial name="Details/_Amount" model="new AmountViewModel(pTot)" />*</strong>
                                    <div class="text-muted" style="font-size:0.75rem;">*coverage incomplete (unstated amounts)</div>
                                }
                                else
                                {
                                    <span class="text-muted">Not reported / incomplete</span>
                                }
                            </td>
                            <td></td>
                            <td class="text-end"><strong>@suitFiledRecords.Count</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table></div>

                <details class="mca-disclosure mt-3">
                    <summary class="mca-json-toggle">
                        <strong>View Complete Quarterly Filings Register (@suitFiledRecords.Count records)</strong> — click to expand/collapse full quarterly records
                    </summary>
                    <div class="pt-3">
                        <div class="pi-table-wrap"><table class="pi-results-table">
                            <thead><tr><th>#</th><th>Bank / Institution</th><th>Report Date</th><th class="text-end">Amount (<span data-amount-unit-label="suffix">Cr</span>)</th><th>Defaulter Classification</th><th>Source</th></tr></thead>
                            <tbody>
                            @{ var rowIdx = 1; }
                            @foreach (var c in suitFiledRecords.OrderByDescending(x => x.RecordDate).ThenByDescending(x => x.AmountCrore))
                            {
                                <tr>
                                    <td class="text-muted small">@(rowIdx++)</td>
                                    <td><strong>@Or(c.Bank)</strong></td>
                                    <td>@D(c.RecordDate)</td>
                                    <td class="text-end"><partial name="Details/_Amount" model="new AmountViewModel(c.AmountCrore)" /></td>
                                    <td><span class="mca-badge">@Or(c.DefaulterType)</span></td>
                                    <td class="text-muted small">@Or(c.Source)</td>
                                </tr>
                            }
                            </tbody>
                        </table></div>
                    </div>
                </details>

                <p class="text-muted mt-2 mb-0">Source: CIBIL Suit-Filed and Wilful Defaulter quarterly registries. Institutional peak summary isolates cumulative exposure per lender while retaining the full quarterly audit trail.</p>
            </div>
        }
        else if (regulatoryRecords.Count == 0)
        {
            <div class="mca-empty"><i class="bi bi-shield-check"></i><p>@Model.SheetCoverage.EmptyState("No MCA / regulatory compliance events (name removal, BIFR, CDR, suit-filed) were reported in this workbook.", SheetAliases.Compliance)</p></div>
        }
</section>

@* ── GST ── *@
<section class="mca-contents-section" id="sec-compliance-gst" aria-labelledby="head-compliance-gst" tabindex="-1">
    <h3 id="head-compliance-gst">GST</h3>
        <div class="mca-section">
            <h3>Registrations <span class="mca-count">@Model.GstRegistrations.Count</span></h3>
            @if (Model.GstRegistrations.Count > 0)
            {
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>GSTIN</th><th>Trade Name</th><th>Taxpayer Type</th><th>State</th><th>Jurisdiction</th><th>Status</th><th>Registered</th><th>Cancelled</th><th>Nature of Business</th><th>Flags</th><th class="text-end">Returns on file</th><th>Source</th></tr></thead>
                    <tbody>
                    @foreach (var g in Model.GstRegistrations)
                    {
                        <tr>
                            <td class="report-id">
                                @g.Gstin
                                @if (!string.IsNullOrWhiteSpace(g.LegalNameOfBusiness)) { <br /><small class="text-muted">@g.LegalNameOfBusiness</small> }
                            </td>
                            <td>@Or(g.TradeName)</td>
                            <td>@Or(g.TaxpayerType)</td>
                            <td>@Or(g.State)</td>
                            <td>@Or(g.CentreJurisdiction)@(string.IsNullOrWhiteSpace(g.StateJurisdiction) ? "" : $" / {g.StateJurisdiction}")</td>
                            <td>@Or(g.Status)</td>
                            <td>@D(g.RegistrationDate)</td>
                            <td>@D(g.CancellationDate)</td>
                            <td>@Or(g.NatureOfBusinessActivities)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(g.Flags) && g.Flags.Trim() != "-")
                                {
                                    <span class="badge bg-light text-dark">@g.Flags</span>
                                }
                                else
                                {
                                    @("—")
                                }
                            </td>
                            <td class="text-end">@g.Filings.Count</td>
                            <td>@await Html.PartialAsync("Details/_WorkbookProvenance", g)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
            else { <p class="text-muted mb-0">@Model.SheetCoverage.EmptyState("No GST registrations were extracted.", SheetAliases.Gst, SheetAliases.GstAnnexure)</p> }
        </div>

        @if (gstFilings.Count > 0)
        {
            var onTime = gstFilings.Count(f => f.DelayDays is <= 0 or null && string.Equals(f.FilingStatus, "Filed", StringComparison.OrdinalIgnoreCase));
            var late = gstFilings.Count(f => f.DelayDays is > 0);
            var notFiled = gstFilings.Count(f => !string.Equals(f.FilingStatus, "Filed", StringComparison.OrdinalIgnoreCase));
            <div class="mca-section">
                <h3>Filing Behaviour <span class="mca-count">@gstFilings.Count returns</span></h3>
                <div class="mca-highlight-grid" style="margin-bottom:16px;">
                    <div class="pi-metric"><span>On time</span><strong>@onTime</strong><small>filed on or before due date</small></div>
                    <div class="pi-metric"><span>Late</span><strong>@late</strong><small>filed after due date</small></div>
                    <div class="pi-metric"><span>Not filed</span><strong>@notFiled</strong><small>no filing recorded</small></div>
                </div>
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>GSTIN</th><th>Return</th><th>Period</th><th>Due</th><th>Filed</th><th class="text-end">Delay (days)</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var f in gstFilings.OrderByDescending(f => f.DueDate).Take(60))
                    {
                        <tr>
                            <td class="report-id">@f.Gstin</td>
                            <td>@f.ReturnType</td>
                            <td>@Or(f.TaxPeriod ?? f.FinancialYear)</td>
                            <td>@D(f.DueDate)</td>
                            <td>@D(f.FilingDate)</td>
                            <td class="text-end">@(f.DelayDays?.ToString() ?? "—")</td>
                            <td>@Or(f.FilingStatus)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
                @if (gstFilings.Count > 60) { <p class="text-muted mt-2 mb-0">Showing the 60 most recent of @gstFilings.Count returns.</p> }
            </div>
        }

        @await Html.PartialAsync("~/Views/Requests/Details/_KeyIndicators.cshtml", Model.KeyMetrics.Where(g => g.Title == "GST compliance").ToList())
</section>

@* ── EPFO ── *@
<section class="mca-contents-section" id="sec-compliance-epfo" aria-labelledby="head-compliance-epfo" tabindex="-1">
    <h3 id="head-compliance-epfo">EPFO</h3>
        @{
            // A card per establishment id present in EITHER the "EPFO Establishments" summary metadata
            // OR the monthly "Annexure - EPFO Establishments" — an upload with only one of the two sheets
            // must still surface what it does carry.
            var epfoAggById = epfoEstablishments
                .Where(x => !string.IsNullOrWhiteSpace(x.EstablishmentId))
                .ToDictionary(x => x.EstablishmentId, StringComparer.OrdinalIgnoreCase);
            var epfoCardIds = Model.EpfoEstablishments.Select(x => x.EstablishmentId)
                .Concat(epfoAggById.Keys)
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            var epfoLatest = Model.EpfoContributions.OrderByDescending(e => e.WageMonth).FirstOrDefault();
        }
        @if (epfoCardIds.Count > 0)
        {
            <div class="mca-highlight-grid" style="margin-bottom:16px;">
                <div class="pi-metric"><span>Establishments</span><strong>@epfoCardIds.Count</strong><small>registered units on record</small></div>
                <div class="pi-metric"><span>Latest Employees</span><strong>@(epfoLatest?.EmployeeCount?.ToString() ?? "—")</strong><small>@(epfoLatest?.WageMonth ?? "—")</small></div>
                <div class="pi-metric"><span>Months on record</span><strong>@Model.EpfoContributions.Count</strong><small>@(Model.EpfoContributions.Count > 0 ? "employee & payment-delay history below" : "monthly annexure not in this upload")</small></div>
            </div>

            <div class="mca-section mb-4">
                <h3>Establishment Profiles <span class="mca-count">@epfoCardIds.Count</span></h3>
                <div class="row g-3">
                    @foreach (var id in epfoCardIds)
                    {
                        var meta = epfoMetaById.GetValueOrDefault(id);
                        var agg = epfoAggById.GetValueOrDefault(id);
                        var estName = meta?.Name ?? agg?.Name ?? id;
                        var estStatus = meta?.WorkingStatus ?? agg?.WorkingStatus ?? "—";
                        var estOk = estStatus.StartsWith("LIVE", StringComparison.OrdinalIgnoreCase)
                            || estStatus.Equals("Working", StringComparison.OrdinalIgnoreCase)
                            || estStatus.Equals("Active", StringComparison.OrdinalIgnoreCase);
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm border">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title mb-0">@estName</h5>
                                        <span class="badge @(estOk ? "bg-success" : "bg-secondary")">@estStatus</span>
                                    </div>
                                    <p class="text-muted small mb-2">Establishment ID: <code>@id</code></p>
                                    @if (meta is not null)
                                    {
                                        <dl class="row small mb-3">
                                            @if (!string.IsNullOrWhiteSpace(meta.City)) { <dt class="col-5 text-muted fw-normal">City</dt><dd class="col-7 mb-1">@meta.City</dd> }
                                            @if (meta.DateOfSetup is { } setup) { <dt class="col-5 text-muted fw-normal">Date of setup</dt><dd class="col-7 mb-1">@setup.ToString("d MMM yyyy")</dd> }
                                            @if (!string.IsNullOrWhiteSpace(meta.PrincipalBusinessActivities)) { <dt class="col-5 text-muted fw-normal">Principal activity</dt><dd class="col-7 mb-1">@meta.PrincipalBusinessActivities</dd> }
                                            @if (!string.IsNullOrWhiteSpace(meta.ExemptionStatus)) { <dt class="col-5 text-muted fw-normal">Exemption</dt><dd class="col-7 mb-1">@meta.ExemptionStatus</dd> }
                                            @if (!string.IsNullOrWhiteSpace(meta.Address)) { <dt class="col-5 text-muted fw-normal">Address</dt><dd class="col-7 mb-1">@meta.Address</dd> }
                                            @if (!string.IsNullOrWhiteSpace(meta.Flags)) { <dt class="col-5 text-muted fw-normal">Flags</dt><dd class="col-7 mb-1">@meta.Flags</dd> }
                                        </dl>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-3">Establishment header (city, setup date, activity) was not in this upload — the "EPFO Establishments" sheet is absent.</p>
                                    }
                                    @if (agg is not null)
                                    {
                                        <div class="row text-center g-2 pt-2 border-top">
                                            <div class="col-4">
                                                <div class="text-muted small">Latest Headcount</div>
                                                <strong>@(agg.LatestEmployees?.ToString() ?? "—")</strong>
                                                <div class="text-muted" style="font-size:0.75rem;">@agg.LatestMonth</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="text-muted small">Total Months</div>
                                                <strong>@agg.TotalMonths</strong>
                                                <div class="text-muted" style="font-size:0.75rem;">on file</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="text-muted small">Total Paid</div>
                                                @if (agg.TotalContributions is { } tc)
                                                {
                                                    <strong><partial name="Details/_Amount" model="new AmountViewModel(tc)" /></strong>
                                                    <div class="text-muted" style="font-size:0.75rem;">aggregate</div>
                                                }
                                                else
                                                {
                                                    <strong class="text-muted">Not reported</strong>
                                                    <div class="text-muted" style="font-size:0.75rem;">incomplete coverage</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-0 pt-2 border-top">No monthly contribution history for this establishment in this upload.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mca-section">
                <h3>Contribution &amp; Headcount History <span class="mca-count">@Model.EpfoContributions.Count records</span></h3>
                @if (Model.EpfoContributions.Count > 0)
                {
                    <div class="pi-table-wrap"><table class="pi-results-table">
                        <thead><tr><th>Establishment</th><th>Wage Month</th><th>TRRN</th><th class="text-end">Employees</th><th class="text-end">Amount (<span data-amount-unit-label="suffix">Cr</span>)</th><th>Due Date</th><th>Payment Date</th><th>Status</th></tr></thead>
                        <tbody>
                        @foreach (var e in Model.EpfoContributions)
                        {
                            <tr>
                                <td>@e.EstablishmentName</td>
                                <td>@e.WageMonth</td>
                                <td class="report-id">@Or(e.Trrn)</td>
                                <td class="text-end">@(e.EmployeeCount?.ToString() ?? "—")</td>
                                <td class="text-end"><partial name="Details/_Amount" model="new AmountViewModel(e.ContributionAmountCrore)" /></td>
                                <td>@D(e.PaymentDueDate)</td>
                                <td>@D(e.PaymentDate)</td>
                                <td>@Or(e.PaymentStatus)</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
                else
                {
                    <p class="text-muted mb-0">@Model.SheetCoverage.EmptyState("The monthly EPFO annexure reported no contribution rows.", SheetAliases.EpfoAnnexure)</p>
                }
            </div>
        }
        else { <div class="mca-empty"><i class="bi bi-people"></i><p>@Model.SheetCoverage.EmptyState("No EPFO data was extracted.", SheetAliases.Epfo, SheetAliases.EpfoAnnexure)</p></div> }

        @await Html.PartialAsync("~/Views/Requests/Details/_KeyIndicators.cshtml",
            Model.KeyMetrics.Where(g => g.Title == "EPFO / labour")
                .Select(g => new MCAROC_Analysis.Models.Dossier.MetricGroup(g.Title, g.Metrics.Where(m => m.Label != "Revenue per EPFO employee").ToList()))
                .Where(g => g.HasAny).ToList())
</section>

@* ── MSME ── *@
<section class="mca-contents-section" id="sec-compliance-msme" aria-labelledby="head-compliance-msme" tabindex="-1">
    <h3 id="head-compliance-msme">MSME</h3>
        @if (Model.MsmePayments.Count > 0)
        {
            var total = Model.MsmePayments.Sum(m => m.AmountDueCrore ?? 0m);
            <div class="pi-table-wrap"><table class="pi-results-table">
                <thead><tr><th>Supplier</th><th>PAN</th><th class="text-end">Amount Due (<span data-amount-unit-label="suffix">Cr</span>)</th><th>Period</th></tr></thead>
                <tbody>
                @foreach (var m in Model.MsmePayments)
                {
                    <tr><td>@m.SupplierNameRaw</td><td class="report-id">@Or(m.SupplierPan)</td><td class="text-end"><partial name="Details/_Amount" model="new AmountViewModel(m.AmountDueCrore)" /></td><td>@m.ReportingPeriod</td></tr>
                }
                </tbody>
                <tfoot><tr><td colspan="2"><b>Total outstanding to MSME suppliers</b></td><td class="text-end"><b><partial name="Details/_Amount" model="new AmountViewModel(total)" /></b></td><td></td></tr></tfoot>
            </table></div>
            <p class="text-muted mt-2 mb-0">MSME dues feed the Phase 3 supplier-payment-pressure logic — surfaced separately, not buried under general compliance.</p>
        }
        else { <div class="mca-empty"><i class="bi bi-truck"></i><p>@Model.SheetCoverage.EmptyState("No outstanding MSME supplier dues were reported.", SheetAliases.Msme)</p></div> }
</section>

@* ── Auditor ── *@
<section class="mca-contents-section" id="sec-compliance-auditor" aria-labelledby="head-compliance-auditor" tabindex="-1">
    <h3 id="head-compliance-auditor">Auditor Observations</h3>
        @if (Model.AuditorObservations.Count > 0)
        {
            if (con.Count > 0)
            {
                <div class="mca-toggle" data-basis-group="basis-auditor" role="group" aria-label="Reporting basis">
                    <button type="button" class="active" data-basis="Standalone">Standalone</button>
                    <button type="button" data-basis="Consolidated">Consolidated</button>
                </div>
                <div data-basis-panel="basis-auditor" data-basis="Standalone">@{ AuditorTable(std); }</div>
                <div data-basis-panel="basis-auditor" data-basis="Consolidated" hidden>@{ AuditorTable(con); }</div>
            }
            else
            {
                AuditorTable(std.Count > 0 ? std : Model.AuditorObservations);
            }
        }
        else { <div class="mca-empty"><i class="bi bi-clipboard-check"></i><p>@Model.SheetCoverage.EmptyState("No auditor observations were extracted.", SheetAliases.Auditors, SheetAliases.AuditorsConsolidated)</p></div> }
</section>

@* ── Credit Ratings ── *@
<section class="mca-contents-section" id="sec-compliance-credit-ratings" aria-labelledby="head-compliance-credit-ratings" tabindex="-1">
    <h3 id="head-compliance-credit-ratings">Credit Ratings</h3>
    @{ var accepted = Model.CreditRatings.Where(c => c.IsAccepted).ToList(); var unaccepted = Model.CreditRatings.Where(c => !c.IsAccepted).ToList(); }
    @if (Model.CreditRatings.Count > 0)
    {
        @if (accepted.Count > 0)
        {
            <div class="mca-section">
                <h4>Ratings <span class="mca-count">@accepted.Count</span></h4>
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Agency</th><th>Date</th><th>Instrument</th><th class="text-end">Amount</th><th>Currency</th><th>Rating</th><th>Action</th><th>Outlook</th><th>Remarks</th></tr></thead>
                    <tbody>
                    @foreach (var c in accepted.OrderByDescending(x => x.RatingDate))
                    {
                        <tr>
                            <td>@c.Agency</td><td>@D(c.RatingDate)</td><td>@Or(c.Instrument)</td>
                            <td class="text-end">@Num(c.Amount)</td><td>@Or(c.Currency)</td>
                            <td>@Or(c.Rating)</td><td>@Or(c.Action)</td><td>@Or(c.Outlook)</td><td>@Or(c.Remarks)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        }
        @if (unaccepted.Count > 0)
        {
            <div class="mca-section">
                <h4>Unaccepted Ratings <span class="mca-count">@unaccepted.Count</span></h4>
                <p class="text-muted">The issuer did not accept or participate in these rating exercises.</p>
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Agency</th><th>Instrument</th><th class="text-end">Amount</th><th>Currency</th><th>Rating</th><th>Date of Non-Acceptance</th><th>Remarks</th></tr></thead>
                    <tbody>
                    @foreach (var c in unaccepted.OrderByDescending(x => x.RatingDate))
                    {
                        <tr>
                            <td>@c.Agency</td><td>@Or(c.Instrument)</td>
                            <td class="text-end">@Num(c.Amount)</td><td>@Or(c.Currency)</td>
                            <td>@Or(c.Rating)</td><td>@D(c.RatingDate)</td><td>@Or(c.Remarks)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        }
    }
    else { <div class="mca-empty"><i class="bi bi-award"></i><p>@Model.SheetCoverage.EmptyState("No credit rating history was reported in this workbook.", SheetAliases.CreditRatings, SheetAliases.UnacceptedRatings)</p></div> }

    @await Html.PartialAsync("~/Views/Requests/Details/_KeyIndicators.cshtml",
        Model.KeyMetrics.Where(g => g.Title == "Credit ratings").ToList())
</section>
