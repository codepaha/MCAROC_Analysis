    else
    {
        <div class="mca-highlight-grid">
            <div class="pi-metric">
                <span>Total Litigations</span>
                <strong>@confirmed.Count</strong>
                <small>confirmed matches only</small>
            </div>
            <div class="pi-metric">
                <span>Confirmed Cases</span>
                <strong>@confirmed.Count</strong>
                <small>@confirmed.Count(IsPendingRow) pending · @confirmed.Count(l => !IsPendingRow(l)) disposed</small>
            </div>
            <div class="pi-metric">
                <span>Filed Against Company</span>
                <strong>@Model.LitigationFiledAgainstCount</strong>
                <small>from Phase 3 rule attribution</small>
            </div>
            <div class="pi-metric">
                <span>Filed By Company</span>
                <strong>@Model.LitigationFiledByCount</strong>
                <small>company as petitioner</small>
            </div>
        </div>
    }

    @await Html.PartialAsync("~/Views/Requests/Details/_KeyIndicators.cshtml", Model.KeyMetrics.Where(g => g.Title == "Legal history").ToList())

    @if (workbookCats.Count > 0)
    {
        <div class="mca-section" style="margin-top:22px;">
            <h4>By Category</h4>
            <div class="pi-table-wrap">
                <table class="pi-results-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="text-end">Total Cases</th>
                            <th class="text-end">Pending</th>
