@using MCAROC_Analysis.Models
@using MCAROC_Analysis.Data.Entities
@using MCAROC_Analysis.Services.LitigationData
@using MCAROC_Analysis.Services.LitigationModule.Freshness
@model RequestDetailsViewModel
@{
    var lake = Model.LitigationDataLake;
    var reqId = Model.Request.RequestId;
    var reqIdJs = reqId.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Workbook-reported cases: only Confirmed matches are ever shown to clients.
    var confirmed = Model.Litigations.Where(l => l.MatchStatus == LitigationMatchStatus.Confirmed).ToList();
    var showWorkbookFallback = lake?.AuthoritativeSnapshot is null && confirmed.Count > 0;
    var workbookCats = confirmed
        .Where(l => !string.IsNullOrWhiteSpace(l.CaseCategory))
        .GroupBy(l => l.CaseCategory!)
        .OrderByDescending(g => g.Count()).ToList();

    string RoleBadge(LitigationRole role) => role switch
    {
        LitigationRole.FiledAgainst => "sev-critical",
        LitigationRole.FiledBy => "sev-positive",
        _ => "sev-watch"
    };

    void RenderCasesTable(List<Litigation> cases)
    {
        if (cases.Count == 0)
        {
            <div class="mca-empty"><i class="bi bi-bank"></i><p>No cases in this section.</p></div>
            return;
        }

        <div class="pi-table-wrap">
            <table class="pi-results-table">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Court</th>
                        <th>Parties</th>
                        <th>Case No.</th>
                        <th>Last Hearing</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var l in cases.OrderByDescending(l => l.LastHearingDate))
                {
                    var role = Model.RoleFor(l);
                    <tr>
                        <td><span class="mca-badge @RoleBadge(role)">@RoleLabel(role)</span></td>
                        <td>@Or(l.CaseStatus)</td>
                        <td>@Or(l.CaseCategory)</td>
                        <td>@Or(l.CaseType)</td>
                        <td>@Or(l.Court)</td>
                        <td>@Or(l.Litigants)</td>
                        <td class="report-id">@Or(l.CaseNumber)</td>
                        <td>@D(l.LastHearingDate)</td>
                        <td>@(l.Source == LitigationSource.DataLake ? "Data Lake" : "ROC Report")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

<nav class="mca-contents-nav litigation-section-links" id="contents-nav-litigation" aria-label="Litigation contents">

    <ul class="nav mca-contents-links">
        <li class="nav-item"><a class="nav-link active" href="#sec-litigation-summary">Summary</a></li>
        <li class="nav-item"><a class="nav-link" href="#sec-litigation-cases">Cases <span class="badge">@(lake?.AuthoritativeSnapshot is not null ? lake.TotalCaseCount : confirmed.Count)</span></a></li>
        <li class="nav-item"><a class="nav-link" href="#sec-litigation-financial-disputes">Financial Disputes <span class="badge">@Model.FinancialDisputeCases.Count</span></a></li>
    </ul>
</nav>

<section class="mca-contents-section" id="sec-litigation-summary" aria-labelledby="head-litigation-summary" tabindex="-1">
<h3 class="visually-hidden" id="head-litigation-summary">Summary</h3>
@if (lake is not null)
{
    var hasReport = lake.AuthoritativeSnapshot is not null;
    var isRefresh = hasReport && lake.Refresh.HasSearched;
    var searchRunning = lake.SearchJob is { IsTerminal: false } || lake.ImportState == SnapshotImportState.InProgress;
    var refreshBlocked = isRefresh && !lake.Refresh.Allowed;
    <!-- Litigation: live court records, reports, AI analysis and refresh (client-facing) -->
    <div class="litigation-toolbar">
        <div>
            <h3 class="mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-bank text-primary"></i>Litigation
                @if (lake.IsReusedReport)
                {
                    <span class="badge bg-info text-dark fs-6"><i class="bi bi-recycle me-1"></i>Reused Report</span>
                }
            </h3>
            <p class="text-muted small mb-0">

                @if (hasReport)
                {
                    <span>Data retrieved @Ist.Format(lake.AuthoritativeSnapshot!.RetrievedUtc).</span>
                }
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (hasReport)
            {
                <details class="workspace-menu">
                    <summary class="btn btn-sm btn-outline-secondary"><i class="bi bi-download me-1"></i>Download</summary>
                    <div class="workspace-menu-panel">                <div class="btn-group btn-group-sm" role="group" aria-label="Report before analysis">
                    <a href="/Requests/@reqId/Litigation/Report/pdf" class="btn btn-outline-danger" title="Case data only, no analysis"><i class="bi bi-file-earmark-pdf me-1"></i>Report (PDF)</a>
                    <a href="/Requests/@reqId/Litigation/Report/csv" class="btn btn-outline-success" title="Case register only, no analysis"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Report (CSV)</a>
                </div>
                @if (lake.HasCompletedAnalysis)
                {
                    <div class="btn-group btn-group-sm" role="group" aria-label="Report with analysis">
                        <a href="/Requests/@reqId/Litigation/Report/pdf?withAnalysis=true" class="btn btn-outline-danger" title="Includes the case analysis"><i class="bi bi-journal-text me-1"></i>With analysis (PDF)</a>
                        <a href="/Requests/@reqId/Litigation/Report/csv?withAnalysis=true" class="btn btn-outline-success" title="Includes the case analysis"><i class="bi bi-journal-text me-1"></i>With analysis (CSV)</a>
                    </div>
                }
                <a href="/Requests/@reqId/Litigation/OrdersZip" class="btn btn-sm btn-outline-secondary" title="Download all retained order PDFs as a ZIP archive">
                    <i class="bi bi-file-earmark-zip me-1"></i>All Orders (ZIP)
                </a>
</div>
                </details>
                <button type="button" id="litigation-run-analysis" class="btn btn-sm btn-primary"
                        data-analysis-availability="@(lake.AnalysisAvailabilityPending && !searchRunning ? $"/Requests/{reqId}/Litigation/AnalysisAvailability" : null)"
                        disabled="@(lake.AnalysisAvailabilityPending || lake.AnalysisInProgress || !lake.NeedsAnalysis || searchRunning)"
                        title="@(lake.AnalysisAvailabilityPending ? "Checking whether new analysis is needed" : lake.AnalysisInProgress ? "Analysis is running" : !lake.NeedsAnalysis ? "All cases are already analysed and nothing has changed" : "Analyse new or changed cases")">
                    <i class="bi bi-journal-text me-1"></i>@(lake.AnalysisInProgress ? "Analysing…" : lake.HasCompletedAnalysis ? "Re-run analysis" : "Run analysis")
                </button>
            }
            @if (lake.SearchJob is not null || hasReport)
            {
                <form method="post" action="/Requests/@reqId/Litigation/Search" class="d-inline" id="litigation-refresh-form"
                      onsubmit="return confirm('@(hasReport ? "This refresh is chargeable. " : "")Refresh litigation data?@(lake.Refresh.Unlimited ? "" : $" This uses one of your {lake.Refresh.Max} refreshes.")');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="confirmChargeableRefresh" value="true" />
                    <button type="submit" class="btn btn-sm btn-outline-primary" disabled="@(searchRunning || refreshBlocked)"
                            title="@(refreshBlocked ? lake.Refresh.Reason : lake.Refresh.Unlimited ? "Fetch fresh court records." : $"Fetch fresh court records. {lake.Refresh.Remaining} of {lake.Refresh.Max} refreshes left.")">
                        <i class="bi bi-arrow-repeat me-1"></i>Refresh data
                    </button>
                </form>
            }
        </div>
    </div>
    @if (isRefresh && !lake.Refresh.Unlimited)
    {
        <p class="small text-muted mb-3" id="litigation-refresh-note">
            <i class="bi bi-arrow-repeat me-1"></i>@lake.Refresh.Remaining of @lake.Refresh.Max refreshes remaining.
            @if (lake.Refresh.Remaining > 0)
            {
                @if (lake.Refresh.NextAllowedUtc is { } nextAt && nextAt > DateTime.UtcNow)
                {
                    <span>Next refresh available @Ist.Date(nextAt).</span>
                }
                else
                {
                    <span>You can refresh now; refreshes must be at least @lake.RefreshIntervalDays days apart.</span>
                }
            }
        </p>
    }
    @if (hasReport)
    {
        <div class="litigation-totals" aria-label="Report case totals">
            <span><strong>@lake.CourtSummaryGrid.TotalCases.ToString("N0")</strong> cases</span>
            <span><strong>@lake.CourtSummaryGrid.TotalPendingCases.ToString("N0")</strong> pending</span>
            <span><strong>@lake.CourtSummaryGrid.TotalDisposedCases.ToString("N0")</strong> disposed</span>
            <span><strong>@lake.CourtSummaryGrid.TotalUnknownCases.ToString("N0")</strong> unknown</span>
            <span class="text-muted">Report totals &middot; filters apply below</span>
        </div>
    }
    <form id="litigation-analysis-token" class="d-none">@Html.AntiForgeryToken()</form>
    <div id="litigation-action-message" class="alert alert-secondary py-2 px-3 small d-none" role="status"></div>

    var courtRefreshService = Context?.RequestServices?.GetService(typeof(ICourtRefreshStatusService)) as ICourtRefreshStatusService;
    var courtStatus = courtRefreshService != null && reqId > 0
        ? await courtRefreshService.GetRefreshStatusAsync(reqId)
        : null;
    if (courtStatus == null)
    {
        courtStatus = new CourtRefreshStatusDto(
            State: "Idle",
            Percent: 0,
            Handled: 0,
            Total: 0,
            EstimatedRemainingSeconds: null,
            EstimatedRemainingDisplay: null,
            Phase: "RefreshingCases",
            PhaseLabel: "Refreshing cases",
            StartedUtc: null,
            StartedIstDisplay: null,
            LastAgentHeartbeatUtc: null,
            Message: null,
            Finished: false,
            FinishedUtc: null,
            NotUpdated: null);
    }
    <!-- Court Refresh Progress Banner (plan section 4.8) -->
    <div id="court-refresh-banner-container" class="mb-4 @(courtStatus.State == "Idle" && (courtStatus.NotUpdated == null || courtStatus.NotUpdated.NotUpdatedCount == 0) ? "d-none" : "")" data-state="@courtStatus.State">
        @if (courtStatus.State == "Running" || courtStatus.State == "Paused" || courtStatus.State == "Failed")
        {
            <div class="card border-primary-subtle shadow-sm mb-3" id="court-refresh-active-card">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span id="court-refresh-state-indicator" class="d-inline-flex align-items-center gap-2">
                                @if (courtStatus.State == "Running")
                                {
                                    <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                    <strong class="text-primary">Court update in progress:</strong>
                                }
                                else if (courtStatus.State == "Paused")
                                {
                                    <i class="bi bi-pause-circle-fill text-warning fs-5"></i>
                                    <strong class="text-warning-emphasis">Court update paused:</strong>
                                }
                                else
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                                    <strong class="text-danger">Court update stopped:</strong>
                                }
                            </span>
                            <span id="court-refresh-counts">
                                <strong><span id="court-refresh-handled">@courtStatus.Handled.ToString("N0")</span></strong> of <strong><span id="court-refresh-total">@courtStatus.Total.ToString("N0")</span></strong> cases checked
                            </span>
                            @if (!string.IsNullOrWhiteSpace(courtStatus.StartedIstDisplay))
                            {
                                <span class="text-muted small">&middot; started <span id="court-refresh-started">@courtStatus.StartedIstDisplay</span></span>
                            }
                            <span id="court-refresh-eta-wrap" class="text-muted small @(string.IsNullOrWhiteSpace(courtStatus.EstimatedRemainingDisplay) ? "d-none" : "")">&middot; <span id="court-refresh-eta">@courtStatus.EstimatedRemainingDisplay</span></span>
                        </div>
                        <span class="badge @(courtStatus.State == "Paused" ? "bg-warning text-dark" : courtStatus.State == "Failed" ? "bg-danger" : "bg-primary") fs-6" id="court-refresh-percent-badge">@courtStatus.Percent%</span>
                    </div>

                    <div class="progress mb-2" style="height: 10px;">
                        <div class="progress-bar progress-bar-striped @(courtStatus.State == "Running" ? "progress-bar-animated bg-primary" : courtStatus.State == "Paused" ? "bg-warning" : "bg-danger")"
                             id="court-refresh-progress-bar"
                             role="progressbar"
                             style="width: @(courtStatus.Percent)%;"
                             aria-valuenow="@courtStatus.Percent"
                             aria-valuemin="0"
                             aria-valuemax="100"></div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted gap-2">
                        <div id="court-refresh-phase-line">
                            <span>Phase:</span>
                            <span class="fw-semibold text-dark" id="court-refresh-phase-label">@courtStatus.PhaseLabel</span>
                            <span class="ms-2 text-secondary">(refreshing cases &rarr; finding missing cases &rarr; fetching orders &rarr; re-analysing changed cases)</span>
                        </div>
                        <a href="#court-not-updated-details" data-bs-toggle="collapse" class="text-decoration-none" role="button" aria-expanded="false" aria-controls="court-not-updated-details">
                            <i class="bi bi-info-circle me-1"></i>Show details
                        </a>
                    </div>

                    <div id="court-refresh-heartbeat-msg" class="mt-2 @(string.IsNullOrWhiteSpace(courtStatus.Message) ? "d-none" : "")">
                        <div id="court-refresh-message-alert" class="alert @(courtStatus.State == "Failed" ? "alert-danger" : "alert-warning") py-1 px-2 small mb-0">
                            <i id="court-refresh-message-icon" class="bi @(courtStatus.State == "Failed" ? "bi-exclamation-triangle" : "bi-pause-circle") me-1"></i>
                            <span id="court-refresh-message-text">@courtStatus.Message</span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (courtStatus.State == "Completed")
        {
            <div class="alert alert-success d-flex justify-content-between align-items-center p-3 mb-3 shadow-sm" id="court-refresh-completed-card">
                <div>
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <strong>Court records verified up to @(courtStatus.FinishedUtc.HasValue ? Ist.Date(courtStatus.FinishedUtc.Value, "dd-MMM-yyyy") : "latest")</strong>
                    @if (courtStatus.NotUpdated is { } nu && nu.NotUpdatedCount > 0)
                    {
                        <span class="ms-2 small text-secondary">(@nu.NotUpdatedCount case(s) stayed unverified)</span>
                    }
                </div>
                <a href="#court-not-updated-details" data-bs-toggle="collapse" class="btn btn-sm btn-outline-success" role="button" aria-expanded="false" aria-controls="court-not-updated-details">
                    Not updated details
                </a>
            </div>
        }

        <!-- "What is not updated" panel (plan section 4.8) -->
        @if (courtStatus.NotUpdated is { } notUp)
        {
            <div class="collapse @(courtStatus.State == "Idle" && notUp.NotUpdatedCount > 0 ? "show" : "") mb-3" id="court-not-updated-details">
                <div class="card border-secondary-subtle bg-light shadow-sm">
                    <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-list-check me-2 text-primary"></i>What is still not updated (<span id="nu-notupdated-count">@notUp.NotUpdatedCount</span> of <span id="nu-total-count">@notUp.TotalCases</span> cases)</h6>
                        <small class="text-muted">Click any count to filter the case register</small>
                    </div>
                    <div class="card-body p-3 small">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="fw-semibold text-muted text-uppercase mb-1">Not yet checked</div>
                                <ul class="list-unstyled mb-2 ps-2 border-start border-2">
                                    <li>
                                        <a href="/Requests/@reqIdJs?freshness=not-yet-updated#tab-litigation" class="text-decoration-none" data-litigation-page>
                                            Queued &middot; <span id="nu-queued-count" class="badge bg-secondary">@notUp.QueuedCount</span>
                                        </a>
                                    </li>
                                    <li class="mt-1">
                                        <a href="/Requests/@reqIdJs?freshness=not-yet-updated#tab-litigation" class="text-decoration-none" data-litigation-page>
                                            In progress &middot; <span id="nu-inprogress-count" class="badge bg-info text-dark">@notUp.InProgressCount</span>
                                        </a>
                                    </li>
                                </ul>

                                <div class="fw-semibold text-muted text-uppercase mb-1 mt-3">Not due, by design</div>
                                <ul class="list-unstyled mb-2 ps-2 border-start border-2">
                                    <li>
                                        <a href="/Requests/@reqIdJs?freshness=not-due#tab-litigation" class="text-decoration-none" data-litigation-page>
                                            Next hearing today or later &middot; <span id="nu-notdue-count" class="badge bg-light text-secondary border">@notUp.NextHearingFutureCount</span>
                                        </a>
                                    </li>
                                    <li class="mt-1">
                                        <a href="/Requests/@reqIdJs?status=Disposed#tab-litigation" class="text-decoration-none" data-litigation-page>
                                            Disposed cases (not refreshed) &middot; <span id="nu-disposed-count" class="badge bg-light text-secondary border">@notUp.DisposedCount</span>
                                        </a>
                                    </li>
                                </ul>

                                <div class="fw-semibold text-muted text-uppercase mb-1 mt-3">Could not verify</div>
                                <ul class="list-unstyled mb-2 ps-2 border-start border-2">
                                    <li>
                                        <a href="/Requests/@reqIdJs?freshness=could-not-verify#tab-litigation" class="text-decoration-none" data-litigation-page>
                                            Not found on portal &middot; <span id="nu-notfound-count" class="badge bg-warning-subtle text-warning-emphasis">@notUp.NotFoundCount</span>
                                        </a>
                                    </li>
                                    <li class="mt-1">
                                        <a href="/Requests/@reqIdJs?freshness=could-not-verify#tab-litigation" class="text-decoration-none" data-litigation-page>
                                            Identity mismatch &middot; <span id="nu-mismatch-count" class="badge bg-warning-subtle text-warning-emphasis">@notUp.IdentityMismatchCount</span>
                                        </a>
                                    </li>
                                    <li class="mt-1">
                                        <a href="/Requests/@reqIdJs?freshness=could-not-verify#tab-litigation" class="text-decoration-none" data-litigation-page>
                                            Failed after retries &middot; <span id="nu-failed-count" class="badge bg-danger-subtle text-danger-emphasis">@notUp.FailedAttemptsCount</span>
                                        </a>
                                        <ul id="nu-common-reasons" class="list-unstyled ps-3 mt-1 mb-0 small text-muted @(notUp.FailedAttemptsCount > 0 && notUp.CommonFailureReasons.Count > 0 ? "" : "d-none")">
                                            @foreach (var r in notUp.CommonFailureReasons)
                                            {
                                                <li>@r.Reason &middot; <strong>@r.Count</strong></li>
                                            }
                                        </ul>
                                    </li>
                                </ul>
                            </div>

                            <div class="col-md-6">
                                <div class="fw-semibold text-muted text-uppercase mb-1">Fields still missing, by field</div>
                                <div id="nu-missing-fields" class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var (fName, count) in notUp.MissingFieldsCount)
                                    {
                                        <a href="/Requests/@reqIdJs?missingField=@Uri.EscapeDataString(fName)#tab-litigation" class="badge bg-light text-dark border text-decoration-none py-1 px-2" data-litigation-page data-missing-field="@fName">
                                            @fName: <strong data-missing-field-count="@fName">@count</strong>
                                        </a>
                                    }
                                </div>

                                <div class="fw-semibold text-muted text-uppercase mb-1 mt-3">Orders & documents</div>
                                <ul class="list-unstyled mb-2 ps-2 border-start border-2">
                                    <li>Orders not yet downloaded &middot; <span id="nu-orders-not-downloaded" class="badge bg-secondary">@notUp.OrdersNotDownloadedCount</span></li>
                                    <li class="mt-1">Text extraction pending &middot; <span id="nu-orders-extraction-pending" class="badge bg-secondary">@notUp.OrdersExtractionPendingCount</span></li>
                                    <li id="nu-orders-unsupported-row" class="mt-1 text-muted @(notUp.OrdersUnsupportedFormatCount > 0 ? "" : "d-none")">Unsupported formats (Word/images) &middot; <span id="nu-orders-unsupported" class="badge bg-secondary">@notUp.OrdersUnsupportedFormatCount</span></li>
                                    <li id="nu-orders-drat-row" class="mt-1 text-muted @(notUp.OrdersDratCount > 0 ? "" : "d-none")">DRAT (no public orders) &middot; <span id="nu-orders-drat" class="badge bg-secondary">@notUp.OrdersDratCount</span></li>
                                </ul>

                                <div class="fw-semibold text-muted text-uppercase mb-1 mt-3">Analysis</div>
                                <ul class="list-unstyled mb-0 ps-2 border-start border-2">
                                    <li>Cases queued for re-analysis &middot; <span id="nu-analysis-queued" class="badge bg-secondary">@notUp.CasesQueuedForAnalysisCount</span></li>
                                    <li class="mt-1 text-muted">Portfolio summary &middot; <span id="nu-portfolio-summary" class="badge @(notUp.PortfolioSummaryPending ? "bg-warning text-dark" : "bg-light text-secondary border")">@(notUp.PortfolioSummaryPending ? "Pending" : "Current")</span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <script>
        (function() {
            var reqId = '@reqIdJs';
            var state = '@courtStatus.State';
            if (state !== 'Running' && state !== 'Paused') return;

            function setText(id, val) {
                var el = document.getElementById(id);
                if (el && val !== undefined && val !== null) el.innerText = String(val);
            }

            function escapeHtml(str) {
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function updateNotUpdatedPanel(nu) {
                if (!nu) return;
                setText('nu-notupdated-count', nu.notUpdatedCount);
                setText('nu-total-count', nu.totalCases);
                setText('nu-queued-count', nu.queuedCount);
                setText('nu-inprogress-count', nu.inProgressCount);
                setText('nu-notdue-count', nu.nextHearingFutureCount);
                setText('nu-disposed-count', nu.disposedCount);
                setText('nu-notfound-count', nu.notFoundCount);
                setText('nu-mismatch-count', nu.identityMismatchCount);
                setText('nu-failed-count', nu.failedAttemptsCount);
                setText('nu-orders-not-downloaded', nu.ordersNotDownloadedCount);
                setText('nu-orders-extraction-pending', nu.ordersExtractionPendingCount);
                setText('nu-orders-unsupported', nu.ordersUnsupportedFormatCount);
                setText('nu-orders-drat', nu.ordersDratCount);
                setText('nu-analysis-queued', nu.casesQueuedForAnalysisCount);

                var unsupRow = document.getElementById('nu-orders-unsupported-row');
                if (unsupRow) unsupRow.classList.toggle('d-none', !(nu.ordersUnsupportedFormatCount > 0));

                var dratRow = document.getElementById('nu-orders-drat-row');
                if (dratRow) dratRow.classList.toggle('d-none', !(nu.ordersDratCount > 0));

                var portEl = document.getElementById('nu-portfolio-summary');
                if (portEl) {
                    portEl.innerText = nu.portfolioSummaryPending ? 'Pending' : 'Current';
                    portEl.className = 'badge ' + (nu.portfolioSummaryPending ? 'bg-warning text-dark' : 'bg-light text-secondary border');
                }

                if (nu.missingFieldsCount && typeof nu.missingFieldsCount === 'object') {
                    Object.keys(nu.missingFieldsCount).forEach(function(key) {
                        var fieldEl = document.querySelector('[data-missing-field-count="' + key + '"]');
                        if (fieldEl) fieldEl.innerText = String(nu.missingFieldsCount[key]);
                    });
                }

                var reasonsEl = document.getElementById('nu-common-reasons');
                if (reasonsEl) {
                    if (nu.failedAttemptsCount > 0 && Array.isArray(nu.commonFailureReasons) && nu.commonFailureReasons.length > 0) {
                        reasonsEl.innerHTML = nu.commonFailureReasons.map(function(r) {
                            return '<li>' + escapeHtml(r.reason) + ' &middot; <strong>' + Number(r.count).toLocaleString() + '</strong></li>';
                        }).join('');
                        reasonsEl.classList.remove('d-none');
                    } else {
                        reasonsEl.innerHTML = '';
                        reasonsEl.classList.add('d-none');
                    }
                }
            }

            var interval = setInterval(function() {
                fetch('/Requests/' + reqId + '/court-update/status')
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (!data) return;

                        var container = document.getElementById('court-refresh-banner-container');
                        if (container && data.state) {
                            container.setAttribute('data-state', data.state);
                        }

                        var stateIndicator = document.getElementById('court-refresh-state-indicator');
                        var pBar = document.getElementById('court-refresh-progress-bar');
                        var pBadge = document.getElementById('court-refresh-percent-badge');
                        var hCount = document.getElementById('court-refresh-handled');
                        var tCount = document.getElementById('court-refresh-total');
                        var etaWrap = document.getElementById('court-refresh-eta-wrap');
                        var etaEl = document.getElementById('court-refresh-eta');
                        var phaseEl = document.getElementById('court-refresh-phase-label');
                        var msgEl = document.getElementById('court-refresh-message-text');
                        var msgAlert = document.getElementById('court-refresh-message-alert');
                        var msgIcon = document.getElementById('court-refresh-message-icon');
                        var hbWrap = document.getElementById('court-refresh-heartbeat-msg');

                        if (stateIndicator) {
                            if (data.state === 'Failed') {
                                stateIndicator.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i><strong class="text-danger">Court update stopped:</strong>';
                            } else if (data.state === 'Paused') {
                                stateIndicator.innerHTML = '<i class="bi bi-pause-circle-fill text-warning fs-5"></i><strong class="text-warning-emphasis">Court update paused:</strong>';
                            } else if (data.state === 'Running') {
                                stateIndicator.innerHTML = '<span class="spinner-border spinner-border-sm text-primary" role="status"></span><strong class="text-primary">Court update in progress:</strong>';
                            }
                        }

                        if (pBar) {
                            pBar.style.width = data.percent + '%';
                            pBar.setAttribute('aria-valuenow', data.percent);
                            if (data.state === 'Failed') {
                                pBar.className = 'progress-bar progress-bar-striped bg-danger';
                            } else if (data.state === 'Paused') {
                                pBar.className = 'progress-bar progress-bar-striped bg-warning';
                            } else if (data.state === 'Running') {
                                pBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-primary';
                            }
                        }
                        if (pBadge) {
                            pBadge.innerText = data.percent + '%';
                            if (data.state === 'Failed') {
                                pBadge.className = 'badge bg-danger fs-6';
                            } else if (data.state === 'Paused') {
                                pBadge.className = 'badge bg-warning text-dark fs-6';
                            } else if (data.state === 'Running') {
                                pBadge.className = 'badge bg-primary fs-6';
                            }
                        }
                        if (hCount) hCount.innerText = Number(data.handled).toLocaleString();
                        if (tCount) tCount.innerText = Number(data.total).toLocaleString();
                        if (etaEl && data.estimatedRemainingDisplay && data.state !== 'Failed') {
                            etaEl.innerText = data.estimatedRemainingDisplay;
                            if (etaWrap) etaWrap.classList.remove('d-none');
                        } else if (etaWrap) {
                            etaWrap.classList.add('d-none');
                        }
                        if (phaseEl && data.phaseLabel) phaseEl.innerText = data.phaseLabel;

                        if (msgAlert) {
                            msgAlert.className = 'alert ' + (data.state === 'Failed' ? 'alert-danger' : 'alert-warning') + ' py-1 px-2 small mb-0';
                        }
                        if (msgIcon) {
                            msgIcon.className = 'bi ' + (data.state === 'Failed' ? 'bi-exclamation-triangle' : 'bi-pause-circle') + ' me-1';
                        }
                        if (data.message && data.message.length > 0) {
                            if (msgEl) msgEl.innerText = data.message;
                            if (hbWrap) hbWrap.classList.remove('d-none');
                        } else if (hbWrap) {
                            hbWrap.classList.add('d-none');
                        }

                        updateNotUpdatedPanel(data.notUpdated);

                        if (data.state === 'Completed' || data.state === 'Failed' || data.finished) {
                            clearInterval(interval);
                            if (data.state === 'Completed') {
                                var actCard = document.getElementById('court-refresh-active-card');
                                if (actCard) {
                                    var verifiedDate = data.finishedIstDateDisplay || (data.finishedUtc && window.mcaIst && window.mcaIst.date ? window.mcaIst.date(data.finishedUtc) : 'latest');
                                    var unverifiedCount = (data.notUpdated && typeof data.notUpdated.notUpdatedCount === 'number') ? data.notUpdated.notUpdatedCount : 0;
                                    var unverifiedNote = unverifiedCount > 0
                                        ? '<span class="ms-2 small text-secondary">(' + Number(unverifiedCount).toLocaleString() + ' case(s) stayed unverified)</span>'
                                        : '';
                                    actCard.innerHTML = '<div class="alert alert-success d-flex justify-content-between align-items-center p-3 mb-0">' +
                                        '<div><i class="bi bi-check-circle-fill me-2 fs-5"></i><strong>Court records verified up to ' + escapeHtml(verifiedDate) + '</strong>' + unverifiedNote + '</div>' +
                                        '<a href="#court-not-updated-details" data-bs-toggle="collapse" class="btn btn-sm btn-outline-success">Not updated details</a>' +
                                        '</div>';
                                }
                            }
                        }
                    })
                    .catch(function(err) {
                        console.warn('Court update polling error:', err);
                    });
            }, 10000);
        })();
    </script>

    @* Charged property vs cases. Only Strong links are shown; silence is explained, never presented as "clean". *@
    @if (Model.ChargeLitigation is { } chl)
    {
        if (chl.HasAny)
        {
            <details class="litigation-charge-notice" id="charge-litigation-banner"><summary>Litigation touches charged property or a charge holder's recovery proceedings &middot; @chl.Links.Count link(s)</summary><div class="small pt-2">
                <div class="fw-semibold mb-1"><i class="bi bi-bank me-1"></i>Litigation touches charged property or a charge holder's recovery proceedings</div>
                <div class="mb-2">
                    @chl.CasesNamingAssets case@(chl.CasesNamingAssets == 1 ? "" : "s") name property or assets charged to a lender ·
                    @chl.CasesFor(ChargeLitigationSignal.LenderRecoveryCase) recovery proceeding@(chl.CasesFor(ChargeLitigationSignal.LenderRecoveryCase) == 1 ? "" : "s") involve a charge holder.
                </div>
                <ul class="mb-2 ps-3">
                    @foreach (var l in chl.Links.Take(8))
                    {
                        <li>
                            <strong>@l.ChargeNumber</strong> (@l.ChargeHolder):
                            @(string.IsNullOrWhiteSpace(l.Case.CaseNumber) ? "case" : l.Case.CaseNumber)@(string.IsNullOrWhiteSpace(l.Case.Court) ? "" : " · " + l.Case.Court) —
                            @ChargeLitigationLabels.Phrase(l.Signal)
                            @if (l.Case.LitigationCaseId is { } cid) { <a href="/Requests/@reqId/Litigation/Cases/@cid">view case</a> }
                        </li>
                    }
                    @if (chl.Links.Count > 8) { <li>…and @(chl.Links.Count - 8) more, in the Charges tab.</li> }
                </ul>
                <div class="text-muted">Only strong matches are shown. @(chl.NcltOrdersSkipped ? "NCLT/NCLAT orders are not scanned. " : "")@(chl.OrdersWithoutText > 0 ? $"{chl.OrdersWithoutText} order(s) had no extractable text and could not be compared. " : "")@(chl.MovableChargesWithoutIdentifiers > 0 ? $"{chl.MovableChargesWithoutIdentifiers} movable-asset charge(s) name no vehicle or serial numbers, so could not be compared." : "")</div>
            </div></details>

        }
        else if (chl.CasesScanned > 0)
        {
            <details class="litigation-secondary" id="charge-litigation-none"><summary>Charged-property check: no links found &middot; comparison limits</summary><p class="small text-muted pt-2">
                <i class="bi bi-bank me-1"></i>Charged-property check: no case was tied to a charged property or charge holder.
                @chl.OrdersScanned order(s) with text were compared@(chl.OrdersWithoutText > 0 ? $"; {chl.OrdersWithoutText} had no extractable text" : "")@(chl.NcltOrdersSkipped ? "; NCLT/NCLAT orders are not scanned" : "").
                Charges that name no specific property or asset cannot be compared@(chl.MovableChargesWithoutIdentifiers > 0 ? $" ({chl.MovableChargesWithoutIdentifiers} movable-asset charge(s) name no vehicle or serial numbers)" : "").
            </p></details>

        }
    }

    <!-- Search Status / Attempt Banners -->
    @if (lake.SearchJob is null)
    {
        <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-4">
            <div>
                <i class="bi bi-info-circle-fill me-2"></i>
                <span>The litigation search for this request has not started yet. It begins automatically once the request is ready; you can also start it now.</span>
            </div>
            <form method="post" action="/Requests/@reqId/Litigation/Search">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-primary">Run Search Now</button>
            </form>
        </div>
    }
    else
    {
        @if (lake.IsCurrentAttemptFailed)
        {
            <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 mb-4" role="alert">
                <div>
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    <strong>Search Attempt Failed:</strong>
                    <span>@(lake.SearchJob.FailureReason ?? lake.CurrentAttemptSnapshot?.FailureReason ?? (lake.ImportState == SnapshotImportState.SnapshotMissing ? "Search completed but report snapshot was missing." : "Search job encountered an error."))</span>
                </div>
                <form method="post" action="/Requests/@Model.Request.RequestId/Litigation/Search"
                      onsubmit="@(hasReport ? "return confirm('This refresh is chargeable. Rerun the litigation search?');" : "return true;")">
                    @Html.AntiForgeryToken()
                    @if (hasReport)
                    {
                        <input type="hidden" name="confirmChargeableRefresh" value="true" />
                    }
                    <button type="submit" class="btn btn-sm btn-outline-danger">Rerun Search</button>
                </form>
            </div>
        }
        else if (!lake.SearchJob.IsTerminal || lake.ImportState == SnapshotImportState.InProgress)
        {
            <div class="alert alert-info p-3 mb-4 shadow-sm" id="litigation-search-progress-banner">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span>
                        <strong>Litigation Search In Progress:</strong>
                        <span id="litigation-progress-message">@(lake.SearchJob.StatusMessage ?? "Searching court records...")</span>
                    </div>
                    <span class="badge bg-primary" id="litigation-progress-percent">@(lake.SearchJob.ProgressPercent)%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" id="litigation-progress-bar" style="width: @(lake.SearchJob.ProgressPercent)%;"></div>
                </div>
                <small class="text-muted mt-2 d-block">Status: @lake.SearchJob.Status &bull; Import: @lake.ImportState. Auto-refreshing every 3 seconds...</small>
            </div>

            <script>
                (function() {
                    var pollInterval = setInterval(function() {
                        fetch('/Requests/@Model.Request.RequestId/Litigation/Status')
                            .then(function(res) { return res.json(); })
                            .then(function(data) {
                                if (data.progressPercent !== undefined) {
                                    var pBar = document.getElementById('litigation-progress-bar');
                                    var pText = document.getElementById('litigation-progress-percent');
                                    var pMsg = document.getElementById('litigation-progress-message');
                                    if (pBar) pBar.style.width = data.progressPercent + '%';
                                    if (pText) pText.innerText = data.progressPercent + '%';
                                    if (pMsg && data.statusMessage) pMsg.innerText = data.statusMessage;
                                }
                                if (data.isTerminal) {
                                    clearInterval(pollInterval);
                                    location.reload();
                                }
                            })
                            .catch(function(err) {
                                console.warn('Polling status failed:', err);
                            });
                    }, 3000);
                })();
            </script>
        }

        @if (lake.IsPriorRunDataShown && lake.AuthoritativeSnapshot is not null)
        {
            <div class="alert alert-warning py-2 px-3 mb-4 d-flex align-items-center gap-2 small">
                <i class="bi bi-clock-history text-warning fs-5"></i>
                <div>
                    <strong>Prior Search Results Displayed:</strong>
                    <span>Showing snapshot data retrieved @Ist.Format(lake.AuthoritativeSnapshot.RetrievedUtc). The most recent search attempt is currently active or failed. Final coverage and reconciliation claims reflect the prior run.</span>
                </div>
            </div>
        }

        @if (lake.IsReusedReport && lake.AuthoritativeSnapshot is not null)
        {
            <details class="litigation-secondary" id="litigation-reuse-provenance-banner"><summary>Reused report &middot; Data retrieved @Ist.Date(lake.AuthoritativeSnapshot.RetrievedUtc)</summary><div class="small pt-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-recycle fs-4 text-info"></i>
                    <div>
                        <div class="fw-semibold">Report retrieved @Ist.Date(lake.AuthoritativeSnapshot.RetrievedUtc) — reused from another request</div>
                        <div class="small text-muted">
                            Data originated from @(lake.ReusedFromRequestNumber is not null ? $"request #{lake.ReusedFromRequestNumber}" : $"request #{lake.AuthoritativeSnapshot.ReusedFromRequestId}") (snapshot #@lake.AuthoritativeSnapshot.ReusedFromSnapshotId), originally retrieved on @Ist.Date(lake.AuthoritativeSnapshot.RetrievedUtc). It satisfied the &le; 7-day eligibility limit when reused; the 7-day bound governed reuse admission, not an ongoing freshness guarantee. Reused with zero new vendor spend.
                        </div>
                    </div>
                </div>
                <span class="badge bg-info text-dark text-nowrap"><i class="bi bi-recycle me-1"></i>Reused Report</span>
            </div></details>

        }
    }


}
@if (lake?.AuthoritativeSnapshot is null)
{
    <!-- Workbook summary: shown until live court records are available. Confirmed matches only. -->
    @if (Model.LitigationCount == 0)
    {
        <div class="mca-empty"><i class="bi bi-bank"></i><p>@Model.SheetCoverage.EmptyState("No litigation was matched to this entity.", SheetAliases.LegalHistory)</p></div>
