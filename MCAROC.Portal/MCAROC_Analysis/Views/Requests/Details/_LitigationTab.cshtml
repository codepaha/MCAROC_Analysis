                            <td class="text-end">@(g.Count() - pending)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
</section>

<section class="mca-contents-section" id="sec-litigation-cases" aria-labelledby="head-litigation-cases" tabindex="-1">
<h3 class="visually-hidden" id="head-litigation-cases">Cases</h3>
@if (showWorkbookFallback)
{
    <p class="text-muted small">Confirmed cases reported in the ingested MCA workbook. Live court records appear here once the litigation search completes.</p>
    RenderCasesTable(confirmed);
}
@if (lake is not null)
{
    <div class="litigation-register" id="litigation-register">
        <datalist id="litigation-court-options">
            @foreach (var courtRow in lake.CourtSummaryGrid.Rows) { <option value="@courtRow.CourtName"></option> }
        </datalist>
        <div id="litigation-list-feedback" class="small mb-2" role="status" aria-live="polite"></div>
