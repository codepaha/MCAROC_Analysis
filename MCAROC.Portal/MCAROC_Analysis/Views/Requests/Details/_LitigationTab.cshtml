</section>

@if (lake is not null)
{
    <details class="litigation-secondary" id="litigation-report-details">
        <summary>Report overview, court breakdown and sources</summary>
        <div class="pt-3">
    @if (lake.AuthoritativeSnapshot is not null && lake.RiskProfile.TotalCases > 0)
    {
        <!-- Risk tiers across the report (baseline from the court record) -->
        <div class="card mb-4 shadow-sm border" id="litigation-risk-profile">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                <h5 class="card-title mb-0 small fw-bold text-uppercase"><i class="bi bi-shield-exclamation me-2 text-primary"></i>Litigation Risk</h5>
                <span class="badge @LitigationBaselineRisk.BadgeCss(lake.RiskProfile.Overall) fs-6" data-risk-overall="@lake.RiskProfile.Overall">@lake.RiskProfile.Overall · @LitigationBaselineRisk.Label(lake.RiskProfile.Overall)</span>
            </div>
            <div class="card-body">
                <div class="mca-highlight-grid">
                    @foreach (var tier in new[] { LitigationRiskTier.R3, LitigationRiskTier.R2, LitigationRiskTier.R1, LitigationRiskTier.R0 })
                    {
                        <div class="pi-metric">
                            <span>@tier · @LitigationBaselineRisk.Label(tier)</span>
                            <strong>@lake.RiskProfile.Cases[tier]</strong>
                        </div>
                    }
                </div>
                @foreach (var tier in new[] { LitigationRiskTier.R3, LitigationRiskTier.R2 })
                {
                    var triggers = lake.RiskProfile.TriggersOf(tier);
                    if (triggers.Count == 0) { continue; }
                    <p class="small mb-1 mt-3"><strong>@tier</strong> — @string.Join("; ", triggers.Select(t => $"{t.Trigger} × {t.Count}"))</p>
                }
                <p class="small text-muted mb-0 mt-2">The overall tier is the highest of the cases'. Each case's tier is a baseline worked out from its court record: forum, case type, act, status and the company's side.</p>
            </div>
        </div>
    }

    @if (lake.AuthoritativeSnapshot is not null && lake.AgeProfile.PendingCases > 0)
    {
        <!-- Ageing of pending cases (as of the day the data was retrieved) -->
        <div class="card mb-4 shadow-sm border" id="litigation-age-profile">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                <h5 class="card-title mb-0 small fw-bold text-uppercase"><i class="bi bi-hourglass-split me-2 text-primary"></i>Pending Cases by Age</h5>
                @if (lake.AgeAsOf is { } ageAsOf)
                {
                    <span class="text-muted small">As of @ageAsOf.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) (data retrieval date)</span>
                }
            </div>
            <div class="card-body">
                <div class="mca-highlight-grid">
                    @foreach (var band in Enum.GetValues<CaseAgeBand>())
                    {
                        <div class="pi-metric">
                            <span>@LitigationCaseAges.Label(band)</span>
                            <strong>@lake.AgeProfile.PendingByBand[band]</strong>
                        </div>
                    }
                </div>
                @if (lake.AgeProfile.PendingEstimatedFromYear + lake.AgeProfile.PendingAtLeast > 0)
                {
                    <p class="small mb-0 mt-3 text-muted">
                        The bands count pending cases with a filing date.
                        @if (lake.AgeProfile.PendingEstimatedFromYear > 0)
                        {
                            <span><strong>@lake.AgeProfile.PendingEstimatedFromYear</strong> more @(lake.AgeProfile.PendingEstimatedFromYear == 1 ? "has" : "have") only a year to go on, so an estimated age. </span>
                        }
                        @if (lake.AgeProfile.PendingAtLeast > 0)
                        {
                            <span><strong>@lake.AgeProfile.PendingAtLeast</strong> more @(lake.AgeProfile.PendingAtLeast == 1 ? "has" : "have") no date at all, only an earliest order on file, so an age of "at least" that. Neither is banded or ranked.</span>
                        }
                    </p>
                }
                @if (lake.AgeProfile.OldestPending is { } oldest)
                {
                    <p class="small mb-0 mt-3">
                        <span class="text-muted">Oldest pending case with a filing date:</span>
                        <strong>@oldest.Duration</strong>
                        <span class="text-muted">(@oldest.BasisNote)</span>
                        @if (lake.AgeProfile.OldestPendingCaseId is { } oldestId)
                        {
                            <a href="/Requests/@reqId/Litigation/Cases/@oldestId" class="ms-1">view case</a>
                        }
                    </p>
                }
                <p class="small text-muted mb-0 mt-2">Age runs from the filing date on the court record. Where there is none it is "about" so many whole years from the case year, or failing that the year in the CNR or in the case number, and where there is no year at all it is "at least" the time since the earliest order on file.</p>
            </div>
        </div>
    }

    <!-- Forum summary -->
    @{
        var forums = lake.ForumSummary;
        var forumColumns = new List<(string Title, LitigationForumSummary.SideColumn Side)>
        {
            ("Against company", LitigationForumSummary.SideColumn.Against), ("By company", LitigationForumSummary.SideColumn.By)
        };
        if (forums.HasNotDetermined) { forumColumns.Add(("Not determined", LitigationForumSummary.SideColumn.NotDetermined)); }
        void Breakdown(LitigationForumSummary.Counts c, bool bold = false)
        {
            <span class="@(bold ? "fw-bold" : "")">@c.Total</span>
            <span class="text-muted">(<span class="text-warning-emphasis">@c.Pending</span> / <span class="text-success">@c.Disposed</span> / <span class="text-secondary">@c.Unknown</span>)</span>
        }
    }
    <div class="card mb-4 shadow-sm border" id="litigation-forum-summary">
        <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-1 py-2 px-3">
            <h5 class="card-title mb-0 small fw-bold text-uppercase">
                <i class="bi bi-grid-3x3 me-2 text-primary"></i>Summary: Forum Wise
            </h5>
            <span class="small text-muted">Each figure is total (<span class="text-warning-emphasis">pending</span> / <span class="text-success">disposed</span> / <span class="text-secondary">status unknown</span>)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 small align-middle">
                    <caption class="visually-hidden">Litigation cases by forum and by whether the company brought the case or it was brought against the company</caption>
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Forum</th>
                            <th scope="col" class="text-end">Total</th>
                            @foreach (var column in forumColumns) { <th scope="col" class="text-end">@column.Title</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var forum in Enum.GetValues<LitigationInstitution>())
                        {
                            <tr>
                                <th scope="row" class="fw-normal">@LitigationCasePresentation.Label(forum)</th>
                                <td class="text-end fw-semibold">@forums.ForForum(forum).Total</td>
                                @foreach (var column in forumColumns) { <td class="text-end text-nowrap">@{ Breakdown(forums.Cell(forum, column.Side)); }</td> }
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <th scope="row">Total</th>
                            <td class="text-end">@forums.Total.Total</td>
                            @foreach (var column in forumColumns) { <td class="text-end text-nowrap">@{ Breakdown(forums.ForSide(column.Side), bold: true); }</td> }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Source Coverage & Audit Provenance -->
    <div class="card mb-4 shadow-sm border">
        <div class="card-header bg-light py-2 px-3">
            <h5 class="card-title mb-0 small fw-bold text-uppercase">
                <i class="bi bi-shield-check me-2 text-primary"></i>Source Coverage &amp; Provenance
            </h5>
        </div>
        <div class="card-body">
            <p class="mb-3 text-dark">@lake.SourceCoverage.CoverageSummaryText</p>

            <div class="row g-2 mb-3 text-center">
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="text-muted small">Unique Proceedings</div>
                        <div class="fs-5 fw-bold">@lake.SourceCoverage.UniqueCasesCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="text-muted small">Total Observations</div>
                        <div class="fs-5 fw-bold">@lake.SourceCoverage.TotalObservationsCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="text-muted small">Downloaded Orders</div>
                        <div class="fs-5 fw-bold text-success">@lake.SourceCoverage.DownloadedOrders / @lake.SourceCoverage.TotalOrders</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="text-muted small">Expired Order URLs</div>
                        <div class="fs-5 fw-bold text-danger">@lake.SourceCoverage.ExpiredOrders</div>
                    </div>
                </div>
            </div>

            @if (lake.SourceCoverage.Keywords.Count > 0)
            {
                <div class="mb-3">
                    <div class="small fw-bold text-muted mb-1">Approved Keywords Submitted (@lake.SourceCoverage.Keywords.Count):</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var kw in lake.SourceCoverage.Keywords)
                        {
                            <span class="badge bg-light text-dark border" title="@(kw.Reason ?? $"Source: {kw.Source}")">
                                @kw.Value <small class="text-muted">(@kw.Source)</small>
                            </span>
                        }
                    </div>
                </div>
            }

            @if (lake.SourceCoverage.AttributionWaitingCount > 0)
            {
                <div class="alert alert-info py-2 small mb-3" role="status">
                    <i class="bi bi-hourglass-split me-1"></i>
                    @lake.SourceCoverage.AttributionWaitingCount case(s) returned by the search are being checked against the company's names. They are listed and counted once confirmed.
                </div>
            }

            @if (lake.SourceCoverage.SetAside.Count > 0)
            {
                var notCompany = lake.SourceCoverage.SetAside.Count(s => s.Outcome == LitigationAttributionOutcome.NotTheCompany);
                var unclear = lake.SourceCoverage.SetAside.Count - notCompany;
                <details class="mb-3">
                    <summary class="small fw-bold">
                        Set aside: @lake.SourceCoverage.SetAside.Count case(s) returned by the search are not counted
                        (@notCompany not this company's, @unclear could not be confirmed)
                    </summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm small align-middle mb-0">
                            <thead><tr><th>Case</th><th>Court</th><th>Party</th><th>Why</th></tr></thead>
                            <tbody>
                                @foreach (var s in lake.SourceCoverage.SetAside)
                                {
                                    <tr>
                                        <td><a href="/Requests/@reqId/Litigation/Cases/@s.LitigationCaseId">@(s.CaseNumber ?? "—")</a></td>
                                        <td>@(s.Court ?? "—")</td>
                                        <td>@(s.Party ?? "—")</td>
                                        <td>
                                            <span class="badge @(s.Outcome == LitigationAttributionOutcome.NotTheCompany ? "bg-secondary" : "bg-warning text-dark")">
                                                @(s.Outcome == LitigationAttributionOutcome.NotTheCompany ? "Not this company" : "Could not confirm")
                                            </span>
                                            @s.Reason
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }

            <div class="small text-muted border-top pt-2 mt-2">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Order availability:</strong> Some court orders can only be downloaded for a limited time after each search. Orders marked expired are renewed when you refresh the litigation data.
            </div>
        </div>
    </div>

    <!-- Portfolio synthesis (if available) -->
    @if (lake.PortfolioAnalysis is not null)
    {
        <div class="card mb-4 shadow-sm border border-primary-subtle">
            <div class="card-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 small fw-bold text-uppercase">
                    <i class="bi bi-journal-text me-2"></i>Portfolio summary of the cases
                </h5>
                <span class="badge bg-white text-primary">@lake.PortfolioAnalysis.Status</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(lake.PortfolioAnalysis.Summary))
                {
                    <p class="mb-3">@lake.PortfolioAnalysis.Summary</p>
                }

                @if (lake.PortfolioAnalysis.Unknowns.Count > 0)
                {
                    <div class="small fw-bold text-muted mb-1">Portfolio Information Gaps / Unknowns:</div>
                    <ul class="mb-0 ps-3 small text-muted">
                        @foreach (var u in lake.PortfolioAnalysis.Unknowns)
                        {
                            <li>@u</li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer bg-light py-1 px-3 text-muted small" style="font-size: 0.8rem;">
                Run #@lake.PortfolioAnalysis.RunNumber &bull; Completed @Ist.Format(lake.PortfolioAnalysis.CompletedUtc)
            </div>
        </div>
    }
        </div>
    </details>
}

@if (lake is not null)
{
    <script>
        (function () {
            var reqId = @reqIdJs;
            var btn = document.getElementById('litigation-run-analysis');
            var tokenInput = document.querySelector('#litigation-analysis-token input[name="__RequestVerificationToken"]');
            var msg = document.getElementById('litigation-action-message');
            function say(text) { if (!msg) return; msg.textContent = text; msg.classList.remove('d-none'); }
            function poll() {
                var t = setInterval(function () {
                    fetch('/Requests/' + reqId + '/Litigation/AnalysisProgress', { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (d) {
                            if (d && d.status !== 'Pending' && d.status !== 'InProgress') { clearInterval(t); location.reload(); }
                        }).catch(function () { });
                }, 4000);
            }
            if (btn) {
                btn.addEventListener('click', function () {
                    btn.disabled = true;
                    say('Starting analysis…');
                    fetch('/Requests/' + reqId + '/Litigation/Analysis', {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        body: new URLSearchParams({ __RequestVerificationToken: tokenInput ? tokenInput.value : '' })
                    })
                        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (b) { return { ok: r.ok, body: b }; }); })
                        .then(function (res) {
                            if (!res.ok) { say(res.body.error || 'Analysis could not be started.'); return; }
                            say('Analysis is running. This page will update when it finishes.');
                            btn.innerHTML = '<i class="bi bi-stars me-1"></i>Analysing…';
                            poll();
                        }).catch(function () { btn.disabled = false; say('Analysis could not be started.'); });
                });
                @if (lake.AnalysisInProgress)
                {
                    <text>say('Analysis is running. This page will update when it finishes.'); poll();</text>
                }
            }
        })();
    </script>
}

<!-- Shared Financial Disputes Section -->
<section class="mca-contents-section mt-4" id="sec-litigation-financial-disputes" aria-labelledby="head-litigation-financial-disputes" tabindex="-1">
    <h3 id="head-litigation-financial-disputes">Financial Disputes</h3>
    <p class="text-muted small">Money-claim disputes with an amount under default from the ingested MCA workbook.</p>
    @if (Model.FinancialDisputeCases.Count > 0)
    {
        <div class="pi-table-wrap">
            <table class="pi-results-table">
                <thead>
                    <tr>
                        <th>Direction</th>
                        <th>Type</th>
                        <th class="text-end">Amount Under Default</th>
                        <th>Currency</th>
                        <th>Verdict</th>
                        <th>Court</th>
                        <th>Parties</th>
                        <th>Case No.</th>
                        <th>Date of Default</th>
                        <th>Date of Judgement</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var fd in Model.FinancialDisputeCases)
                {
                    <tr>
                        <td>@Or(fd.Direction)</td>
                        <td>@Or(fd.DisputeType)</td>
                        <td class="text-end"><strong>@Num(fd.AmountUnderDefault)</strong></td>
                        <td>@Or(fd.Currency)</td>
                        <td><strong>@Or(fd.Verdict)</strong></td>
                        <td>@Or(fd.Court)</td>
                        <td>@Or(fd.Litigants)</td>
                        <td class="report-id">@Or(fd.CaseNumber)</td>
                        <td>@D(fd.DateOfDefault)</td>
                        <td>@D(fd.DateOfJudgement)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="mca-empty"><i class="bi bi-bank"></i><p>@Model.SheetCoverage.EmptyState("No financial dispute cases were reported in this workbook.", SheetAliases.LegalCasesFinancialDispute)</p></div>
    }
</section>

@functions {
    static bool IsPendingRow(Litigation l)
    {
        if (string.IsNullOrWhiteSpace(l.CaseStatus)) return false;
        var t = l.CaseStatus.ToLowerInvariant();
        return !new[] { "dispos", "clos", "resolv", "dismiss", "withdraw", "settl" }.Any(k => t.Contains(k));
    }
}
