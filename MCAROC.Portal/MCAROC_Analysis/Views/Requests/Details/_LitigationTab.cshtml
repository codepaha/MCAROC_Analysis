@using MCAROC_Analysis.Models
@using MCAROC_Analysis.Data.Entities
@using MCAROC_Analysis.Services.LitigationData
@model RequestDetailsViewModel
@{
    var lake = Model.LitigationDataLake;
    var reqId = Model.Request.RequestId;
    var reqIdJs = reqId.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Workbook-reported cases: only Confirmed matches are ever shown to clients.
    var confirmed = Model.Litigations.Where(l => l.MatchStatus == LitigationMatchStatus.Confirmed).ToList();
    var showWorkbookFallback = lake?.AuthoritativeSnapshot is null && confirmed.Count > 0;
    var workbookCats = confirmed
        .Where(l => !string.IsNullOrWhiteSpace(l.CaseCategory))
        .GroupBy(l => l.CaseCategory!)
        .OrderByDescending(g => g.Count()).ToList();

    string RoleBadge(LitigationRole role) => role switch
    {
        LitigationRole.FiledAgainst => "sev-critical",
        LitigationRole.FiledBy => "sev-positive",
        _ => "sev-watch"
    };

    void RenderCasesTable(List<Litigation> cases)
    {
        if (cases.Count == 0)
        {
            <div class="mca-empty"><i class="bi bi-bank"></i><p>No cases in this section.</p></div>
            return;
        }

        <div class="pi-table-wrap">
            <table class="pi-results-table">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Court</th>
                        <th>Parties</th>
                        <th>Case No.</th>
                        <th>Last Hearing</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var l in cases.OrderByDescending(l => l.LastHearingDate))
                {
                    var role = Model.RoleFor(l);
                    <tr>
                        <td><span class="mca-badge @RoleBadge(role)">@RoleLabel(role)</span></td>
                        <td>@Or(l.CaseStatus)</td>
                        <td>@Or(l.CaseCategory)</td>
                        <td>@Or(l.CaseType)</td>
                        <td>@Or(l.Court)</td>
                        <td>@Or(l.Litigants)</td>
                        <td class="report-id">@Or(l.CaseNumber)</td>
                        <td>@D(l.LastHearingDate)</td>
                        <td>@(l.Source == LitigationSource.DataLake ? "Data Lake" : "ROC Report")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

<nav class="mca-contents-nav" id="contents-nav-litigation" aria-label="Litigation contents">
    <span class="mca-contents-label" aria-hidden="true">CONTENTS</span>
    <ul class="nav mca-contents-links">
        <li class="nav-item"><a class="nav-link active" href="#sec-litigation-summary">Summary</a></li>
        <li class="nav-item"><a class="nav-link" href="#sec-litigation-cases">Cases <span class="badge">@(lake?.AuthoritativeSnapshot is not null ? lake.TotalCaseCount : confirmed.Count)</span></a></li>
        <li class="nav-item"><a class="nav-link" href="#sec-litigation-financial-disputes">Financial Disputes <span class="badge">@Model.FinancialDisputeCases.Count</span></a></li>
    </ul>
</nav>

<section class="mca-contents-section" id="sec-litigation-summary" aria-labelledby="head-litigation-summary" tabindex="-1">
<h3 class="visually-hidden" id="head-litigation-summary">Summary</h3>
@if (lake is not null)
{
    var hasReport = lake.AuthoritativeSnapshot is not null;
    var isRefresh = hasReport && lake.Refresh.HasSearched;
    var searchRunning = lake.SearchJob is { IsTerminal: false } || lake.ImportState == SnapshotImportState.InProgress;
    var refreshBlocked = isRefresh && !lake.Refresh.Allowed;
    <!-- Litigation: live court records, reports, AI analysis and refresh (client-facing) -->
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h3 class="mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-bank text-primary"></i>Litigation
                @if (lake.IsReusedReport)
                {
                    <span class="badge bg-info text-dark fs-6"><i class="bi bi-recycle me-1"></i>Reused Report</span>
                }
            </h3>
            <p class="text-muted small mb-0">
                Court records, case orders and evidence-grounded AI analysis.
                @if (hasReport)
                {
                    <span>Data retrieved @Ist.Format(lake.AuthoritativeSnapshot!.RetrievedUtc).</span>
                }
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (hasReport)
            {
                <div class="btn-group btn-group-sm" role="group" aria-label="Report before AI analysis">
                    <a href="/Requests/@reqId/Litigation/Report/pdf" class="btn btn-outline-danger" title="Case data only, no AI analysis"><i class="bi bi-file-earmark-pdf me-1"></i>Report (PDF)</a>
                    <a href="/Requests/@reqId/Litigation/Report/csv" class="btn btn-outline-success" title="Case register only, no AI analysis"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Report (CSV)</a>
                </div>
                @if (lake.HasCompletedAnalysis)
                {
                    <div class="btn-group btn-group-sm" role="group" aria-label="Report with AI analysis">
                        <a href="/Requests/@reqId/Litigation/Report/pdf?withAnalysis=true" class="btn btn-outline-danger" title="Includes the AI analysis"><i class="bi bi-stars me-1"></i>With AI (PDF)</a>
                        <a href="/Requests/@reqId/Litigation/Report/csv?withAnalysis=true" class="btn btn-outline-success" title="Includes the AI analysis"><i class="bi bi-stars me-1"></i>With AI (CSV)</a>
                    </div>
                }
                <a href="/Requests/@reqId/Litigation/OrdersZip" class="btn btn-sm btn-outline-secondary" title="Download all retained order PDFs as a ZIP archive">
                    <i class="bi bi-file-earmark-zip me-1"></i>All Orders (ZIP)
                </a>
                <button type="button" id="litigation-run-analysis" class="btn btn-sm btn-primary"
                        disabled="@(lake.AnalysisInProgress || !lake.NeedsAnalysis || searchRunning)"
                        title="@(lake.AnalysisInProgress ? "Analysis is running" : !lake.NeedsAnalysis ? "All cases are already analysed and nothing has changed" : "Run evidence-grounded AI analysis on new or changed cases")">
                    <i class="bi bi-stars me-1"></i>@(lake.AnalysisInProgress ? "Analysing…" : lake.HasCompletedAnalysis ? "Re-run AI Analysis" : "Run AI Analysis")
                </button>
            }
            @if (lake.SearchJob is not null || hasReport)
            {
                <form method="post" action="/Requests/@reqId/Litigation/Search" class="d-inline" id="litigation-refresh-form"
                      onsubmit="return confirm('@(hasReport ? "This refresh is chargeable. " : "")Refresh litigation data? This uses one of your @lake.Refresh.Max refreshes.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="confirmChargeableRefresh" value="true" />
                    <button type="submit" class="btn btn-sm btn-outline-primary" disabled="@(searchRunning || refreshBlocked)"
                            title="@(refreshBlocked ? lake.Refresh.Reason : $"Fetch fresh court records. {lake.Refresh.Remaining} of {lake.Refresh.Max} refreshes left.")">
                        <i class="bi bi-arrow-repeat me-1"></i>Refresh data
                    </button>
                </form>
            }
        </div>
    </div>
    @if (isRefresh)
    {
        <p class="small text-muted mb-3" id="litigation-refresh-note">
            <i class="bi bi-arrow-repeat me-1"></i>@lake.Refresh.Remaining of @lake.Refresh.Max refreshes remaining.
            @if (lake.Refresh.Remaining > 0)
            {
                @if (lake.Refresh.NextAllowedUtc is { } nextAt && nextAt > DateTime.UtcNow)
                {
                    <span>Next refresh available @Ist.Date(nextAt).</span>
                }
                else
                {
                    <span>You can refresh now; refreshes must be at least @lake.RefreshIntervalDays days apart.</span>
                }
            }
        </p>
    }
    <form id="litigation-analysis-token" class="d-none">@Html.AntiForgeryToken()</form>
    <div id="litigation-action-message" class="alert alert-secondary py-2 px-3 small d-none" role="status"></div>

    @* Charged property vs cases. Only Strong links are shown; silence is explained, never presented as "clean". *@
    @if (Model.ChargeLitigation is { } chl)
    {
        if (chl.HasAny)
        {
            <div class="alert alert-danger small mb-4" id="charge-litigation-banner" role="alert">
                <div class="fw-semibold mb-1"><i class="bi bi-bank me-1"></i>Litigation touches charged property or a charge holder's recovery proceedings</div>
                <div class="mb-2">
                    @chl.CasesNamingAssets case@(chl.CasesNamingAssets == 1 ? "" : "s") name property or assets charged to a lender ·
                    @chl.CasesFor(ChargeLitigationSignal.LenderRecoveryCase) recovery proceeding@(chl.CasesFor(ChargeLitigationSignal.LenderRecoveryCase) == 1 ? "" : "s") involve a charge holder.
                </div>
                <ul class="mb-2 ps-3">
                    @foreach (var l in chl.Links.Take(8))
                    {
                        <li>
                            <strong>@l.ChargeNumber</strong> (@l.ChargeHolder):
                            @(string.IsNullOrWhiteSpace(l.Case.CaseNumber) ? "case" : l.Case.CaseNumber)@(string.IsNullOrWhiteSpace(l.Case.Court) ? "" : " · " + l.Case.Court) —
                            @ChargeLitigationLabels.Phrase(l.Signal)
                            @if (l.Case.LitigationCaseId is { } cid) { <a href="#case-card-@cid">view case</a> }
                        </li>
                    }
                    @if (chl.Links.Count > 8) { <li>…and @(chl.Links.Count - 8) more, in the Charges tab.</li> }
                </ul>
                <div class="text-muted">Only strong matches are shown. @(chl.NcltOrdersSkipped ? "NCLT/NCLAT orders are not scanned. " : "")@(chl.OrdersWithoutText > 0 ? $"{chl.OrdersWithoutText} order(s) had no extractable text and could not be compared. " : "")@(chl.MovableChargesWithoutIdentifiers > 0 ? $"{chl.MovableChargesWithoutIdentifiers} movable-asset charge(s) name no vehicle or serial numbers, so could not be compared." : "")</div>
            </div>
        }
        else if (chl.CasesScanned > 0)
        {
            <p class="small text-muted mb-3" id="charge-litigation-none">
                <i class="bi bi-bank me-1"></i>Charged-property check: no case was tied to a charged property or charge holder.
                @chl.OrdersScanned order(s) with text were compared@(chl.OrdersWithoutText > 0 ? $"; {chl.OrdersWithoutText} had no extractable text" : "")@(chl.NcltOrdersSkipped ? "; NCLT/NCLAT orders are not scanned" : "").
                Charges that name no specific property or asset cannot be compared@(chl.MovableChargesWithoutIdentifiers > 0 ? $" ({chl.MovableChargesWithoutIdentifiers} movable-asset charge(s) name no vehicle or serial numbers)" : "").
            </p>
        }
    }

    <!-- Search Status / Attempt Banners -->
    @if (lake.SearchJob is null)
    {
        <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-4">
            <div>
                <i class="bi bi-info-circle-fill me-2"></i>
                <span>The litigation search for this request has not started yet. It begins automatically once the request is ready; you can also start it now.</span>
            </div>
            <form method="post" action="/Requests/@reqId/Litigation/Search">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-primary">Run Search Now</button>
            </form>
        </div>
    }
    else
    {
        @if (lake.IsCurrentAttemptFailed)
        {
            <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 mb-4" role="alert">
                <div>
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                    <strong>Search Attempt Failed:</strong>
                    <span>@(lake.SearchJob.FailureReason ?? lake.CurrentAttemptSnapshot?.FailureReason ?? (lake.ImportState == SnapshotImportState.SnapshotMissing ? "Search completed but report snapshot was missing." : "Search job encountered an error."))</span>
                </div>
                <form method="post" action="/Requests/@Model.Request.RequestId/Litigation/Search"
                      onsubmit="@(hasReport ? "return confirm('This refresh is chargeable. Rerun the litigation search?');" : "return true;")">
                    @Html.AntiForgeryToken()
                    @if (hasReport)
                    {
                        <input type="hidden" name="confirmChargeableRefresh" value="true" />
                    }
                    <button type="submit" class="btn btn-sm btn-outline-danger">Rerun Search</button>
                </form>
            </div>
        }
        else if (!lake.SearchJob.IsTerminal || lake.ImportState == SnapshotImportState.InProgress)
        {
            <div class="alert alert-info p-3 mb-4 shadow-sm" id="litigation-search-progress-banner">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span>
                        <strong>Litigation Search In Progress:</strong>
                        <span id="litigation-progress-message">@(lake.SearchJob.StatusMessage ?? "Searching court records...")</span>
                    </div>
                    <span class="badge bg-primary" id="litigation-progress-percent">@(lake.SearchJob.ProgressPercent)%</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" id="litigation-progress-bar" style="width: @(lake.SearchJob.ProgressPercent)%;"></div>
                </div>
                <small class="text-muted mt-2 d-block">Status: @lake.SearchJob.Status &bull; Import: @lake.ImportState. Auto-refreshing every 3 seconds...</small>
            </div>

            <script>
                (function() {
                    var pollInterval = setInterval(function() {
                        fetch('/Requests/@Model.Request.RequestId/Litigation/Status')
                            .then(function(res) { return res.json(); })
                            .then(function(data) {
                                if (data.progressPercent !== undefined) {
                                    var pBar = document.getElementById('litigation-progress-bar');
                                    var pText = document.getElementById('litigation-progress-percent');
                                    var pMsg = document.getElementById('litigation-progress-message');
                                    if (pBar) pBar.style.width = data.progressPercent + '%';
                                    if (pText) pText.innerText = data.progressPercent + '%';
                                    if (pMsg && data.statusMessage) pMsg.innerText = data.statusMessage;
                                }
                                if (data.isTerminal) {
                                    clearInterval(pollInterval);
                                    location.reload();
                                }
                            })
                            .catch(function(err) {
                                console.warn('Polling status failed:', err);
                            });
                    }, 3000);
                })();
            </script>
        }

        @if (lake.IsPriorRunDataShown && lake.AuthoritativeSnapshot is not null)
        {
            <div class="alert alert-warning py-2 px-3 mb-4 d-flex align-items-center gap-2 small">
                <i class="bi bi-clock-history text-warning fs-5"></i>
                <div>
                    <strong>Prior Search Results Displayed:</strong>
                    <span>Showing snapshot data retrieved @Ist.Format(lake.AuthoritativeSnapshot.RetrievedUtc). The most recent search attempt is currently active or failed. Final coverage and reconciliation claims reflect the prior run.</span>
                </div>
            </div>
        }

        @if (lake.IsReusedReport && lake.AuthoritativeSnapshot is not null)
        {
            <div class="alert alert-info py-2 px-3 mb-4 d-flex align-items-center justify-content-between gap-3 shadow-sm border-info" role="alert" id="litigation-reuse-provenance-banner">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-recycle fs-4 text-info"></i>
                    <div>
                        <div class="fw-semibold">Report retrieved @Ist.Date(lake.AuthoritativeSnapshot.RetrievedUtc) — reused from another request</div>
                        <div class="small text-muted">
                            Data originated from @(lake.ReusedFromRequestNumber is not null ? $"request #{lake.ReusedFromRequestNumber}" : $"request #{lake.AuthoritativeSnapshot.ReusedFromRequestId}") (snapshot #@lake.AuthoritativeSnapshot.ReusedFromSnapshotId), originally retrieved on @Ist.Date(lake.AuthoritativeSnapshot.RetrievedUtc). It satisfied the &le; 7-day eligibility limit when reused; the 7-day bound governed reuse admission, not an ongoing freshness guarantee. Reused with zero new vendor spend.
                        </div>
                    </div>
                </div>
                <span class="badge bg-info text-dark text-nowrap"><i class="bi bi-recycle me-1"></i>Reused Report</span>
            </div>
        }
    }

    @if (lake.AuthoritativeSnapshot is not null && lake.RiskProfile.TotalCases > 0)
    {
        <!-- Risk tiers across the report (baseline from the court record) -->
        <div class="card mb-4 shadow-sm border" id="litigation-risk-profile">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                <h5 class="card-title mb-0 small fw-bold text-uppercase"><i class="bi bi-shield-exclamation me-2 text-primary"></i>Litigation Risk</h5>
                <span class="badge @LitigationBaselineRisk.BadgeCss(lake.RiskProfile.Overall) fs-6" data-risk-overall="@lake.RiskProfile.Overall">@lake.RiskProfile.Overall · @LitigationBaselineRisk.Label(lake.RiskProfile.Overall)</span>
            </div>
            <div class="card-body">
                <div class="mca-highlight-grid">
                    @foreach (var tier in new[] { LitigationRiskTier.R3, LitigationRiskTier.R2, LitigationRiskTier.R1, LitigationRiskTier.R0 })
                    {
                        <div class="pi-metric">
                            <span>@tier · @LitigationBaselineRisk.Label(tier)</span>
                            <strong>@lake.RiskProfile.Cases[tier]</strong>
                        </div>
                    }
                </div>
                @foreach (var tier in new[] { LitigationRiskTier.R3, LitigationRiskTier.R2 })
                {
                    var triggers = lake.RiskProfile.TriggersOf(tier);
                    if (triggers.Count == 0) { continue; }
                    <p class="small mb-1 mt-3"><strong>@tier</strong> — @string.Join("; ", triggers.Select(t => $"{t.Trigger} × {t.Count}"))</p>
                }
                <p class="small text-muted mb-0 mt-2">The overall tier is the highest of the cases'. Each case's tier is a baseline worked out from its court record: forum, case type, act, status and the company's side.</p>
            </div>
        </div>
    }

    @if (lake.AuthoritativeSnapshot is not null && lake.AgeProfile.PendingCases > 0)
    {
        <!-- Ageing of pending cases (as of the day the data was retrieved) -->
        <div class="card mb-4 shadow-sm border" id="litigation-age-profile">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
                <h5 class="card-title mb-0 small fw-bold text-uppercase"><i class="bi bi-hourglass-split me-2 text-primary"></i>Pending Cases by Age</h5>
                @if (lake.AgeAsOf is { } ageAsOf)
                {
                    <span class="text-muted small">As of @ageAsOf.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) (data retrieval date)</span>
                }
            </div>
            <div class="card-body">
                <div class="mca-highlight-grid">
                    @foreach (var band in Enum.GetValues<CaseAgeBand>())
                    {
                        <div class="pi-metric">
                            <span>@LitigationCaseAges.Label(band)</span>
                            <strong>@lake.AgeProfile.PendingByBand[band]</strong>
                        </div>
                    }
                </div>
                @if (lake.AgeProfile.OldestPending is { } oldest)
                {
                    <p class="small mb-0 mt-3">
                        <span class="text-muted">Oldest pending case:</span>
                        <strong>@oldest.Duration</strong>
                        <span class="text-muted">(@oldest.BasisNote)</span>
                        @if (lake.AgeProfile.OldestPendingCaseId is { } oldestId)
                        {
                            <a href="#case-card-@oldestId" class="ms-1">view case</a>
                        }
                    </p>
                }
                <p class="small text-muted mb-0 mt-2">Age runs from the filing date on the court record. Where there is none, it is "at least" the time since the earliest order on file, and a case with only a registration year has no age computed.</p>
            </div>
        </div>
    }

    <!-- Court Summary Grid -->
    <div class="card mb-4 shadow-sm border">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 px-3">
            <h5 class="card-title mb-0 small fw-bold text-uppercase">
                <i class="bi bi-grid-3x3 me-2 text-primary"></i>Court Summary Grid
            </h5>
            @if (lake.CourtSummaryGrid.IsReconciled)
            {
                <span class="badge bg-success">
                    <i class="bi bi-check-circle me-1"></i>Reconciled (Total = Pending + Disposed + Unknown)
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i>Reconciliation Mismatch
                </span>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 small align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Court Name</th>
                            <th>Category</th>
                            <th class="text-end">Total Cases</th>
                            <th class="text-end">Pending</th>
                            <th class="text-end">Disposed</th>
                            <th class="text-end">Unknown / Other</th>
                            <th class="text-end">Total Orders</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lake.CourtSummaryGrid.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">No court records indexed in authoritative snapshot.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in lake.CourtSummaryGrid.Rows)
                            {
                                <tr>
                                    <td>
                                        <a href="?court=@Uri.EscapeDataString(r.CourtName)" class="text-decoration-none fw-semibold">
                                            @r.CourtName
                                        </a>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@(r.CourtCategory ?? "Unspecified")</span></td>
                                    <td class="text-end fw-bold">@r.TotalCases</td>
                                    <td class="text-end text-warning-emphasis">@r.PendingCases</td>
                                    <td class="text-end text-success">@r.DisposedCases</td>
                                    <td class="text-end text-secondary">@r.UnknownCases</td>
                                    <td class="text-end">@r.TotalOrders</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>Total Portfolio Reconciled</td>
                            <td>—</td>
                            <td class="text-end">@lake.CourtSummaryGrid.TotalCases</td>
                            <td class="text-end text-warning-emphasis">@lake.CourtSummaryGrid.TotalPendingCases</td>
                            <td class="text-end text-success">@lake.CourtSummaryGrid.TotalDisposedCases</td>
                            <td class="text-end text-secondary">@lake.CourtSummaryGrid.TotalUnknownCases</td>
                            <td class="text-end">@lake.CourtSummaryGrid.TotalOrders</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Source Coverage & Audit Provenance -->
    <div class="card mb-4 shadow-sm border">
        <div class="card-header bg-light py-2 px-3">
            <h5 class="card-title mb-0 small fw-bold text-uppercase">
                <i class="bi bi-shield-check me-2 text-primary"></i>Source Coverage &amp; Provenance
            </h5>
        </div>
        <div class="card-body">
            <p class="mb-3 text-dark">@lake.SourceCoverage.CoverageSummaryText</p>

            <div class="row g-2 mb-3 text-center">
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="text-muted small">Unique Proceedings</div>
                        <div class="fs-5 fw-bold">@lake.SourceCoverage.UniqueCasesCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="text-muted small">Total Observations</div>
                        <div class="fs-5 fw-bold">@lake.SourceCoverage.TotalObservationsCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="text-muted small">Downloaded Orders</div>
                        <div class="fs-5 fw-bold text-success">@lake.SourceCoverage.DownloadedOrders / @lake.SourceCoverage.TotalOrders</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-2 border rounded bg-light">
                        <div class="text-muted small">Expired Order URLs</div>
                        <div class="fs-5 fw-bold text-danger">@lake.SourceCoverage.ExpiredOrders</div>
                    </div>
                </div>
            </div>

            @if (lake.SourceCoverage.Keywords.Count > 0)
            {
                <div class="mb-3">
                    <div class="small fw-bold text-muted mb-1">Approved Keywords Submitted (@lake.SourceCoverage.Keywords.Count):</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var kw in lake.SourceCoverage.Keywords)
                        {
                            <span class="badge bg-light text-dark border" title="Source: @kw.Source">
                                @kw.Value <small class="text-muted">(@kw.Source)</small>
                            </span>
                        }
                    </div>
                </div>
            }

            <div class="small text-muted border-top pt-2 mt-2">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Order availability:</strong> Some court orders can only be downloaded for a limited time after each search. Orders marked expired are renewed when you refresh the litigation data.
            </div>
        </div>
    </div>

    <!-- Portfolio AI Synthesis (if available) -->
    @if (lake.PortfolioAnalysis is not null)
    {
        <div class="card mb-4 shadow-sm border border-primary-subtle">
            <div class="card-header bg-primary text-white py-2 px-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 small fw-bold text-uppercase">
                    <i class="bi bi-stars me-2"></i>Portfolio Legal Risk Synthesis (Gemini AI)
                </h5>
                <span class="badge bg-white text-primary">@lake.PortfolioAnalysis.Status</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(lake.PortfolioAnalysis.Summary))
                {
                    <p class="mb-3">@lake.PortfolioAnalysis.Summary</p>
                }

                @if (lake.PortfolioAnalysis.Unknowns.Count > 0)
                {
                    <div class="small fw-bold text-muted mb-1">Portfolio Information Gaps / Unknowns:</div>
                    <ul class="mb-0 ps-3 small text-muted">
                        @foreach (var u in lake.PortfolioAnalysis.Unknowns)
                        {
                            <li>@u</li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer bg-light py-1 px-3 text-muted small" style="font-size: 0.8rem;">
                Run #@lake.PortfolioAnalysis.RunNumber &bull; Completed @Ist.Format(lake.PortfolioAnalysis.CompletedUtc)
            </div>
        </div>
    }

}
@if (lake?.AuthoritativeSnapshot is null)
{
    <!-- Workbook summary: shown until live court records are available. Confirmed matches only. -->
    @if (Model.LitigationCount == 0)
    {
        <div class="mca-empty"><i class="bi bi-bank"></i><p>@Model.SheetCoverage.EmptyState("No litigation was matched to this entity.", SheetAliases.LegalHistory)</p></div>
    }
    else
    {
        <div class="mca-highlight-grid">
            <div class="pi-metric">
                <span>Total Litigations</span>
                <strong>@confirmed.Count</strong>
                <small>confirmed matches only</small>
            </div>
            <div class="pi-metric">
                <span>Confirmed Cases</span>
                <strong>@confirmed.Count</strong>
                <small>@confirmed.Count(IsPendingRow) pending · @confirmed.Count(l => !IsPendingRow(l)) disposed</small>
            </div>
            <div class="pi-metric">
                <span>Filed Against Company</span>
                <strong>@Model.LitigationFiledAgainstCount</strong>
                <small>from Phase 3 rule attribution</small>
            </div>
            <div class="pi-metric">
                <span>Filed By Company</span>
                <strong>@Model.LitigationFiledByCount</strong>
                <small>company as petitioner</small>
            </div>
        </div>
    }

    @await Html.PartialAsync("~/Views/Requests/Details/_KeyIndicators.cshtml", Model.KeyMetrics.Where(g => g.Title == "Legal history").ToList())

    @if (workbookCats.Count > 0)
    {
        <div class="mca-section" style="margin-top:22px;">
            <h4>By Category</h4>
            <div class="pi-table-wrap">
                <table class="pi-results-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="text-end">Total Cases</th>
                            <th class="text-end">Pending</th>
                            <th class="text-end">Disposed</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var g in workbookCats)
                    {
                        var pending = g.Count(IsPendingRow);
                        <tr>
                            <td><strong>@g.Key</strong></td>
                            <td class="text-end">@g.Count()</td>
                            <td class="text-end">@pending</td>
                            <td class="text-end">@(g.Count() - pending)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
</section>

<section class="mca-contents-section" id="sec-litigation-cases" aria-labelledby="head-litigation-cases" tabindex="-1">
<h3 class="visually-hidden" id="head-litigation-cases">Cases</h3>
@if (showWorkbookFallback)
{
    <p class="text-muted small">Confirmed cases reported in the ingested MCA workbook. Live court records appear here once the litigation search completes.</p>
    RenderCasesTable(confirmed);
}
@if (lake is not null)
{
    <!-- Filter Bar & Case Cards Container -->
    <div class="card mb-4 shadow-sm border">
        <div class="card-header bg-light py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <h5 class="card-title mb-0 small fw-bold text-uppercase">
                    <i class="bi bi-collection me-1 text-primary"></i>Case Cards
                </h5>
                <span class="badge bg-secondary">Showing @lake.Cases.Count of @lake.TotalCaseCount</span>
            </div>
            <div>
                <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="text" name="court" class="form-control form-control-sm" style="max-width: 180px;" placeholder="Filter Court..." value="@Context.Request.Query["court"]" />
                    <select name="status" class="form-select form-select-sm" style="max-width: 130px;">
                        <option value="">All Statuses</option>
                        <option value="Pending" selected="@(Context.Request.Query["status"] == "Pending")">Pending</option>
                        <option value="Disposed" selected="@(Context.Request.Query["status"] == "Disposed")">Disposed</option>
                        <option value="Unknown" selected="@(Context.Request.Query["status"] == "Unknown")">Unknown</option>
                    </select>
                    <select name="outcome" class="form-select form-select-sm" style="max-width: 170px;">
                        <option value="">All Outcomes</option>
                        @foreach (var opt in Enum.GetValues<LitigationOrderOutcome>())
                        {
                            var optStr = opt.ToString();
                            var count = lake.OutcomeCounts.GetValueOrDefault(opt, 0);
                            <option value="@optStr" selected="@(string.Equals(Context.Request.Query["outcome"], optStr, StringComparison.OrdinalIgnoreCase))">
                                @LitigationOrderOutcomeLabels.Format(opt) (@count)
                            </option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
                    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["court"]) || !string.IsNullOrWhiteSpace(Context.Request.Query["status"]) || !string.IsNullOrWhiteSpace(Context.Request.Query["outcome"]))
                    {
                        <a href="/Requests/@Model.Request.RequestId" class="btn btn-sm btn-outline-secondary">Clear</a>
                    }
                </form>
            </div>
        </div>
        <div class="card-body p-3">
            @if (lake.OutcomeCounts.Count > 0 || lake.TotalClassifiedOrdersCount > 0)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-2 border-bottom" id="litigation-outcome-chips">
                    <span class="small fw-bold text-muted text-uppercase me-1"><i class="bi bi-funnel me-1"></i>Order Outcomes:</span>
                    <a href="?court=@Uri.EscapeDataString(Context.Request.Query["court"].ToString())&status=@Uri.EscapeDataString(Context.Request.Query["status"].ToString())"
                       class="badge text-decoration-none @(string.IsNullOrWhiteSpace(Context.Request.Query["outcome"]) ? "bg-primary text-white" : "bg-light text-dark border") py-2 px-2">
                        All Outcomes (@lake.TotalClassifiedOrdersCount)
                    </a>
                    @foreach (var outcomeEntry in Enum.GetValues<LitigationOrderOutcome>())
                    {
                        var count = lake.OutcomeCounts.GetValueOrDefault(outcomeEntry, 0);
                        if (count > 0 || string.Equals(Context.Request.Query["outcome"], outcomeEntry.ToString(), StringComparison.OrdinalIgnoreCase))
                        {
                            var isSelected = string.Equals(Context.Request.Query["outcome"], outcomeEntry.ToString(), StringComparison.OrdinalIgnoreCase);
                            <a href="?outcome=@outcomeEntry&court=@Uri.EscapeDataString(Context.Request.Query["court"].ToString())&status=@Uri.EscapeDataString(Context.Request.Query["status"].ToString())"
                               class="badge text-decoration-none @(isSelected ? "bg-primary text-white shadow-sm" : LitigationOrderOutcomeLabels.BadgeCss(outcomeEntry)) py-2 px-2"
                               title="@LitigationOrderOutcomeLabels.Format(outcomeEntry)">
                                <i class="bi @LitigationOrderOutcomeLabels.IconCss(outcomeEntry) me-1"></i>@LitigationOrderOutcomeLabels.Format(outcomeEntry) (@count)
                            </a>
                        }
                    }
                </div>
            }
            @if (lake.Cases.Count == 0)
            {
                <div class="text-muted p-4 text-center border rounded bg-light">
                    <i class="bi bi-folder2-open fs-3 d-block mb-2 text-secondary"></i>
                    No litigation case records match the selected filter.
                </div>
            }
            else
            {
                @foreach (var c in lake.Cases)
                {
                    @await Html.PartialAsync("~/Views/Requests/Details/_LitigationCaseCard.cshtml", c, new ViewDataDictionary(ViewData) { { "RequestId", Model.Request.RequestId }, { "ChargeLinks", Model.ChargeLitigation?.Links.Where(l => l.Case.LitigationCaseId == c.LitigationCaseId).ToList() } })
                }

                @if (lake.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="text-muted small">
                            Page @lake.CurrentPage of @lake.TotalPages (@lake.TotalCaseCount total cases)
                        </span>
                        <div class="btn-group btn-group-sm">
                            @if (lake.CurrentPage > 1)
                            {
                                <a href="?page=@(lake.CurrentPage - 1)&court=@Uri.EscapeDataString(Context.Request.Query["court"].ToString())&status=@Uri.EscapeDataString(Context.Request.Query["status"].ToString())&outcome=@Uri.EscapeDataString(Context.Request.Query["outcome"].ToString())" class="btn btn-outline-secondary">Previous</a>
                            }
                            @for (int p = 1; p <= lake.TotalPages; p++)
                            {
                                if (p == lake.CurrentPage)
                                {
                                    <span class="btn btn-primary active">@p</span>
                                }
                                else if (p <= 5 || p > lake.TotalPages - 2 || Math.Abs(p - lake.CurrentPage) <= 1)
                                {
                                    <a href="?page=@p&court=@Uri.EscapeDataString(Context.Request.Query["court"].ToString())&status=@Uri.EscapeDataString(Context.Request.Query["status"].ToString())&outcome=@Uri.EscapeDataString(Context.Request.Query["outcome"].ToString())" class="btn btn-outline-secondary">@p</a>
                                }
                            }
                            @if (lake.CurrentPage < lake.TotalPages)
                            {
                                <a href="?page=@(lake.CurrentPage + 1)&court=@Uri.EscapeDataString(Context.Request.Query["court"].ToString())&status=@Uri.EscapeDataString(Context.Request.Query["status"].ToString())&outcome=@Uri.EscapeDataString(Context.Request.Query["outcome"].ToString())" class="btn btn-outline-secondary">Next</a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

</section>

@if (lake is not null)
{
    <script>
        (function () {
            var reqId = @reqIdJs;
            var btn = document.getElementById('litigation-run-analysis');
            var tokenInput = document.querySelector('#litigation-analysis-token input[name="__RequestVerificationToken"]');
            var msg = document.getElementById('litigation-action-message');
            function say(text) { if (!msg) return; msg.textContent = text; msg.classList.remove('d-none'); }
            function poll() {
                var t = setInterval(function () {
                    fetch('/Requests/' + reqId + '/Litigation/Analysis', { headers: { 'Accept': 'application/json' } })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (d) {
                            if (d && d.status !== 'Pending' && d.status !== 'InProgress') { clearInterval(t); location.reload(); }
                        }).catch(function () { });
                }, 4000);
            }
            if (btn) {
                btn.addEventListener('click', function () {
                    btn.disabled = true;
                    say('Starting AI analysis…');
                    fetch('/Requests/' + reqId + '/Litigation/Analysis', {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        body: new URLSearchParams({ __RequestVerificationToken: tokenInput ? tokenInput.value : '' })
                    })
                        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (b) { return { ok: r.ok, body: b }; }); })
                        .then(function (res) {
                            if (!res.ok) { say(res.body.error || 'AI analysis could not be started.'); return; }
                            say('AI analysis is running. This page will update when it finishes.');
                            btn.innerHTML = '<i class="bi bi-stars me-1"></i>Analysing…';
                            poll();
                        }).catch(function () { btn.disabled = false; say('AI analysis could not be started.'); });
                });
                @if (lake.AnalysisInProgress)
                {
                    <text>say('AI analysis is running. This page will update when it finishes.'); poll();</text>
                }
            }
        })();
    </script>
}

<!-- Shared Financial Disputes Section -->
<section class="mca-contents-section mt-4" id="sec-litigation-financial-disputes" aria-labelledby="head-litigation-financial-disputes" tabindex="-1">
    <h3 id="head-litigation-financial-disputes">Financial Disputes</h3>
    <p class="text-muted small">Money-claim disputes with an amount under default from the ingested MCA workbook.</p>
    @if (Model.FinancialDisputeCases.Count > 0)
    {
        <div class="pi-table-wrap">
            <table class="pi-results-table">
                <thead>
                    <tr>
                        <th>Direction</th>
                        <th>Type</th>
                        <th class="text-end">Amount Under Default</th>
                        <th>Currency</th>
                        <th>Verdict</th>
                        <th>Court</th>
                        <th>Parties</th>
                        <th>Case No.</th>
                        <th>Date of Default</th>
                        <th>Date of Judgement</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var fd in Model.FinancialDisputeCases)
                {
                    <tr>
                        <td>@Or(fd.Direction)</td>
                        <td>@Or(fd.DisputeType)</td>
                        <td class="text-end"><strong>@Num(fd.AmountUnderDefault)</strong></td>
                        <td>@Or(fd.Currency)</td>
                        <td><strong>@Or(fd.Verdict)</strong></td>
                        <td>@Or(fd.Court)</td>
                        <td>@Or(fd.Litigants)</td>
                        <td class="report-id">@Or(fd.CaseNumber)</td>
                        <td>@D(fd.DateOfDefault)</td>
                        <td>@D(fd.DateOfJudgement)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="mca-empty"><i class="bi bi-bank"></i><p>@Model.SheetCoverage.EmptyState("No financial dispute cases were reported in this workbook.", SheetAliases.LegalCasesFinancialDispute)</p></div>
    }
</section>

@functions {
    static bool IsPendingRow(Litigation l)
    {
        if (string.IsNullOrWhiteSpace(l.CaseStatus)) return false;
        var t = l.CaseStatus.ToLowerInvariant();
        return !new[] { "dispos", "clos", "resolv", "dismiss", "withdraw", "settl" }.Any(k => t.Contains(k));
    }
}
