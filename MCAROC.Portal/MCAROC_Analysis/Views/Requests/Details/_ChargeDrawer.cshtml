@model RocCharge
@{
    var c = Model;
    var events = c.Events.OrderBy(e => e.EventDate ?? DateOnly.MinValue).ThenBy(e => e.ChargeEventId).ToList();
    var creation = events.FirstOrDefault(e => e.EventType == ChargeEventType.Creation);
    var latestClassified = events.LastOrDefault(e => e.SecurityClassificationConfidence is not null
        and not ChargeClassificationConfidence.None);

    // Any event carrying raw security / instrument narrative (for the "source wording" fallback).
    var narrativeEvent = events.LastOrDefault(e =>
        e.PropertyParticulars is not null || e.ExtentAndOperation is not null ||
        e.InstrumentDescription is not null || e.OtherTerms is not null);

    string SpaceCamel(string s) => System.Text.RegularExpressions.Regex.Replace(s, "(\\B[A-Z])", " $1");

    List<string> Facilities(RocChargeEvent e)
    {
        if (string.IsNullOrWhiteSpace(e.FacilityTypesJson)) return [];
        try { return System.Text.Json.JsonSerializer.Deserialize<List<string>>(e.FacilityTypesJson) ?? []; }
        catch (System.Text.Json.JsonException) { return []; }
    }

    var conf = c.LatestSecurityConfidence ?? ChargeClassificationConfidence.None;
    var showStructured = conf is ChargeClassificationConfidence.High or ChargeClassificationConfidence.Medium;
}

<div class="mca-charge-drawer">

    @* ── A. Identity ── *@
    <div class="mca-kv">
        <div><dt>Charge ID</dt><dd class="report-id">@c.RocChargeNumber</dd></div>
        <div><dt>Charge Holder</dt><dd>@c.LatestChargeHolderRaw</dd></div>
        <div><dt>Status</dt><dd>@Or(c.ChargeStatus) @(c.SatisfactionDate is null ? "(Current)" : "(Historical)")</dd></div>
        <div><dt>Created</dt><dd>@D(c.CreationDate)</dd></div>
        <div><dt>Latest Modification</dt><dd>@D(c.LatestModificationDate)</dd></div>
        <div><dt>Satisfied</dt><dd>@D(c.SatisfactionDate)</dd></div>
        <div><dt>Registered Amount (latest)</dt><dd>@Money(c.CurrentAmount)</dd></div>
        <div><dt>Registered Amount (original)</dt><dd>@(creation?.ChargeAmount is { } oa ? Money(oa) : "not available")</dd></div>
    </div>

    @* ── B. Lifecycle ── *@
    <div class="mca-section" style="margin-top:18px;">
        <h3>Lifecycle <span class="mca-count">@events.Count event(s)</span></h3>
        <ul class="mca-timeline">
        @foreach (var e in events)
        {
            <li>
                <div class="mca-timeline-head">
                    <b>@e.EventType</b> &middot; @D(e.EventDate)
                    @if (e.ChargeAmount is { } amt) { <span>&middot; @Money(amt)</span> }
                    @if (!string.IsNullOrWhiteSpace(e.SerialNumber)) { <span class="text-muted">&middot; SRN-ref @e.SerialNumber</span> }
                </div>
                @if (!string.IsNullOrWhiteSpace(e.ModificationParticulars))
                {
                    <div class="text-muted">@e.ModificationParticulars</div>
                }
            </li>
        }
        </ul>
        <p class="text-muted mb-0">
            Original: @(creation?.ChargeAmount is { } o ? Money(o) : "not available") ·
            Latest: @Money(c.CurrentAmount) ·
            Registered Charge Enhancement:
            @{
                var enh = (creation?.ChargeAmount is { } oo && c.CurrentAmount is { } ll)
                    ? (decimal?)(ll - oo) : null;
            }
            @(enh is { } d ? $"{Money(d)}{(creation!.ChargeAmount!.Value != 0 ? $" ({d / creation.ChargeAmount.Value * 100:0.#}%)" : "")}" : "Not available")
        </p>
    </div>

    @* ── C. Facility / Terms ── *@
    <div class="mca-section">
        <h3>Facility &amp; Terms</h3>
        @{
            var facEvent = latestClassified ?? narrativeEvent;
            var facs = facEvent is not null ? Facilities(facEvent) : new List<string>();
        }
        @if (facs.Count > 0)
        {
            <p>@foreach (var f in facs) { <span class="mca-badge">@SpaceCamel(f)</span> }</p>
        }
        <div class="mca-kv">
            <div><dt>Rate / Commission</dt><dd>@Or(narrativeEvent?.RateOfInterest)</dd></div>
            <div><dt>Repayment</dt><dd>@Or(narrativeEvent?.TermsOfPayment)</dd></div>
            <div><dt>Sublimit</dt><dd>not separately extracted</dd></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(narrativeEvent?.InstrumentDescription) || !string.IsNullOrWhiteSpace(narrativeEvent?.OtherTerms))
        {
            <details><summary class="mca-json-toggle">Source wording</summary>
                <div>
                    @if (!string.IsNullOrWhiteSpace(narrativeEvent?.InstrumentDescription)) { <p><b>Instrument:</b> @narrativeEvent!.InstrumentDescription</p> }
                    @if (!string.IsNullOrWhiteSpace(narrativeEvent?.OtherTerms)) { <p><b>Other terms:</b> @narrativeEvent!.OtherTerms</p> }
                </div>
            </details>
        }
    </div>

    @* ── D/E. Security Details ── *@
    <div class="mca-section">
        <h3>Security</h3>
        @{
            var components = (latestClassified?.SecurityComponents ?? new List<ChargeSecurityComponent>())
                .OrderByDescending(x => x.Confidence).ToList();
        }
        @if (showStructured && components.Count > 0)
        {
            @if (conf == ChargeClassificationConfidence.Medium)
            {
                <p class="text-muted">Derived from source wording.</p>
            }
            <div class="pi-table-wrap"><table class="pi-results-table">
                <thead><tr><th>Security</th><th>Ranking</th><th>Primary?</th><th>Derived from</th></tr></thead>
                <tbody>
                @foreach (var comp in components)
                {
                    <tr>
                        <td><span class="mca-badge">@SpaceCamel(comp.SecurityType.ToString())</span></td>
                        <td>@(comp.Ranking == ChargeRanking.Unknown ? "—" : SpaceCamel(comp.Ranking.ToString()))</td>
                        <td>@(comp.IsPrimarySecurity is null ? "—" : comp.IsPrimarySecurity.Value ? "Primary" : "Collateral")</td>
                        <td class="text-muted">@Or(comp.AssetDescriptionRaw)</td>
                    </tr>
                }
                </tbody>
            </table></div>
            @if (latestClassified?.Arrangement is { } arr && arr != ChargeArrangement.Unknown)
            {
                <p style="margin-top:10px;"><span class="mca-finding-label">Arrangement:</span> <span class="mca-badge">@SpaceCamel(arr.ToString())</span></p>
            }
        }
        else
        {
            <p class="text-muted">Could not confidently classify — see source wording below.</p>
        }

        @if (!string.IsNullOrWhiteSpace(narrativeEvent?.PropertyParticulars) || !string.IsNullOrWhiteSpace(narrativeEvent?.ExtentAndOperation))
        {
            <details open="@((showStructured && components.Count > 0) ? null : "open")">
                <summary class="mca-json-toggle">Property particulars (source wording)</summary>
                <div>
                    @if (!string.IsNullOrWhiteSpace(narrativeEvent?.PropertyParticulars)) { <p>@narrativeEvent!.PropertyParticulars</p> }
                    @if (!string.IsNullOrWhiteSpace(narrativeEvent?.ExtentAndOperation)) { <p>@narrativeEvent!.ExtentAndOperation</p> }
                </div>
            </details>
        }
        else if (narrativeEvent is null)
        {
            <p class="text-muted mb-0">No charge-report detail sheet was matched to this charge — only ROC-sequence data is available.</p>
        }
    </div>

</div>
