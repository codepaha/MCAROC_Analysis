@model ChargeDrawerViewModel
@using MCAROC_Analysis.Services.Analysis
@using MCAROC_Analysis.Services.Analysis.Rules
@using MCAROC_Analysis.Services.Excel.Parsers
@using MCAROC_Analysis.Services.PropertyParticulars
@{
    var c = Model.Charge;
    var events = c.Events.OrderBy(e => e.EventDate ?? DateOnly.MinValue).ThenBy(e => e.ChargeEventId).ToList();
    var creation = events.FirstOrDefault(e => e.EventType == ChargeEventType.Creation);
    var latestClassified = events.LastOrDefault(e => e.SecurityClassificationConfidence is not null
        and not ChargeClassificationConfidence.None);
    var isSatisfied = c.SatisfactionDate is not null;

    // Modification comparison baseline/target (§2d-G).
    RocChargeEvent? compareTarget = isSatisfied
        ? events.LastOrDefault(e => e.EventType == ChargeEventType.Modification)
        : events.LastOrDefault(e => e.EventType != ChargeEventType.Creation);

    // Any event carrying raw security / instrument narrative (for the "source wording" fallback).
    var narrativeEvent = events.LastOrDefault(e =>
        e.PropertyParticulars is not null || e.ExtentAndOperation is not null ||
        e.InstrumentDescription is not null || e.OtherTerms is not null ||
        e.RateOfInterest is not null || e.TermsOfPayment is not null);

    string SpaceCamel(string s) => System.Text.RegularExpressions.Regex.Replace(s, "(\\B[A-Z])", " $1");

    List<string> Facilities(RocChargeEvent e)
    {
        if (string.IsNullOrWhiteSpace(e.FacilityTypesJson)) return [];
        try { return System.Text.Json.JsonSerializer.Deserialize<List<string>>(e.FacilityTypesJson) ?? []; }
        catch (System.Text.Json.JsonException) { return []; }
    }

    var conf = c.LatestSecurityConfidence ?? ChargeClassificationConfidence.None;
    var showStructured = conf is ChargeClassificationConfidence.High or ChargeClassificationConfidence.Medium;
}

<div class="mca-charge-drawer">

    @* ── A. Identity ── *@
    <div class="mca-kv">
        <div><dt>Charge ID</dt><dd class="report-id">@c.RocChargeNumber</dd></div>
        <div><dt>Charge Holder</dt><dd>@(string.IsNullOrWhiteSpace(c.LatestChargeHolderRaw) ? Html.Raw("<span class=\"mca-badge sev-watch\">Unknown Charge Holder</span>") : Html.Raw(System.Net.WebUtility.HtmlEncode(c.LatestChargeHolderRaw)))</dd></div>
        <div><dt>Status</dt><dd>@Or(c.ChargeStatus) @(c.SatisfactionDate is null ? "(Current / Open)" : "(Historical / Satisfied)")</dd></div>
        <div><dt>Property Type</dt><dd>@Or(narrativeEvent?.PropertyType ?? creation?.PropertyType)</dd></div>
        <div><dt>No. of Holders</dt><dd>@(narrativeEvent?.NumberOfHolders?.ToString() ?? creation?.NumberOfHolders?.ToString() ?? "not available")</dd></div>
        <div>
            <dt>Holding Arrangement</dt>
            <dd>
                @if (narrativeEvent?.ConsortiumHolding == true || creation?.ConsortiumHolding == true)
                {
                    <span class="mca-badge">Consortium Holding</span>
                }
                else if (narrativeEvent?.JointHolding == true || creation?.JointHolding == true)
                {
                    <span class="mca-badge">Joint Holding</span>
                }
                else if ((narrativeEvent?.ConsortiumHolding == false && narrativeEvent?.JointHolding == false) ||
                         (creation?.ConsortiumHolding == false && creation?.JointHolding == false))
                {
                    <text>Sole / Direct</text>
                }
                else
                {
                    <span class="text-muted">not available</span>
                }
            </dd>
        </div>
        <div><dt>Created</dt><dd>@D(c.CreationDate)</dd></div>
        <div><dt>Latest Modification</dt><dd>@D(c.LatestModificationDate)</dd></div>
        <div><dt>Satisfied</dt><dd>@D(c.SatisfactionDate)</dd></div>
        <div><dt>Registered Amount (latest)</dt><dd><partial name="Details/_Amount" model="new AmountViewModel(c.CurrentAmount)" /></dd></div>
        <div><dt>Registered Amount (original)</dt><dd>@if (creation?.ChargeAmount is { } oa) { <partial name="Details/_Amount" model="new AmountViewModel(oa)" /> } else { <text>not available</text> }</dd></div>
    </div>

    @* ── B. Lifecycle ── *@
    <div class="mca-section" style="margin-top:18px;">
        <h3>Lifecycle <span class="mca-count">@events.Count event(s)</span></h3>
        <ul class="mca-timeline">
        @foreach (var e in events)
        {
            <li>
                <div class="mca-timeline-head">
                    <b>@e.EventType</b> &middot; Event: @D(e.EventDate)
                    @if (e.FilingDate is not null) { <span class="text-muted">&middot; Filing: @D(e.FilingDate)</span> }
                    @if (e.ChargeAmount is { } amt) { <span>&middot; <partial name="Details/_Amount" model="new AmountViewModel(amt)" /></span> }
                    @if (!string.IsNullOrWhiteSpace(e.SerialNumber)) { <span class="text-muted">&middot; SRN-ref @e.SerialNumber</span> }
                    @if (!string.IsNullOrWhiteSpace(e.HolderNameRaw) && e.HolderNameRaw != c.LatestChargeHolderRaw)
                    {
                        <text>&middot;</text>
                        if (!string.IsNullOrWhiteSpace(c.LatestChargeHolderRaw))
                        {
                            @* Factual, not a rename claim: this event's own recorded holder differs from the
                               charge's latest recorded holder. There may be several holder changes across a
                               charge's lifecycle events, so this never asserts a direct A-became-B rename. *@
                            <span class="mca-badge sev-watch">Recorded holder: @e.HolderNameRaw; latest recorded holder: @c.LatestChargeHolderRaw</span>
                        }
                        else
                        {
                            <span class="text-muted">Recorded holder: @e.HolderNameRaw</span>
                        }
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(e.ModificationParticulars))
                {
                    <div class="text-muted mt-1"><b>Modification Particulars:</b> @e.ModificationParticulars</div>
                }
                <div class="mt-1">@await Html.PartialAsync("Details/_WorkbookProvenance", e)</div>
            </li>
        }
        </ul>
        <p class="text-muted mb-0">
            Original: @if (creation?.ChargeAmount is { } o) { <partial name="Details/_Amount" model="new AmountViewModel(o)" /> } else { <text>not available</text> } ·
            Latest: <partial name="Details/_Amount" model="new AmountViewModel(c.CurrentAmount)" /> ·
            Registered Charge Enhancement:
            @{
                var enh = (creation?.ChargeAmount is { } oo && c.CurrentAmount is { } ll)
                    ? (decimal?)(ll - oo) : null;
            }
            @if (enh is { } d)
            {
                <partial name="Details/_Amount" model="new AmountViewModel(d)" />
                @if (creation!.ChargeAmount!.Value != 0)
                {
                    <text> (@($"{d / creation.ChargeAmount.Value * 100:0.#}%"))</text>
                }
            }
            else
            {
                <text>Not available</text>
            }
        </p>
    </div>

    @* ── C. Facility / Terms ── *@
    <div class="mca-section">
        <h3>Facility &amp; Terms</h3>
        @{
            var facEvent = latestClassified ?? narrativeEvent;
            var facs = facEvent is not null ? Facilities(facEvent) : new List<string>();
        }
        @if (facs.Count > 0)
        {
            <p>@foreach (var f in facs) { <span class="mca-badge">@SpaceCamel(f)</span> }</p>
        }
        <div class="mca-kv">
            <div><dt>Rate / Commission</dt><dd>@Or(narrativeEvent?.RateOfInterest)</dd></div>
            <div><dt>Repayment</dt><dd>@Or(narrativeEvent?.TermsOfPayment)</dd></div>
            <div><dt>Sublimit</dt><dd>not separately extracted</dd></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(narrativeEvent?.InstrumentDescription) || !string.IsNullOrWhiteSpace(narrativeEvent?.OtherTerms))
        {
            <details open="open"><summary class="mca-json-toggle">Source wording</summary>
                <div class="mt-2">
                    @if (!string.IsNullOrWhiteSpace(narrativeEvent?.InstrumentDescription)) { <p><b>Instrument Description:</b> @narrativeEvent!.InstrumentDescription</p> }
                    @if (!string.IsNullOrWhiteSpace(narrativeEvent?.OtherTerms)) { <p><b>Other Terms:</b> @narrativeEvent!.OtherTerms</p> }
                </div>
            </details>
        }
    </div>

    @* ── D/E. Security Details ── *@
    <div class="mca-section">
        <h3>Security</h3>
        @{
            var components = (latestClassified?.SecurityComponents ?? new List<ChargeSecurityComponent>())
                .OrderByDescending(x => x.Confidence).ToList();
        }
        @if (showStructured && components.Count > 0)
        {
            @if (conf == ChargeClassificationConfidence.Medium)
            {
                <p class="text-muted">Derived from source wording.</p>
            }
            <div class="pi-table-wrap"><table class="pi-results-table">
                <thead><tr><th>Security</th><th>Ranking</th><th>Primary?</th><th>Derived from</th></tr></thead>
                <tbody>
                @foreach (var comp in components)
                {
                    <tr>
                        <td><span class="mca-badge">@SpaceCamel(comp.SecurityType.ToString())</span></td>
                        <td>@(comp.Ranking == ChargeRanking.Unknown ? "—" : SpaceCamel(comp.Ranking.ToString()))</td>
                        <td>@(comp.IsPrimarySecurity is null ? "—" : comp.IsPrimarySecurity.Value ? "Primary" : "Collateral")</td>
                        <td class="text-muted">@Or(comp.AssetDescriptionRaw)</td>
                    </tr>
                }
                </tbody>
            </table></div>
            @if (latestClassified?.Arrangement is { } arr && arr != ChargeArrangement.Unknown)
            {
                <p style="margin-top:10px;"><span class="mca-finding-label">Arrangement:</span> <span class="mca-badge">@SpaceCamel(arr.ToString())</span></p>
            }
        }
        else
        {
            <p class="text-muted">Could not confidently classify — see source wording below.</p>
        }

        @{
            // Column M ("Particulars of Property Charged") from the latest filing that states it: the grounded Gemini
            // split when one exists, otherwise the deterministic reading. The raw wording always stays below.
            var propertyEvent = events.LastOrDefault(e => !string.IsNullOrWhiteSpace(e.PropertyParticulars));
            var property = propertyEvent is null
                ? PropertyReading.None
                : PropertyReading.For(propertyEvent.PropertyParticulars, propertyEvent.PropertyType, Model.PropertyExtractions);

            var addressPool = ChargedPropertyAddressRules.BuildAddressPool(Model.CompanyProfile, Model.EpfoEstablishments);
            var chargePremisesMatch = addressPool.Count > 0 ? ChargedPropertyAddressRules.ClassifyCharge(c, addressPool, Model.PropertyExtractions) : null;
            var thirdPartyOwners = ChargedPropertyAddressRules.GetThirdPartyOwners(c, Model.CompanyProfile, Model.PropertyExtractions);
        }
        @if (chargePremisesMatch?.IsCompanyPremises == true)
        {
            <p style="margin-top:10px;"><span class="mca-finding-label">Premises:</span> <span class="mca-badge sev-watch">Own premises: @chargePremisesMatch.Label</span></p>
        }
        @if (thirdPartyOwners.Count > 0)
        {
            <p style="margin-top:10px;"><span class="mca-finding-label">Collateral:</span> <span class="mca-badge sev-watch">Third-party collateral: @string.Join(", ", thirdPartyOwners)</span></p>
        }
        @if (property.HasContent)
        {
            <div class="mca-property-normalized" style="margin-top:12px;">
                <h4 style="font-size:1rem;">Property charged (normalised)</h4>
                <p class="text-muted" style="margin-bottom:6px;">
                    From the @(propertyEvent!.EventType.ToString().ToLowerInvariant()) filing@(propertyEvent.EventDate is { } pd ? " of " + pd.ToString("d MMM yyyy") : "") ·
                    @if (property.Source == PropertyReadingSource.Ai)
                    {
                        <text>every value below is written in the source wording@(property.RejectedFieldCount > 0 ? $" — {property.RejectedFieldCount} value(s) not found there are not shown" : "").</text>
                    }
                    else
                    {
                        <text>read by rules from the source wording below; anything not stated there is left blank.</text>
                    }
                </p>
                @for (var pi = 0; pi < property.Items.Count; pi++)
                {
                    var item = property.Items[pi];
                    var itemMatch = addressPool.Count > 0 ? ChargedPropertyAddressRules.ClassifyItem(item, addressPool, itemIndex: pi) : null;
                    var evPieces = itemMatch?.IsCompanyPremises == true
                        ? itemMatch.Result.MatchedPlotNumbers.Concat(itemMatch.Result.MatchedLocalities).Append(itemMatch.Result.MatchedPinCode).Where(x => !string.IsNullOrEmpty(x)).ToList()
                        : null;
                    <dl class="mca-kv" style="@(property.Items.Count > 1 ? "border-left:3px solid var(--bs-border-color, #ddd); padding-left:8px; margin-bottom:10px;" : "")">
                        @if (property.Items.Count > 1)
                        {
                            <div><dt>Property</dt><dd>@(pi + 1) of @property.Items.Count</dd></div>
                        }
                        @if (itemMatch is not null)
                        {
                            <div>
                                <dt>Premises</dt>
                                <dd>
                                    @if (itemMatch.IsCompanyPremises)
                                    {
                                        <span class="mca-badge sev-watch">Own premises: @itemMatch.Label</span>
                                        @if (evPieces is { Count: > 0 })
                                        {
                                            <span class="text-muted ms-1" style="font-size:0.85em;">(matched: @string.Join(", ", evPieces))</span>
                                        }
                                    }
                                    else if (AddressMatcher.IsImmovable(item))
                                    {
                                        <span class="text-muted">No match to filed company premises (other collateral)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Movable asset (not applicable to premises)</span>
                                    }
                                </dd>
                            </div>
                        }
                        @if (item.AssetClasses.Count > 0)
                        {
                            <div><dt>Asset class</dt><dd>@foreach (var ac in item.AssetClasses) { <span class="mca-badge">@ac</span> }</dd></div>
                        }
                        @if (item.Kinds.Count > 0)
                        {
                            <div><dt>What is charged</dt><dd>@foreach (var k in item.Kinds) { <span class="mca-badge">@PropertyParticularsNormalizer.Label(k)</span> }</dd></div>
                        }
                        @if (item.Owner is not null)
                        {
                            <div>
                                <dt>Belongs to</dt>
                                <dd>
                                    @if (!ChargedPropertyAddressRules.IsSelfCompany(item.Owner, Model.CompanyProfile))
                                    {
                                        <span class="mca-badge sev-watch">Third-party: @item.Owner</span>
                                    }
                                    else
                                    {
                                        @item.Owner
                                    }
                                </dd>
                            </div>
                        }
                        @foreach (var unitLine in item.UnitLines)
                        {
                            <div><dt>Unit</dt><dd>@unitLine</dd></div>
                        }
                        @if (item.BuildingsOrProjects.Count > 0)
                        {
                            <div><dt>Building / project</dt><dd>@string.Join("; ", item.BuildingsOrProjects)</dd></div>
                        }
                        @if (item.Areas.Count > 0)
                        {
                            <div><dt>Area</dt><dd>@foreach (var area in item.Areas) { <div>@PropertyParticularsNormalizer.Describe(area)</div> }</dd></div>
                        }
                        @if (item.ParkingSpaces is { } spaces)
                        {
                            <div><dt>Parking</dt><dd>@spaces space@(spaces == 1 ? "" : "s")@(item.ParkingSpaceNumbers.Count > 0 ? " — " + string.Join(", ", item.ParkingSpaceNumbers) : "")</dd></div>
                        }
                        @if (item.SurveyNumbers.Count > 0)
                        {
                            <div><dt>CTS / survey / plot no.</dt><dd>@foreach (var g in item.SurveyNumbers) { <div>@PropertyParticularsNormalizer.Describe(g)</div> }</dd></div>
                        }
                        @if (!item.Location.IsEmpty)
                        {
                            <div><dt>Location</dt><dd>@PropertyParticularsNormalizer.Describe(item.Location)</dd></div>
                        }
                        @if (item.NamedEntities.Count > 0)
                        {
                            <div><dt>Entities named</dt><dd>@string.Join("; ", item.NamedEntities)</dd></div>
                        }
                    </dl>
                }
                @if (property.DetailsOnlyInReferencedDocument)
                {
                    <p class="text-muted mb-0">The filing does not describe the property itself — it only refers to a schedule/annexure of the charge instrument.</p>
                }
            </div>
        }

        @if (Model.ChargeForms is { Count: > 0 } chargeForms)
        {
            @* #364: the charge e-forms (Form 8 / CHG-1) filed for this charge, read field by field from the form itself (#369) —
               the property particulars and ownership exactly as the company filed them. *@
            <div class="mca-charge-forms" style="margin-top:12px;">
                <h4 style="font-size:1rem;">Filed charge forms</h4>
                @foreach (var linked in chargeForms)
                {
                    var form = linked.Form;
                    var formReading = PropertyReading.For(form.PropertyParticulars, null, null);
                    <dl class="mca-kv" style="border-left:3px solid var(--bs-border-color, #ddd); padding-left:8px; margin-bottom:10px;">
                        <div><dt>Instrument</dt><dd>@(form.InstrumentDescription ?? "Charge form")@(form.InstrumentDate is { } fd ? " · " + fd.ToString("d MMM yyyy") : "")</dd></div>
                        @if (form.AmountSecuredCrore is { } cr)
                        {
                            <div><dt>Amount secured</dt><dd>₹@cr.ToString("N2") Cr</dd></div>
                        }
                        @if (form.HolderName is not null)
                        {
                            <div><dt>Charge holder</dt><dd>@form.HolderName</dd></div>
                        }
                        @if (form.OwnedByCompany == false)
                        {
                            <div>
                                <dt>Ownership</dt>
                                <dd>
                                    <span class="mca-badge sev-watch">Not registered in the company's name</span>
                                    @if (form.RegisteredOwner is not null)
                                    {
                                        <span> — registered in: @form.RegisteredOwner</span>
                                    }
                                    <span class="text-muted" style="font-size:0.85em;">(as stated in the form)</span>
                                </dd>
                            </div>
                        }
                        else if (form.OwnedByCompany == true)
                        {
                            <div><dt>Ownership</dt><dd>Registered in the company's name (as stated in the form)</dd></div>
                        }
                        @if (form.PropertyParticulars is not null)
                        {
                            <div><dt>Property as filed</dt><dd>@form.PropertyParticulars</dd></div>
                            @foreach (var formItem in formReading.Items.Where(i => i.SurveyNumbers.Count > 0 || !i.Location.IsEmpty || i.UnitLines.Count > 0 || i.Areas.Count > 0))
                            {
                                <div><dt>Reading</dt><dd>@PropertyReading.Summarize(formItem)</dd></div>
                            }
                        }
                        <div><dt>Source</dt><dd><a href="/Requests/@Model.Charge.RequestId/documents/@form.FilingDocumentId/view" target="_blank" rel="noopener">Open the filed form</a></dd></div>
                    </dl>
                }
            </div>
        }

        @if (Model.Documents is { Count: > 0 } chargeDocuments)
        {
            @* #377: every filing document tied to this charge — its creation, modification and satisfaction forms and the
               attachments embedded in them (deeds, instruments, letters) — open or satisfied alike. Each link is exact. *@
            var attachmentsOf = chargeDocuments.Where(x => x.LinkedFromDocumentId is not null).ToLookup(x => x.LinkedFromDocumentId!.Value);
            var shownIds = chargeDocuments.Where(x => x.LinkedFromDocumentId is null).Select(x => x.FilingDocumentId).ToHashSet();
            var topLevel = chargeDocuments.Where(x => x.LinkedFromDocumentId is null || !shownIds.Contains(x.LinkedFromDocumentId.Value)).ToList();
            string HowLinked(MCAROC_Analysis.Services.PropertyParticulars.ChargeDocumentRow row) => row.Method switch
            {
                MCAROC_Analysis.Data.Entities.ChargeDocumentLinkMethod.FormChargeId => "the form states this charge ID",
                MCAROC_Analysis.Data.Entities.ChargeDocumentLinkMethod.CreationDateAndAmount => "creation form; its date and amount match this charge",
                MCAROC_Analysis.Data.Entities.ChargeDocumentLinkMethod.FileName => "the file name states this charge ID",
                _ => "attached to this charge's form"
            };
            <div class="mca-charge-documents" style="margin-top:12px;">
                <h4 style="font-size:1rem;">Documents filed for this charge <span class="text-muted" style="font-size:0.8em;">(@chargeDocuments.Count)</span></h4>
                <ul style="list-style:none; padding-left:0; margin-bottom:0;">
                    @foreach (var doc in topLevel)
                    {
                        <li style="margin-bottom:6px;">
                            <a href="/Requests/@Model.Charge.RequestId/documents/@doc.FilingDocumentId/view" target="_blank" rel="noopener">@(doc.FormType ?? "Attachment"): @doc.DisplayName</a>
                            <span class="text-muted" style="font-size:0.85em;"> — @HowLinked(doc)</span>
                            @if (attachmentsOf[doc.FilingDocumentId].Any())
                            {
                                <ul style="list-style:none; padding-left:16px; margin-top:2px;">
                                    @foreach (var a in attachmentsOf[doc.FilingDocumentId])
                                    {
                                        <li><a href="/Requests/@Model.Charge.RequestId/documents/@a.FilingDocumentId/view" target="_blank" rel="noopener">@(a.FormType ?? "Attachment"): @a.DisplayName</a></li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(narrativeEvent?.PropertyParticulars) || !string.IsNullOrWhiteSpace(narrativeEvent?.ExtentAndOperation))
        {
            <details open="@(property.HasContent ? null : "open")">
                <summary class="mca-json-toggle">Property particulars (source wording)</summary>
                <div class="mt-2">
                    @if (chargePremisesMatch?.IsCompanyPremises == true && !property.HasContent)
                    {
                        <p><span class="mca-badge sev-watch">Own premises: @chargePremisesMatch.Label</span></p>
                    }
                    @if (!string.IsNullOrWhiteSpace(narrativeEvent?.PropertyParticulars)) { <p><b>Particulars of Property Charged:</b> @narrativeEvent!.PropertyParticulars</p> }
                    @if (!string.IsNullOrWhiteSpace(narrativeEvent?.ExtentAndOperation)) { <p><b>Extent and Operation of Charge:</b> @narrativeEvent!.ExtentAndOperation</p> }
                </div>
            </details>
        }
        else if (narrativeEvent is null)
        {
            <p class="text-muted mb-0">No charge-report detail sheet was matched to this charge — only ROC-sequence data is available.</p>
        }
    </div>

    @* ── G. Modification comparison ── *@
    @if (creation is not null && compareTarget is not null && compareTarget != creation)
    {
        var baseFacs = Facilities(creation);
        var targFacs = Facilities(compareTarget);
        <div class="mca-section">
            <h3>@(isSatisfied ? "Creation vs last modification" : "Creation vs latest event")</h3>
            <div class="pi-table-wrap"><table class="pi-results-table mca-compare">
                <thead><tr><th>Field</th><th>@creation.EventType @(creation.EventDate is { } cd ? $"({cd:d MMM yyyy})" : "")</th><th>@compareTarget.EventType @(compareTarget.EventDate is { } td ? $"({td:d MMM yyyy})" : "")</th><th>Change</th></tr></thead>
                <tbody>
                <tr>
                    <td>Registered amount</td>
                    <td>@if (creation.ChargeAmount is { } a1) { <partial name="Details/_Amount" model="new AmountViewModel(a1)" /> } else { <text>not available</text> }</td>
                    <td>@if (compareTarget.ChargeAmount is { } a2) { <partial name="Details/_Amount" model="new AmountViewModel(a2)" /> } else { <text>not available</text> }</td>
                    <td class="mca-compare-change @(creation.ChargeAmount is { } b1 && compareTarget.ChargeAmount is { } b2 ? (b2 > b1 ? "mca-compare-up" : b2 < b1 ? "mca-compare-down" : "") : "")">
                        @if (creation.ChargeAmount is { } d1 && compareTarget.ChargeAmount is { } d2) { <partial name="Details/_Amount" model="new AmountViewModel(d2 - d1)" /> } else { <text>Not available</text> }
                    </td>
                </tr>
                <tr>
                    <td>Facility</td>
                    <td>@(baseFacs.Count > 0 ? string.Join(", ", baseFacs.Select(SpaceCamel)) : "—")</td>
                    <td>@(targFacs.Count > 0 ? string.Join(", ", targFacs.Select(SpaceCamel)) : "—")</td>
                    <td class="mca-compare-change">@(baseFacs.SequenceEqual(targFacs) ? "unchanged" : "changed")</td>
                </tr>
                </tbody>
            </table></div>
        </div>
    }

    @* ── G2. Litigation touching this charge ── *@
    @if (Model.Litigation is { Count: > 0 })
    {
        <div class="mca-section" id="charge-@c.ChargeId-litigation">
            <h3>Litigation touching this charge <span class="mca-count">@Model.Litigation.Count</span></h3>
            @foreach (var l in Model.Litigation)
            {
                <div class="mca-finding @MCAROC_Analysis.Services.LitigationData.ChargeLitigationLabels.Severity(l.Signal)">
                    <h4>
                        <span class="mca-sev-dot"></span>@MCAROC_Analysis.Services.LitigationData.ChargeLitigationLabels.Heading(l.Signal)
                        <span class="mca-finding-meta">@l.Case.Source@(string.IsNullOrWhiteSpace(l.Case.Forum) ? "" : " · " + l.Case.Forum)</span>
                    </h4>
                    <p>
                        <strong>@(string.IsNullOrWhiteSpace(l.Case.CaseNumber) ? "Case" : l.Case.CaseNumber)</strong>
                        @if (!string.IsNullOrWhiteSpace(l.Case.Court)) { <text> · @l.Case.Court</text> }
                        @if (!string.IsNullOrWhiteSpace(l.Case.Status)) { <text> · @l.Case.Status</text> }
                        @if (!string.IsNullOrWhiteSpace(l.Case.Parties)) { <br /><span class="text-muted">@l.Case.Parties</span> }
                    </p>
                    <p class="mb-1">@l.Explanation</p>
                    @if (!string.IsNullOrWhiteSpace(l.Excerpt))
                    {
                        <blockquote class="small text-muted border-start ps-2 mb-1">@l.Excerpt@(l.PageNumber is { } pg ? $" (page {pg})" : "")</blockquote>
                    }
                    @if (l.Case.LitigationCaseId is { } caseId)
                    {
                        <a class="small" href="/Requests/@Model.Charge.RequestId#case-card-@caseId">Open the case in the Litigation tab</a>
                    }
                </div>
            }
        </div>
    }

    @* ── H. Related findings ── *@
    @if (Model.RelatedFindings.Count > 0)
    {
        <div class="mca-section">
            <h3>Related findings <span class="mca-count">@Model.RelatedFindings.Count</span></h3>
            @foreach (var f in Model.RelatedFindings)
            {
                <div class="mca-finding @SevClass(f.Severity)">
                    <h4><span class="mca-sev-dot"></span>@f.Title <span class="mca-finding-meta">@f.TemporalStatus</span></h4>
                    <p>@f.SummaryText</p>
                </div>
            }
        </div>
    }

    @* ── I. Related filings ── *@
    <div class="mca-section">
        <h3>Related filings</h3>
        <p class="text-muted mb-0">No directly linked filing identified — charge events in this workbook carry no SRN cross-reference to match against.</p>
    </div>

</div>
