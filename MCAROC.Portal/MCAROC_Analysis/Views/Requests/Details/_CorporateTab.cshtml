@model RequestDetailsViewModel
@{
    var r = Model.Request;
    var cp = Model.CompanyProfile;
    var currentDirectors = Model.Directors.Where(d => d.CessationDate is null).ToList();
    var formerDirectors = Model.Directors.Where(d => d.CessationDate is not null).ToList();
    var relByType = Model.RelatedCorporates.GroupBy(x => x.RelationshipType).ToList();

    var sections = new (string Label, string Id, int? Count)[]
    {
        ("Overview", "overview", null),
        ("Management", "management", Model.Directors.Count + Model.CompanyOfficers.Count),
        ("Director Network", "network", Model.DirectorAssociations.Count + Model.ProprietorshipAssociations.Count),
        ("Ownership", "ownership", Model.Shareholdings.Count),
        ("Group Entities", "group", Model.RelatedCorporates.Count + Model.RelatedPartyTransactions.Count),
        ("Capital", "capital", Model.SecurityAllotments.Count),
    };
}

<ul class="nav mca-subtabs" data-mca-sections="corporate" role="tablist">
    @for (var i = 0; i < sections.Length; i++)
    {
        var s = sections[i];
        <li class="nav-item" role="presentation">
            <button class="nav-link @(i == 0 ? "active" : "")" data-bs-toggle="tab" data-bs-target="#sec-corporate-@s.Id" type="button" role="tab">
                @s.Label @if (s.Count is { } c) { <span class="badge">@c</span> }
            </button>
        </li>
    }
</ul>

<div class="tab-content">

    @* ── Overview ── *@
    <div class="tab-pane fade show active mca-subtab-panel" id="sec-corporate-overview" role="tabpanel">
        @if (cp is not null)
        {
            <div class="mca-kv">
                <div><dt>Company Name</dt><dd>@cp.CompanyName</dd></div>
                <div><dt>Status</dt><dd>@Or(cp.CompanyStatus)</dd></div>
                <div><dt>CIN</dt><dd>@(cp.Cin ?? r.Cin ?? r.Llpin ?? "—")</dd></div>
                <div><dt>PAN</dt><dd>@(cp.Pan ?? r.Pan ?? "—")</dd></div>
                <div><dt>Compliance Status</dt><dd>@Or(cp.ComplianceStatus)</dd></div>
                <div><dt>Incorporated</dt><dd>@D(cp.IncorporationDate)</dd></div>
                <div><dt>Date of Last AGM</dt><dd>@D(cp.LastAgmDate)</dd></div>
                <div><dt>Authorised Capital</dt><dd>@Money(cp.AuthorisedCapital)</dd></div>
                <div><dt>Paid-up Capital</dt><dd>@Money(cp.PaidUpCapital)</dd></div>
                <div><dt>Type of Entity</dt><dd>@Or(cp.EntityType)</dd></div>
                <div><dt>Listing Status</dt><dd>@Or(cp.ListingStatus)</dd></div>
                <div><dt>LEI Status</dt><dd>@Or(cp.LeiStatus)</dd></div>
                <div><dt>Industry / Segment</dt><dd>@Or(cp.Industry)@(string.IsNullOrEmpty(cp.Segment) ? "" : $" · {cp.Segment}")</dd></div>
                <div>
                    <dt>MCA Sum of Charges</dt>
                    <dd>
                        @Money(cp.McaSumOfChargesCrore)
                        @{
                            var openCharges = Model.Charges.Where(DossierComputations.IsOpenCharge).ToList();
                            var anyMissingAmounts = openCharges.Any(c => c.CurrentAmount is null);
                        }
                        @if (cp.McaSumOfChargesCrore is { } mcaCr)
                        {
                            @if (openCharges.Count == 0 && Model.TotalChargeCount == 0)
                            {
                                <span class="mca-badge sev-watch ms-1" title="Reconciliation incomplete: charge register not present in this workbook">
                                    register not present
                                </span>
                            }
                            else if (anyMissingAmounts)
                            {
                                <span class="mca-badge sev-watch ms-1" title="Reconciliation incomplete: @openCharges.Count(c => c.CurrentAmount is null) open charge(s) have unstated amounts">
                                    reconciliation incomplete
                                </span>
                            }
                            else
                            {
                                var compCr = openCharges.Sum(c => c.CurrentAmount!.Value);
                                if (Math.Abs(mcaCr - compCr) > 0.05m)
                                {
                                    <span class="mca-badge sev-watch ms-1" title="MCA stated sum of charges (@Money(mcaCr)) differs from computed open charges total (@Money(compCr))">
                                        Divergence (Computed Open: @Money(compCr))
                                    </span>
                                }
                            }
                        }
                    </dd>
                </div>
                <div><dt>Website</dt><dd>@(string.IsNullOrEmpty(cp.Website) ? "—" : Html.Raw($"<a href=\"{System.Net.WebUtility.HtmlEncode(cp.Website)}\" target=\"_blank\" rel=\"noopener\">{System.Net.WebUtility.HtmlEncode(cp.Website)}</a>"))</dd></div>
                <div><dt>Phone</dt><dd>@Or(cp.Phone)</dd></div>
                <div class="mca-kv-wide">
                    <dt>Email(s)</dt>
                    <dd>
                        @if (Model.CompanyEmails.Count == 0) { <text>—</text> }
                        else
                        {
                            @foreach (var em in Model.CompanyEmails)
                            {
                                <span>@em.EmailAddress</span>
                                @if (em.IsReachable == false) { <span class="pi-status-pill pi-status-failed" title="The data source could not reach this address">unreachable</span> }
                                <br />
                            }
                        }
                    </dd>
                </div>
                <div class="mca-kv-wide"><dt>Registered Address</dt><dd>@Or(cp.RegisteredAddress)</dd></div>
                <div class="mca-kv-wide"><dt>Business Address</dt><dd>@Or(cp.BusinessAddress)</dd></div>
                @if (!string.IsNullOrEmpty(cp.NarrativeDescription))
                {
                    <div class="mca-kv-wide"><dt>About</dt><dd>@cp.NarrativeDescription</dd></div>
                }
            </div>
        }
        else
        {
            <div class="mca-empty"><i class="bi bi-building"></i><p>No company profile was extracted for this request.</p></div>
        }

        @if (Model.PrincipalBusinessActivities.Count > 0)
        {
            var pbaDate = Model.PrincipalBusinessActivities.Select(x => x.AsOnDate).FirstOrDefault(d => d is not null);
            <div class="mca-section" style="margin-top:22px;">
                <h3>Principal Business Activities <span class="mca-count">@Model.PrincipalBusinessActivities.Count</span></h3>
                <p class="text-muted">MCA activity classification the company declared@(pbaDate is { } pd ? $" — as on {pd:d MMM yyyy}" : "").</p>
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Group</th><th>Main activity</th><th>Code</th><th>Business activity</th><th class="text-end">% of turnover</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.PrincipalBusinessActivities)
                    {
                        <tr>
                            <td>@Or(a.MainActivityGroupCode)</td>
                            <td>@Or(a.MainActivityGroupDescription)</td>
                            <td>@Or(a.BusinessActivityCode)</td>
                            <td>@Or(a.BusinessActivityDescription)</td>
                            <td class="text-end">@Num(a.TurnoverPercent)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        }

        @if (Model.NameHistory.Count > 0)
        {
            <div class="mca-section" style="margin-top:22px;">
                <h3>Name History <span class="mca-count">@Model.NameHistory.Count</span></h3>
                <p class="text-muted">Former legal names, oldest first. The current name is not repeated here.</p>
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Former name</th><th>In use until</th></tr></thead>
                    <tbody>
                    @foreach (var n in Model.NameHistory)
                    {
                        <tr>
                            <td>@n.PreviousName</td>
                            <td>@(n.TillDate is { } td ? td.ToString("d MMM yyyy") : Or(n.TillDateRaw))</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        }

        @await Html.PartialAsync("Details/_KeyIndicators", Model.KeyMetrics)

        @if (Model.LatestRun is { } lrun)
        {
            <div class="mca-section" style="margin-top:22px;">
                <h3>Data Freshness</h3>
                <p class="text-muted mb-0">
                    Extraction run #@lrun.RunNumber — @lrun.Status
                    @if (lrun.CompletedDate is { } cd) { <text>, completed @cd.ToString("d MMM yyyy HH:mm")</text> }.
                    @if (Model.LatestFinancialYear is { } fy) { <text> Latest financial year on record: FY@(fy).</text> }
                </p>
            </div>
        }
    </div>

    @* ── Management ── *@
    <div class="tab-pane fade mca-subtab-panel" id="sec-corporate-management" role="tabpanel">
        @await Html.PartialAsync("Details/_KeyIndicators", Model.KeyMetrics.Where(g => g.Title == "Directors").ToList())

        <div class="mca-section">
            <h3>Current Directors <span class="mca-count">@currentDirectors.Count</span></h3>
            @if (currentDirectors.Count > 0)
            {
                @await Html.PartialAsync("Details/_DirectorTable", currentDirectors)
            }
            else { <p class="text-muted mb-0">@Model.SheetCoverage.EmptyState("No current directors on record.", SheetAliases.Directors)</p> }
        </div>

        @if (Model.CompanyOfficers.Count > 0)
        {
            <div class="mca-section">
                <h3>Key Managerial Personnel / Officers (Non-DIN) <span class="mca-count">@Model.CompanyOfficers.Count</span></h3>
                <p class="text-muted">Key officers and managerial personnel on record without a Director Identification Number (e.g. Company Secretary, CFO, Manager).</p>
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Officer Name</th><th>Designation</th><th>Appointed</th><th>Designation Date</th><th>Ceased</th><th>Status / Flags</th></tr></thead>
                    <tbody>
                    @foreach (var o in Model.CompanyOfficers)
                    {
                        <tr>
                            <td><strong>@o.NameRaw</strong></td>
                            <td>@Or(o.Designation)</td>
                            <td>@D(o.OriginalAppointmentDate)</td>
                            <td>@D(o.DesignationAppointmentDate)</td>
                            <td>@D(o.CessationDate)</td>
                            <td>
                                @if (o.CessationDate is not null)
                                {
                                    <span class="mca-badge">Ceased</span>
                                }
                                else
                                {
                                    <span class="mca-badge" style="background:#e6f4ea; color:#137333;">Active</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(o.Flags))
                                {
                                    <span class="badge bg-light text-dark ms-1">@o.Flags</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        }

        @if (formerDirectors.Count > 0)
        {
            <div class="mca-section">
                <h3>Former Directors <span class="mca-count">@formerDirectors.Count</span></h3>
                @await Html.PartialAsync("Details/_DirectorTable", formerDirectors)
            </div>
        }

        @if (Model.DirectorAssignmentHistories.Count > 0)
        {
            <div class="mca-section">
                <h3>Designation History <span class="mca-count">@Model.DirectorAssignmentHistories.Count</span></h3>
                <p class="text-muted">Each row is one designation stint held at this company.</p>
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Director</th><th>DIN</th><th>Designation</th><th>Appointed</th><th>Ceased</th></tr></thead>
                    <tbody>
                    @foreach (var h in Model.DirectorAssignmentHistories)
                    {
                        <tr>
                            <td>@h.DirectorNameRaw</td>
                            <td class="report-id">@Or(h.DirectorDin)</td>
                            <td>@Or(h.Designation)</td>
                            <td>@D(h.AppointmentDate)</td>
                            <td>@D(h.CessationDate)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        }
        else if (Model.SheetCoverage.WasAbsent(SheetAliases.DirectorAssociationHistory))
        {
            <div class="mca-section">
                <h3>Designation History</h3>
                <p class="text-muted mb-0">This workbook did not include a “@SheetAliases.CanonicalName(SheetAliases.DirectorAssociationHistory)” sheet.</p>
            </div>
        }
    </div>

    @* ── Director Network ── *@
    <div class="tab-pane fade mca-subtab-panel" id="sec-corporate-network" role="tabpanel">
        <div class="mca-section">
            <h3>Other Directorships <span class="mca-count">@Model.DirectorAssociations.Count</span></h3>
            @if (Model.DirectorAssociations.Count > 0)
            {
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Director</th><th>Connected Company</th><th>CIN</th><th>Type</th><th class="text-end">Paid-up (Cr)</th><th class="text-end">Charges (Cr)</th><th>Status</th><th>Active Compliance</th><th>Incorporated</th><th>Appointed</th><th>Ceased</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.DirectorAssociations.OrderBy(a => a.ConnectedCompanyRaw))
                    {
                        <tr>
                            <td>@a.DirectorNameRaw</td>
                            <td>@a.ConnectedCompanyRaw</td>
                            <td class="report-id">@Or(a.ConnectedCin)</td>
                            <td>@Or(a.CorporateType)</td>
                            <td class="text-end">@Num(a.PaidUpCapitalCrore)</td>
                            <td class="text-end">@Num(a.SumOfChargesCrore)</td>
                            <td>@Or(a.CompanyStatus)</td>
                            <td>@Or(a.ActiveCompliance)</td>
                            <td>@D(a.DateOfIncorporation)</td>
                            <td>@D(a.AppointmentDate)</td>
                            <td>@D(a.CessationDate)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
            else { <p class="text-muted mb-0">@Model.SheetCoverage.EmptyState("No connected directorships were extracted.", SheetAliases.OtherDirectorships)</p> }
        </div>

        <div class="mca-section">
            <h3>Proprietorship Associations <span class="mca-count">@Model.ProprietorshipAssociations.Count</span></h3>
            @if (Model.ProprietorshipAssociations.Count > 0)
            {
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Director</th><th>DIN</th><th>Legal Name</th><th>Business Name(s)</th><th>PAN</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.ProprietorshipAssociations)
                    {
                        <tr>
                            <td>@p.DirectorNameRaw</td>
                            <td class="report-id">@Or(p.DirectorDin)</td>
                            <td>@Or(p.LegalName)</td>
                            <td>@Or(p.BusinessNames)</td>
                            <td class="report-id">@Or(p.Pan)</td>
                            <td>@Or(p.Status)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
            else { <p class="text-muted mb-0">@Model.SheetCoverage.EmptyState("No proprietorship associations were reported in this workbook.", SheetAliases.Proprietorship)</p> }
        </div>
    </div>

    @* ── Ownership ── *@
    <div class="tab-pane fade mca-subtab-panel" id="sec-corporate-ownership" role="tabpanel">
        @if (Model.Structure is { } st)
        {
            <div class="mca-highlight-grid" style="margin-bottom:22px;">
                <div class="pi-metric"><span>Promoter Holding</span><strong>@Pct(st.PromoterHoldingPercent)</strong><small>@(st.PromoterShareholders?.ToString() ?? "—") promoter shareholder(s)</small></div>
                <div class="pi-metric"><span>Public Holding</span><strong>@Pct(st.PublicHoldingPercent)</strong><small>&nbsp;</small></div>
                <div class="pi-metric"><span>Total Shareholders</span><strong>@(st.TotalShareholders?.ToString("N0") ?? "—")</strong><small>&nbsp;</small></div>
                <div class="pi-metric"><span>Equity Shares</span><strong>@(st.TotalEquityShares?.ToString("N0") ?? "—")</strong><small>@(st.TotalPreferenceShares is { } pref ? $"{pref:N0} preference" : "no preference shares")</small></div>
            </div>
        }
        else
        {
            <p class="text-muted">@Model.SheetCoverage.EmptyState("No shareholding summary (promoter/public split) was reported in this workbook.", SheetAliases.Structure)</p>
        }

        @await Html.PartialAsync("Details/_KeyIndicators", Model.KeyMetrics.Where(g => g.Title == "Shareholding").ToList())

        <div class="mca-section">
            <h3>Shareholders <span class="mca-count">@Model.Shareholdings.Count</span></h3>
            @if (Model.Shareholdings.Count > 0)
            {
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Year</th><th>Shareholder</th><th>Type</th><th>Designation</th><th>Promoter</th><th class="text-end">% Held</th><th class="text-end">Shares</th><th>Status</th><th>Location</th><th class="text-end">Paid-up (Cr)</th><th class="text-end">Charges (Cr)</th><th>Incorporated</th><th>Source</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.Shareholdings)
                    {
                        <tr>
                            <td>FY@(s.FinancialYear)</td>
                            <td>
                                @s.ShareholderNameRaw
                                @if (!string.IsNullOrWhiteSpace(s.Remarks)) { <br /><small class="text-muted">@s.Remarks</small> }
                            </td>
                            <td>@Or(s.ShareholderType)</td>
                            <td>@Or(s.Designation ?? s.RelationshipRaw)</td>
                            <td>@(s.IsPromoter ? "Yes" : "—")</td>
                            <td class="text-end">@Num(s.HoldingPercentage)%</td>
                            <td class="text-end">@(s.SharesHeld?.ToString("N0") ?? "—")</td>
                            <td>
                                @if (s.CessationDate is { } cd) { <span>Ceased @D(cd)</span> }
                                else { @Or(s.CompanyStatus ?? s.ActiveCompliance) }
                            </td>
                            <td>@Or(s.Location)</td>
                            <td class="text-end">@Num(s.PaidUpCapitalCrore)</td>
                            <td class="text-end">@Num(s.SumOfChargesCrore)</td>
                            <td>@D(s.DateOfIncorporation)</td>
                            <td>@s.SourceType</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
            else { <div class="mca-empty"><i class="bi bi-diagram-3"></i><p>@Model.SheetCoverage.EmptyState("No shareholding data was extracted.", SheetAliases.DirectorShareholding, SheetAliases.MajorShareholding)</p></div> }
        </div>

        @if (Model.ShareholdingPattern.Count > 0)
        {
            var patternDate = Model.ShareholdingPattern.Select(x => x.AsOnDate).FirstOrDefault(d => d is not null);
            <div class="mca-section">
                <h3>Shareholding Pattern <span class="mca-count">@Model.ShareholdingPattern.Count</span></h3>
                <p class="text-muted">SEBI-category split from the workbook's <em>Structure</em> sheet@(patternDate is { } pd ? $" — as on {pd:d MMM yyyy}" : "").</p>
                @foreach (var cls in Model.ShareholdingPattern.GroupBy(x => x.HolderClass).OrderBy(g => g.Key))
                {
                    <h4 class="mca-subhead">@(cls.Key == ShareholderClass.Promoter ? "Promoters" : "Public / other than promoters")</h4>
                    <div class="pi-table-wrap"><table class="pi-results-table">
                        <thead><tr><th>Category</th><th class="text-end">Equity Shares</th><th class="text-end">Equity %</th><th class="text-end">Pref. Shares</th><th class="text-end">Pref. %</th></tr></thead>
                        <tbody>
                        @{ string? shownGroup = null; }
                        @foreach (var pr in cls.OrderBy(x => x.DisplayOrder))
                        {
                            if (pr.CategoryGroup is { } g && g != shownGroup)
                            {
                                shownGroup = g;
                                <tr class="mca-row-group"><td colspan="5">@g</td></tr>
                            }
                            if (pr.CategoryGroup is null) { shownGroup = null; }
                            <tr>
                                <td>@(pr.CategoryGroup is null ? "" : "— ")@pr.Category</td>
                                <td class="text-end">@(pr.EquityShares?.ToString("N0") ?? "—")</td>
                                <td class="text-end">@Num(pr.EquityPercent)</td>
                                <td class="text-end">@(pr.PreferenceShares?.ToString("N0") ?? "—")</td>
                                <td class="text-end">@Num(pr.PreferencePercent)</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                }
            </div>
        }
    </div>

    @* ── Group Entities ── *@
    <div class="tab-pane fade mca-subtab-panel" id="sec-corporate-group" role="tabpanel">
        @if (Model.RelatedCorporates.Count > 0)
        {
            <p class="text-muted">Relationship is normalized from the workbook's explicit "Relationship" heading — never inferred from holding %.</p>
            @foreach (var grp in relByType.OrderBy(g => g.Key))
            {
                <div class="mca-section">
                    <h3>@grp.Key <span class="mca-count">@grp.Count()</span></h3>
                    <div class="pi-table-wrap"><table class="pi-results-table">
                        <thead><tr><th>FY Ending</th><th>Entity</th><th>CIN</th><th>Type</th><th class="text-end">Holding %</th><th class="text-end">Paid-up (Cr)</th><th class="text-end">Charges (Cr)</th><th>Status</th><th>Location</th><th>Compliance</th><th>Incorporated</th></tr></thead>
                        <tbody>
                        @foreach (var rc in grp.OrderBy(x => x.EntityNameNormalized))
                        {
                            <tr>
                                <td>@D(rc.FinancialYearEnding)</td>
                                <td>
                                    @rc.EntityNameRaw
                                    @if (!string.IsNullOrWhiteSpace(rc.Remarks)) { <br /><small class="text-muted">@rc.Remarks</small> }
                                </td>
                                <td class="report-id">@Or(rc.Cin)</td>
                                <td>@Or(rc.CorporateType)</td>
                                <td class="text-end">@Num(rc.HoldingPercent)</td>
                                <td class="text-end">@Num(rc.PaidUpCapitalCrore)</td>
                                <td class="text-end">@Num(rc.SumOfChargesCrore)</td>
                                <td>@Or(rc.CompanyStatus)</td>
                                <td>@Or(rc.Location)</td>
                                <td>@Or(rc.ActiveCompliance)</td>
                                <td>@D(rc.DateOfIncorporation)</td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                </div>
            }
        }
        else
        {
            <div class="mca-empty"><i class="bi bi-diagram-2"></i><p>@Model.SheetCoverage.EmptyState("No related corporates (subsidiaries / associates / JVs) were reported in this workbook.", SheetAliases.RelatedCorporates)</p></div>
        }

        <div class="mca-section">
            <h3>Related Party Transactions <span class="mca-count">@Model.RelatedPartyTransactions.Count</span></h3>
            @if (Model.RelatedPartyTransactions.Count > 0)
            {
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>FY Ending</th><th>Entity</th><th>Type</th><th>Relationship</th><th>Transaction Type</th><th class="text-end">Amount (Cr)</th></tr></thead>
                    <tbody>
                    @foreach (var rpt in Model.RelatedPartyTransactions)
                    {
                        <tr>
                            <td>@D(rpt.FinancialYearEnding)</td>
                            <td>@rpt.EntityNameRaw</td>
                            <td>@Or(rpt.EntityType)</td>
                            <td>@Or(rpt.RelationshipRaw)</td>
                            <td>@Or(rpt.TransactionType)</td>
                            <td class="text-end">@Num(rpt.AmountCrore)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
            else { <div class="mca-empty"><i class="bi bi-diagram-2"></i><p>@Model.SheetCoverage.EmptyState("No related party transactions were reported in this workbook.", SheetAliases.RelatedPartyTransactions)</p></div> }
        </div>
    </div>

    @* ── Capital ── *@
    <div class="tab-pane fade mca-subtab-panel" id="sec-corporate-capital" role="tabpanel">
        <div class="mca-section">
            <h3>Securities Allotment <span class="mca-count">@Model.SecurityAllotments.Count</span></h3>
            @if (Model.SecurityAllotments.Count > 0)
            {
                <div class="pi-table-wrap"><table class="pi-results-table">
                    <thead><tr><th>Date</th><th>Type</th><th>Instrument</th><th class="text-end">Amount (Cr)</th><th class="text-end">Count</th><th class="text-end">Nominal / Share</th><th class="text-end">Premium / Share</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.SecurityAllotments)
                    {
                        <tr>
                            <td>@D(a.AllotmentDate)</td>
                            <td>@Or(a.AllotmentType)</td>
                            <td>@Or(a.InstrumentType)</td>
                            <td class="text-end">@Num(a.AmountCrore)</td>
                            <td class="text-end">@(a.NumberOfSecurities?.ToString("N0") ?? "—")</td>
                            <td class="text-end">@Num(a.NominalValuePerShare)</td>
                            <td class="text-end">@Num(a.PremiumValuePerShare)</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
            else { <div class="mca-empty"><i class="bi bi-cash-coin"></i><p>@Model.SheetCoverage.EmptyState("No securities-allotment history was reported in this workbook.", SheetAliases.SecuritiesAllotment)</p></div> }
        </div>
    </div>

</div>
