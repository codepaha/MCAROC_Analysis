@model IReadOnlyList<MCAROC_Analysis.Data.Entities.PreLoginReportJob>
@{ ViewData["Title"] = "Pre-login report history"; var batch = ViewBag.Batch as Guid?; var hasActive = Model.Any(x => x.Status is MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Queued or MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Fetching or MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Generating); }
<div class="pi-page-head"><div><div class="pi-kicker">Durable requests</div><h1>Report history</h1><p>Queued reports refresh automatically while in progress. Failed reports can be rerun.</p></div></div>
@if (TempData["ReportError"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="pi-table-wrap"><table class="pi-results-table"><thead><tr><th>CIN</th><th>Format</th><th>Status</th><th>Progress</th><th>Attempts</th><th>Created</th><th>Failure</th><th></th></tr></thead><tbody>
@foreach (var job in Model.Where(x => batch is null || x.BatchId == batch)) { <tr><td class="report-id">@job.Cin</td><td>@job.Format</td><td>@job.Status</td><td style="min-width:130px"><div class="progress" role="progressbar" aria-valuenow="@job.ProgressPercent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@job.ProgressPercent%">@job.ProgressPercent%</div></div></td><td>@job.AttemptCount / 3</td><td>@job.CreatedUtc.ToLocalTime().ToString("g")</td><td>@job.FailureReason</td><td>@if (job.Status == MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Completed) { <a asp-action="Download" asp-route-id="@job.PreLoginReportJobId" class="btn btn-sm btn-outline-primary">Download</a> } else { <form asp-action="Rerun" asp-route-id="@job.PreLoginReportJobId" method="post"><button class="btn btn-sm btn-outline-secondary">Rerun</button></form> }</td></tr> }
</tbody></table></div>
@section Scripts { @if (hasActive) { <script>setTimeout(function(){ location.reload(); }, 5000);</script> } }
