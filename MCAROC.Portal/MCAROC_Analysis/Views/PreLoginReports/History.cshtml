@model IReadOnlyList<MCAROC_Analysis.Data.Entities.PreLoginReportJob>
@{ ViewData["Title"] = "Pre-login report history"; var batch = (Guid)ViewBag.Batch!; var hasActive = Model.Any(x => x.Status is MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Queued or MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Fetching or MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Generating); }
@* A batch that resolves to zero jobs (garbage/expired/mistyped batch Guid) must never be locally
   recorded by prelogin-reports-mine.js as if it were a real submitted report — see #47 on why "does
   this batch actually exist" can only ever be answered by this server-side lookup, not guessed. *@
@if (Model.Count > 0)
{
    <script type="application/json" id="pi-batch-summary">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        batch,
        createdUtc = Model.Min(x => x.CreatedUtc),
        cins = Model.Select(x => x.Cin),
        formats = string.Join(", ", Model.Select(x => x.Format).Distinct())
    }))</script>
}
<div class="pi-page-head"><div><div class="pi-kicker">Durable requests</div><h1>Report history</h1><p>Queued reports refresh automatically while in progress. Completed or failed reports can be rerun (re-fetch this CIN fresh from the API — no need to fill the form again) or edited (change a field, add or remove a charge, and regenerate in place without a fresh fetch). <strong>Bookmark this page</strong> — its link is the only way back to these reports; there is no login to browse them from. This browser also remembers it under <a asp-action="Mine">My Reports</a>.</p></div></div>
@if (TempData["ReportError"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="pi-table-wrap"><table class="pi-results-table"><thead><tr><th>CIN</th><th>Format</th><th>Status</th><th>Progress</th><th>Attempts</th><th>Created</th><th>Failure</th><th></th></tr></thead><tbody>
@foreach (var job in Model)
{
    var isCompleted = job.Status == MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Completed;
    var isFinished = isCompleted || job.Status == MCAROC_Analysis.Data.Entities.PreLoginReportJobStatus.Failed;
    <tr>
        <td class="report-id">@job.Cin</td><td>@job.Format</td><td>@job.Status</td>
        <td style="min-width:130px"><div class="progress" role="progressbar" aria-valuenow="@job.ProgressPercent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@job.ProgressPercent%">@job.ProgressPercent%</div></div></td>
        <td>@job.AttemptCount / 3</td><td>@job.CreatedUtc.ToLocalTime().ToString("g")</td><td>@job.FailureReason</td>
        <td>
            @if (isCompleted)
            {
                <a asp-action="Download" asp-route-batch="@batch" asp-route-id="@job.PreLoginReportJobId" class="btn btn-sm btn-outline-primary">Download</a>
                <a asp-action="Edit" asp-route-batch="@batch" asp-route-id="@job.PreLoginReportJobId" class="btn btn-sm btn-outline-secondary">Edit</a>
            }
            @if (isFinished)
            {
                <form asp-action="Rerun" asp-route-batch="@batch" asp-route-id="@job.PreLoginReportJobId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary" title="Fetch this CIN fresh from the API again">Rerun</button></form>
            }
        </td>
    </tr>
}
</tbody></table></div>
@section Scripts {
    @if (hasActive) { <script>setTimeout(function(){ location.reload(); }, 5000);</script> }
    <script src="~/js/prelogin-reports-mine.js" type="module" asp-append-version="true"></script>
}
