@model PreLoginReportViewModel
@{ ViewData["Title"] = "Pre-login Reports"; }

<div class="pi-page-head"><div><div class="pi-kicker">Borrower assignments</div><h1>Create an assignment</h1><p>Upload or paste a request. We recognize the borrower, requesting branch and associated people, then create the assignment automatically. Limited companies, LLPs and foreign companies retain MCA scope; all other entities have litigation-only scope. <a asp-action="Mine">My Reports</a> remembers assignments opened in this browser.</p></div></div>
<div class="pi-panel mt-3" style="padding:24px;">
    <h2 class="h5">Generate a report by registered name</h2>
    <p>Choose PRR or SBI, then enter the registered company or LLP name. Select a match when more than one borrower appears, and confirm its legal type before generating the report.</p>
    <form asp-action="Fetch" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <fieldset class="mb-4"><legend class="form-label">Report format</legend><div class="form-check mb-2"><input class="form-check-input" type="radio" asp-for="Format" value="Sbi" id="formatSbi" /><label class="form-check-label" for="formatSbi"><strong>SBI</strong> - company/LLP profile with MCA charges, or litigation-only borrower details and legal cases.</label></div><div class="form-check"><input class="form-check-input" type="radio" asp-for="Format" value="Prr" id="formatPrr" /><label class="form-check-label" for="formatPrr"><strong>PRR</strong> - company profile, MCA-ROC charges and directors/signatories.</label></div></fieldset>
        <fieldset class="mb-3"><legend class="form-label">Borrower legal entity type</legend><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EntityType" required value="Company" id="entityCompany" /><label class="form-check-label" for="entityCompany">Company</label></div><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EntityType" required value="Llp" id="entityLlp" /><label class="form-check-label" for="entityLlp">LLP</label></div><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EntityType" required value="Partnership" id="entityPartnership" /><label class="form-check-label" for="entityPartnership">Partnership</label></div><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EntityType" required value="Proprietorship" id="entityProprietorship" /><label class="form-check-label" for="entityProprietorship">Proprietorship</label></div><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EntityType" required value="Trust" id="entityTrust" /><label class="form-check-label" for="entityTrust">Trust</label></div><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EntityType" required value="Other" id="entityOther" /><label class="form-check-label" for="entityOther">Other</label></div><div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="EntityType" required value="ForeignCompany" id="entityForeignCompany" /><label class="form-check-label" for="entityForeignCompany">Foreign company</label></div></fieldset><span asp-validation-for="EntityType" class="text-danger"></span>
        <div class="form-check mb-3"><input class="form-check-input" type="checkbox" asp-for="EntityTypeConfirmed" required /><label class="form-check-label" asp-for="EntityTypeConfirmed">I have checked and confirmed the borrower's legal entity type.</label><span asp-validation-for="EntityTypeConfirmed" class="text-danger"></span></div>
        <div id="apiFields"><div class="mb-3"><label asp-for="CompanyName" class="form-label">Company / LLP name</label><input asp-for="CompanyName" class="form-control" autocomplete="off" placeholder="e.g. Shekar Logistics Private Limited" /><div id="manualBorrowerMatches" class="list-group mt-1" role="listbox" aria-label="Matching registered borrowers"></div><div id="manualBorrowerLookupStatus" class="form-text" role="status">Type at least 3 characters to search the MCA master database.</div><span asp-validation-for="CompanyName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Cin" class="form-label" id="identifierLabel"></label><input asp-for="Cin" class="form-control" autocomplete="off" placeholder="U74899DL1991PTC043274" /><div class="form-text" id="identifierHelp">Optional when an exact registered name identifies one borrower. Select a suggestion if several entities share the name.</div><span asp-validation-for="Cin" class="text-danger"></span></div></div>
        <div id="partnershipFields" hidden><div class="mb-3" id="otherEntityFields"><label asp-for="OtherEntityType" class="form-label">Exact entity type (trust, society, individual, etc.)</label><input asp-for="OtherEntityType" class="form-control" /></div>
            <div class="mb-3"><label asp-for="PartnershipName" class="form-label">Borrower name</label><input asp-for="PartnershipName" class="form-control" /><span asp-validation-for="PartnershipName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="PartnershipRegistrationNumber" class="form-label"></label><input asp-for="PartnershipRegistrationNumber" class="form-control" /><span asp-validation-for="PartnershipRegistrationNumber" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="PartnershipAddress" class="form-label"></label><textarea asp-for="PartnershipAddress" class="form-control" rows="3"></textarea><span asp-validation-for="PartnershipAddress" class="text-danger"></span></div>
            <h2 class="h6">Legal cases</h2><p class="form-text">Enter the number of cases in each forum. These values appear in the SBI Legal Cases table.</p>
            <div class="row g-3 mb-3">
                <div class="col-md-4"><label asp-for="LegalCases.SupremeCourt" class="form-label">Supreme Court</label><input asp-for="LegalCases.SupremeCourt" class="form-control" min="0" /><span asp-validation-for="LegalCases.SupremeCourt" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="LegalCases.HighCourt" class="form-label">High Court</label><input asp-for="LegalCases.HighCourt" class="form-control" min="0" /><span asp-validation-for="LegalCases.HighCourt" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="LegalCases.DistrictCourt" class="form-label">District Court</label><input asp-for="LegalCases.DistrictCourt" class="form-control" min="0" /><span asp-validation-for="LegalCases.DistrictCourt" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="LegalCases.ConsumerForum" class="form-label">Consumer Forum</label><input asp-for="LegalCases.ConsumerForum" class="form-control" min="0" /><span asp-validation-for="LegalCases.ConsumerForum" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="LegalCases.ItatTax" class="form-label">ITAT / Tax</label><input asp-for="LegalCases.ItatTax" class="form-control" min="0" /><span asp-validation-for="LegalCases.ItatTax" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="LegalCases.NcltNclat" class="form-label">NCLT / NCLAT</label><input asp-for="LegalCases.NcltNclat" class="form-control" min="0" /><span asp-validation-for="LegalCases.NcltNclat" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="LegalCases.DrtDrat" class="form-label">DRT / DRAT</label><input asp-for="LegalCases.DrtDrat" class="form-control" min="0" /><span asp-validation-for="LegalCases.DrtDrat" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="LegalCases.Rera" class="form-label">RERA</label><input asp-for="LegalCases.Rera" class="form-control" min="0" /><span asp-validation-for="LegalCases.Rera" class="text-danger"></span></div>
                <div class="col-md-4"><label asp-for="LegalCases.NgtOthers" class="form-label">NGT / Others</label><input asp-for="LegalCases.NgtOthers" class="form-control" min="0" /><span asp-validation-for="LegalCases.NgtOthers" class="text-danger"></span></div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-right-circle me-1"></i>Generate report</button>
    </form>
</div>

<div class="pi-panel mt-3" style="padding:24px;">
    <h2 class="h5">Upload or paste the request</h2>
    <form asp-action="CreateAssignment" method="post" enctype="multipart/form-data" id="assignmentUploadForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <label for="requestFile" class="form-label">Request document or screenshot</label>
        <input type="file" name="requestFile" id="requestFile" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.eml,.txt" />
        <div class="form-text">PDF (up to 10 pages), screenshot, Word, .eml email, or .txt. Maximum 10 MB. You can also paste a screenshot here.</div>
        <label for="requestText" class="form-label mt-3">Email or request text</label>
        <textarea id="requestText" name="requestText" class="form-control" rows="6" maxlength="100000" placeholder="Paste the request email or document text here">@ViewBag.RequestText</textarea>
        <p class="form-text">Recognition runs in the background. Missing details are flagged on the created assignment. Litigation results are attached separately.</p>
        <button type="submit" class="btn btn-primary mt-2" id="createAssignmentButton">Create assignment automatically</button>
        <span id="assignmentUploadStatus" class="ms-2" role="status"></span>
    </form>
</div>
<details class="mt-4"><summary>Existing report tools: enter details or process company CINs in a batch</summary>


<div class="pi-panel mt-3" style="padding:24px;">
    <h2 class="h5">Batch processing</h2><p class="text-muted">Up to 25 company CINs, one report each.</p>
    <form asp-action="Batch" method="post"><input type="hidden" name="EntityType" value="Company" /><label asp-for="Format" class="form-label">Report format</label><select asp-for="Format" class="form-select mb-3"><option value="Sbi">SBI</option><option value="Prr">PRR</option></select><label asp-for="Cins" class="form-label">One CIN per line</label><textarea asp-for="Cins" class="form-control" rows="5" placeholder="U74899DL1991PTC043274"></textarea><div class="form-check mt-3"><input class="form-check-input" type="checkbox" name="EntityTypeConfirmed" value="true" id="batchTypeConfirmed" required /><label class="form-check-label" for="batchTypeConfirmed">I confirm every identifier in this batch belongs to a company.</label></div><button type="submit" class="btn btn-outline-primary mt-3">Queue batch</button></form>
</div>



</details>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/borrower-assignment-upload.js" asp-append-version="true"></script>
    <script src="~/js/borrower-identity-lookup.js" asp-append-version="true"></script>
    <script>borrowerIdentityLookup({url:'@Url.Action("BorrowerLookup")',name:'CompanyName',identifier:'Cin',results:'manualBorrowerMatches',status:'manualBorrowerLookupStatus',allowAllTypes:true,entity:function(){return document.querySelector('input[name="EntityType"]:checked')?.value;},onNameChange:function(){document.getElementById('EntityTypeConfirmed').checked=false;},onSelect:function(match){var id=match.recordType==='Llp'?'entityLlp':match.recordType==='Foreign'?'entityForeignCompany':'entityCompany';document.getElementById(id).checked=true;document.getElementById('EntityTypeConfirmed').checked=false;window.preLoginReportRefresh?.();}});</script>
    <script>(function(){var radios=document.querySelectorAll('input[name="EntityType"]'),api=document.getElementById('apiFields'),partnership=document.getElementById('partnershipFields'),cin=document.getElementById('Cin'),label=document.getElementById('identifierLabel'),help=document.getElementById('identifierHelp'),prr=document.getElementById('formatPrr');function refresh(){var type=document.querySelector('input[name="EntityType"]:checked')?.value;if(!type){api.hidden=false;partnership.hidden=true;prr.disabled=false;return;}var manual=!['Company','Llp','ForeignCompany'].includes(type);api.hidden=manual;document.getElementById('otherEntityFields').hidden=type!=='Other';partnership.hidden=!manual;prr.disabled=manual;label.textContent=type==='Llp'?'LLPIN':'Company CIN';cin.placeholder=type==='Llp'?'AAA-1234':'U74899DL1991PTC043274';help.textContent=type==='ForeignCompany'?'Enter the company CIN to generate this report.':'Optional when an exact registered name identifies one borrower. Select a suggestion if several entities share the name.';if(manual)document.getElementById('formatSbi').checked=true;}radios.forEach(function(radio){radio.addEventListener('change',function(){document.getElementById('EntityTypeConfirmed').checked=false;refresh();});});window.preLoginReportRefresh=refresh;refresh();}());</script>
}
