// Reference copy of every setting this app reads, in one place — not loaded by the app itself (only
// appsettings.json / appsettings.{Environment}.json are). Never fill this file with real values and commit
// it; it's a template to copy values OUT of, into `dotnet user-secrets` locally or environment variables
// (`Section__Key` naming) in any shared/deployed environment. See README.md "Configuring secrets" for the
// exact commands, and docs/calculation-assurance-runbook.md before touching CalculationAssurance:Mode.
//
// Comments are safe here — ASP.NET Core's JSON configuration provider skips `//`/`/* */` and trailing
// commas the same way it would in a real appsettings.json.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ── Database — required everywhere except local dev (already set in appsettings.Development.json) ──
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=MCAROC_Analysis;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  // ── Google Cloud / Vertex AI — ONE credential for every AI feature in the app (chat, document
  // extraction, cross-section analysis summary, the charges narrative, #164's AI audit). Required once any
  // of them is actually used; each throws at first use if missing, not at startup. Adding a new AI-backed
  // feature should read these same three keys, never a new GoogleCloud:* setting of its own. ──
  "GoogleCloud": {
    "ProjectId": "your-gcp-project-id",
    "Location": "us-central1", // optional — this is already the default
    "CredentialsPath": "C:\\path\\to\\your-service-account-key.json"
  },

  // ── InstaFinancials — pre-login reports only. ApiKey required once a report is actually requested. ──
  "InstaFinancials": {
    "BaseUrl": "https://api.instafinancials.com/InstaReports/v2/InstaBasic/CompanyCIN", // optional — already the real endpoint
    "ApiKey": "your-instafinancials-api-key",
    "DaysToIgnore": 888 // optional — vendor-recommended cache-freshness default
  },

  // ── Auto-fetch from the reference tool (post-login requests created from just a CIN/LLPIN). Inert
  // until BaseUrl + SessionCookie are set. The tool has no API-key login: sign in to it in a browser,
  // copy the full `Cookie` request-header value from any of its XHR calls (DevTools → Network) and set
  // it as SessionCookie — user-secrets locally, environment variables elsewhere, never this file. When
  // the session expires, jobs fail at the first step with a message saying to refresh it. UserId is the
  // tool's numeric id of that user; leave it empty to resolve it from the session. ──
  "ReferenceTool": {
    "BaseUrl": "https://reference-tool.example", // scheme + host of the tool's web app
    "SessionCookie": "PHPSESSID=...; user=...; selectedTeam=...",
    "UserId": "",
    "ClientVersion": "3.1.6", // optional — the version query parameters the tool's front end sends
    "AppVersion": "8.1.26",
    "DownloadConcurrency": 6, // optional — parallel PDF downloads per job
    "DownloadAttempts": 3, // optional — per-file attempts before it's recorded as a warning
    "DefaultMaxDocumentsPerSection": 0, // optional — form default; 0 = every listed document
    "IncludeFilingsByDefault": true // optional — whether the form pre-ticks "also fetch filing PDFs"
  },

  // ── MCA filings OCR fallback — optional, both already default to these values. ──
  "McaFilings": {
    "TesseractExePath": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
    "MinCharsPerPageForNativeText": 80
  },

  // ── #164 Calculation assurance — all optional; Mode defaults to "Off" (fully inert, zero DB queries,
  // never blocks a download). See docs/calculation-assurance-runbook.md before setting Mode to
  // ObserveOnly/Enforced in a real environment. ──
  "CalculationAssurance": {
    "Mode": "Off", // "Off" | "ObserveOnly" | "Enforced"
    "AiAuditEnabled": true,
    "AiAuditMaxAttempts": 3,
    "AiAuditTimeoutSeconds": 60,
    "AiAuditMaxLedgerRowsPerCall": 150
  },

  // ── Internal reviewer login (/internal/login, gates /internal/calc-audit and /Clients) — config-based,
  // not a DB table. Left empty, nobody can sign in. To set it up:
  //   1. Pick a username and a password.
  //   2. Generate the password hash — it is NOT the raw password. From
  //      MCAROC.Portal/MCAROC_Analysis/, in a scratch console project referencing this project (or any
  //      C# scratchpad), run:
  //        Console.WriteLine(MCAROC_Analysis.Services.InternalAuth.InternalReviewerCredentialChecker.Hash("your-chosen-password"));
  //      This prints "iterations.saltBase64.hashBase64" (PBKDF2-SHA256, 210,000 iterations) — that whole
  //      string is ReviewerPasswordHash.
  //   3. Set all three keys below (user-secrets locally, environment variables/App Settings elsewhere) —
  //      never the raw password anywhere.
  // Rotating: repeat step 2 with the new password and update ReviewerPasswordHash — no code change, no
  // migration, but most config providers here are read once at startup, so restart/recycle the app after.
  "InternalAuth": {
    "ReviewerUsername": "your-reviewer-username",
    "ReviewerPasswordHash": "210000.<saltBase64>.<hashBase64>",
    "ReviewerDisplayName": "Reviewer Display Name"
  },

  // ── Large archive upload (#169) + ingestion pipeline concurrency — all optional; Enabled defaults to
  // false. MaxConcurrentUploads/MaxConcurrentUnpacks bound how many requests ingest in parallel;
  // MaxConcurrentDocumentProcessing/MaxConcurrentAiExtraction/MaxConcurrentChunking bound how parallel the
  // work is within one batch (raise the OCR one for local CPU headroom, the other two only after checking
  // the relevant Vertex AI / embedding quota). ──
  "LargeArchiveUpload": {
    "Enabled": false,
    "MaxArchiveSizeBytes": 5368709120, // 5 GiB
    "ChunkSizeBytes": 67108864, // 64 MiB
    "MaxConcurrentUploads": 1,
    "MaxConcurrentUnpacks": 1,
    "MaxConcurrentDocumentProcessing": 4,
    "MaxConcurrentAiExtraction": 2,
    "MaxConcurrentChunking": 4,
    "MaxUncompressedSizeBytes": 21474836480, // 20 GiB
    "MaxPdfCount": 10000,
    "MaxIndividualPdfSizeBytes": 250000000, // ~238 MiB
    "MinFreeDiskHeadroomBytes": 10737418240 // 10 GiB
  }
}
